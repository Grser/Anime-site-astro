---
import Layout from '../../../layouts/Layout.astro';
import db from '../../../lib/db';

export const prerender = false;

const { slug, episodio } = Astro.params;
const usuarioId = Astro.locals.user?.id;
const perfilId = Astro.locals.user?.perfilId;
const usuarioNombre = Astro.locals.user?.nickname || 'Invitado';
let progresoGuardado = 0;
let userSubscription = 'Gratis';
let isAdmin = false;
const subscriptionRanks: Record<string, number> = {
  Gratis: 0,
  Super: 1,
  Estelar: 2,
};

// 1) Carga la serie
const [[serie]] = await db.query(
  `SELECT id, titulo, banner, descripcion, clasificacion_edad, idioma, genero 
     FROM series 
    WHERE slug = ? 
    LIMIT 1`,
  [slug]
);
if (!serie) return Astro.redirect('/404');
const serieId = serie.id;

// 2) Carga el episodio (incluye temporada_id)
// Sólo se acepta un episodio que pertenezca a esta serie (antes cualquier id
// funcionaba con cualquier slug y mezclaba títulos/likes de series distintas).
const [[ep]] = await db.query(
  `SELECT e.id, e.titulo, e.video_url, e.duracion, e.idioma, e.imagen_preview, e.fecha_estreno, e.temporada_id, e.suscripcion_requerida
     FROM episodios e
     JOIN temporadas t ON t.id = e.temporada_id
    WHERE e.id = ? AND t.serie_id = ?
    LIMIT 1`,
  [episodio, serieId]
);
if (!ep) return Astro.redirect('/404');
const temporadaId = ep.temporada_id;

if (usuarioId) {
  const [[userRow]] = await db.query<{ suscripcion: string; es_admin: number }[]>(
    `SELECT suscripcion, es_admin FROM usuarios WHERE id = ? LIMIT 1`,
    [usuarioId]
  );
  userSubscription = userRow?.suscripcion || 'Gratis';
  isAdmin = userRow?.es_admin === 1;

  const [[historial]] = perfilId
    ? await db.query(
        `SELECT progreso
           FROM historial
          WHERE perfil_id = ? AND episodio_id = ?
          LIMIT 1`,
        [perfilId, episodio],
      )
    : [[null]];

  progresoGuardado = historial?.progreso ?? 0;
}

// 3) Likes / Dislikes y reacción del usuario
const [[lrow]] = await db.query(
  `SELECT COUNT(*) AS likes FROM likes_dislikes WHERE serie_id = ? AND tipo='like'`,
  [serieId]
);
const [[drow]] = await db.query(
  `SELECT COUNT(*) AS dislikes FROM likes_dislikes WHERE serie_id = ? AND tipo='dislike'`,
  [serieId]
);
const [[reactionRow]] = perfilId
  ? await db.query(
      `SELECT tipo FROM likes_dislikes WHERE perfil_id = ? AND serie_id = ? LIMIT 1`,
      [perfilId, serieId]
    )
  : [[null]];
const likes = lrow.likes;
const dislikes = drow.dislikes;
const userReaction = reactionRow?.tipo || null;

// 4) Todos los episodios de la temporada
const [todosEps] = await db.query(
  `SELECT id, titulo, imagen_preview, idioma 
     FROM episodios 
    WHERE temporada_id = ?
    ORDER BY numero_episodio`,
  [temporadaId]
);

// 5) Determinar anterior y siguiente
const index = todosEps.findIndex(x => x.id === Number(episodio));
const prevEp = index > 0 ? todosEps[index - 1] : null;
const nextEp = index < todosEps.length - 1 ? todosEps[index + 1] : null;

const requiredPlan = ep.suscripcion_requerida || 'Gratis';
const requiredLevel = subscriptionRanks[requiredPlan] ?? 0;
const userLevel = subscriptionRanks[userSubscription] ?? 0;
const canAccess = requiredLevel === 0 || (usuarioId && userLevel >= requiredLevel);
const pageTitle = `${serie.titulo} - ${ep.titulo} | ClawnVid`;
const pageDescription =
  serie.descripcion?.trim() ||
  `Mira ${ep.titulo} de ${serie.titulo} en ClawnVid.`;
const pageImage = ep.imagen_preview || serie.banner || '/avatar.jpeg';
const allowedVideoHosts = new Set(['videos.clawn.cat', 'videos.clawn.net']);
const proxifyMediaUrl = (targetUrl?: string | null) => {
  if (!targetUrl) return '';
  try {
    const parsed = new URL(targetUrl);
    if (!allowedVideoHosts.has(parsed.hostname)) return targetUrl;
    return `/api/proxy/video?url=${encodeURIComponent(parsed.toString())}`;
  } catch {
    return targetUrl;
  }
};
const posterUrl = proxifyMediaUrl(ep.imagen_preview || serie.banner || '/avatar.jpeg');
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  type="article"
  class="bg-black text-white"
>
  <section id="watch-section" class="watch-section mt-8 sm:mt-12 max-w-6xl mx-auto px-3 sm:px-8 py-6 sm:py-10 space-y-6 sm:space-y-8 overflow-x-hidden">
    <div class="player-shell relative rounded-[24px] sm:rounded-3xl overflow-hidden border border-white/10 shadow-2xl shadow-purple-500/30 bg-gradient-to-b from-purple-950/50 via-black to-black">
      <div class="aspect-video">
        <video
          id="video-player"
          playsinline
          crossorigin="anonymous"
          poster={posterUrl}
          data-video-url={canAccess ? proxifyMediaUrl(ep.video_url) : ''}
          data-user-id={usuarioId}
          data-episodio-id={episodio}
          data-progress={progresoGuardado}
          data-can-play={canAccess}
          class="w-full h-full object-contain bg-black focus:outline-none"
        >
          Tu navegador no soporta la reproducción de video.
        </video>
        <div class="player-overlay pointer-events-none"></div>
        <div id="seek-feedback-backward" class="seek-feedback seek-feedback--backward" aria-hidden="true">
          <span aria-hidden="true">&#8634;</span>
          <strong>10 s</strong>
        </div>
        <div id="seek-feedback-forward" class="seek-feedback seek-feedback--forward" aria-hidden="true">
          <span aria-hidden="true">&#8635;</span>
          <strong>10 s</strong>
        </div>
        {nextEp && (
          <a id="next-episode-cta" href={`/serie/${slug}/${nextEp.id}`} class="next-episode-cta" hidden>
            <span>Siguiente cap&iacute;tulo</span>
            <span class="next-episode-arrow" aria-hidden="true">&rsaquo;</span>
          </a>
        )}
        <div class="player-ui">
          <div class="player-top">
            <div class="player-heading">
              <span>{serie.titulo}</span>
              <strong>{ep.titulo}</strong>
            </div>
            <div class="player-top-actions">
              <div class="player-badges">
                <span class="pill">HD</span>
                <span class="pill">{ep.idioma || 'Sub'}</span>
              </div>
            </div>
          </div>
          <div class="player-bottom">
            <div id="timeline-preview" class="timeline-preview" hidden>
              <img id="timeline-preview-image" src="" alt="Vista previa del video" class="timeline-preview-image" />
              <span id="timeline-preview-time" class="timeline-preview-time">0:00</span>
            </div>
            <input
              id="progress-bar"
              type="range"
              min="0"
              max="100"
              value="0"
              step="0.1"
              aria-label="Progreso del video"
              class="progress-bar"
            />
            <div class="player-controls">
              <div class="controls-left">
                <button id="rewind-toggle" class="control-btn control-btn--ghost" aria-label="Retroceder 10 segundos">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 19 4 12l7-7"/><path stroke-linecap="round" stroke-linejoin="round" d="M20 19l-7-7 7-7"/></svg>
                </button>
                <button id="play-toggle" class="control-btn play-control" aria-label="Reproducir">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l10.98-6.86a1 1 0 0 0 0-1.72L9.5 4.28A1 1 0 0 0 8 5.14Z"/></svg>
                </button>
                <button id="forward-toggle" class="control-btn control-btn--ghost" aria-label="Adelantar 10 segundos">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="m13 5 7 7-7 7"/><path stroke-linecap="round" stroke-linejoin="round" d="m4 5 7 7-7 7"/></svg>
                </button>
                <div class="time-display time-display-main">
                  <span id="current-time">0:00</span>
                  <span class="divider">/</span>
                  <span id="duration">0:00</span>
                </div>
              </div>
              <div class="controls-right controls-inline">
                <button id="mute-toggle" class="control-btn control-btn--ghost" aria-label="Silenciar">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5 6.5 9H3v6h3.5l4.5 4V5Z"/><path stroke-linecap="round" d="M15 9.5a4 4 0 0 1 0 5m2.5-7.5a7 7 0 0 1 0 10"/></svg>
                </button>
                <label for="volume-slider" class="sr-only">Volumen</label>
                <input id="volume-slider" class="volume-slider" type="range" min="0" max="1" value="1" step="0.05" aria-label="Volumen" />
                <label for="subtitle-select" class="sr-only">Subtítulos</label>
                <select id="subtitle-select" class="subtitle-select" aria-label="Seleccionar subtítulos" hidden>
                  <option value="off">Subtítulos: desactivados</option>
                </select>
                <button id="fullscreen-toggle" class="control-btn control-btn--ghost fullscreen-btn" aria-label="Pantalla completa">
                  <svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 3H5a2 2 0 0 0-2 2v3m16-5h-3m3 0v3M3 16v3a2 2 0 0 0 2 2h3m11-5v3a2 2 0 0 1-2 2h-3"/></svg>
                </button>
              </div>
            </div>
          </div>
        </div>
      </div>
      {!canAccess && (
        <div class="absolute inset-0 flex items-center justify-center bg-black/80 text-center px-6">
          <div class="space-y-3 max-w-md">
            <p class="text-sm uppercase tracking-[0.3em] text-purple-200">Contenido exclusivo</p>
            <h3 class="text-2xl font-bold">Este episodio requiere {requiredPlan}</h3>
            <p class="text-sm text-white/70">
              {usuarioId
                ? `Tu plan actual es ${userSubscription}. Actualiza para desbloquearlo.`
                : 'Inicia sesión y elige una suscripción para acceder.'}
            </p>
            <div class="flex flex-wrap justify-center gap-3">
              {!usuarioId && (
                <a href="/login" class="rounded-full bg-white/10 px-4 py-2 text-sm font-semibold text-white hover:bg-white/20 transition">
                  Iniciar sesión
                </a>
              )}
              <a href="/suscripciones" class="rounded-full bg-purple-600 px-4 py-2 text-sm font-semibold text-white hover:bg-purple-500 transition">
                Ver planes
              </a>
            </div>
          </div>
        </div>
      )}
    </div>

    <div class="grid lg:grid-cols-3 gap-4 sm:gap-8">
      <div class="lg:col-span-2 space-y-4">
        <div class="space-y-3 bg-white/5 border border-white/10 rounded-2xl px-4 py-4 shadow-lg shadow-purple-500/10 backdrop-blur overflow-hidden">
          <div class="flex flex-col gap-2 sm:flex-row sm:items-start sm:justify-between sm:gap-4">
            <div class="space-y-1">
              <h2 class="text-xl sm:text-2xl font-bold leading-tight">{ep.titulo}</h2>
              <p class="text-gray-300 text-sm">
                {new Date(ep.fecha_estreno).toLocaleDateString('es-ES', { day: '2-digit', month: 'short', year: 'numeric' })}
              </p>
            </div>
            <div class="flex flex-wrap gap-2 text-[11px] sm:text-xs font-semibold">
              <span class="inline-flex items-center gap-1 rounded-full bg-purple-500/15 text-purple-100 px-3 py-1 border border-purple-400/30">
                <span class="h-2 w-2 rounded-full bg-purple-300"></span>
                {serie.genero || 'Anime'}
              </span>
              <span class="inline-flex items-center gap-1 rounded-full bg-white/10 text-white px-3 py-1 border border-white/15">
                {ep.idioma}
              </span>
              <span class="inline-flex items-center gap-1 rounded-full bg-white/10 text-white px-3 py-1 border border-white/15">
                ⏱ {ep.duracion} min
              </span>
            </div>
          </div>
          <div
            id="reactions"
            data-serie-id={serieId}
            data-user-id={usuarioId}
            data-user-reaction={userReaction}
            class="flex items-center space-x-4 pt-1"
          >
            <!-- BOTONES LIKE/DISLIKE -->
          </div>
        </div>

        <p class="text-sm sm:text-base text-gray-200 leading-relaxed bg-white/5 border border-white/10 rounded-2xl px-4 py-4 shadow-lg shadow-purple-500/10 backdrop-blur">
          {serie.descripcion}
        </p>

        <section class="space-y-4 bg-white/5 border border-white/10 rounded-2xl px-4 py-4 shadow-lg shadow-purple-500/10 backdrop-blur">
          <div class="flex items-center justify-between">
            <div>
              <h3 class="text-lg font-bold">Comentarios</h3>
              <p class="text-sm text-white/60">Comparte tu opinión sobre el episodio.</p>
            </div>
            {!usuarioId && (
              <span class="text-xs text-purple-200">Inicia sesión para comentar</span>
            )}
          </div>

          <div
            id="comments-list"
            data-episodio-id={episodio}
            data-user-name={usuarioNombre}
            data-user-id={usuarioId || ''}
            data-user-admin={isAdmin ? 'true' : 'false'}
            data-can-comment={Boolean(usuarioId)}
            class="space-y-3"
          ></div>

          <form id="comment-form" class="space-y-3">
            <textarea
              id="comment-input"
              rows="3"
              maxlength="1000"
              placeholder={usuarioId ? 'Escribe tu comentario...' : 'Inicia sesión para comentar.'}
              class="w-full rounded-2xl border border-white/10 bg-black/30 px-4 py-3 text-white placeholder:text-white/40 focus:border-purple-400 focus:ring-2 focus:ring-purple-500/40"
              disabled={!usuarioId}
            ></textarea>
            <div class="flex justify-between items-center text-xs text-white/50">
              <span id="comment-status" aria-live="polite">Máximo 1000 caracteres.</span>
              <button
                type="submit"
                class="rounded-full bg-purple-600 px-4 py-2 text-sm font-semibold text-white hover:bg-purple-500 transition disabled:opacity-50"
                disabled={!usuarioId}
              >
                Publicar
              </button>
            </div>
          </form>
        </section>
      </div>

      <aside class="space-y-4 sm:space-y-6">
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4 shadow-lg shadow-purple-500/10 backdrop-blur">
          <div class="flex items-center justify-between mb-3">
            <h4 class="font-bold">SIGUIENTE EPISODIO</h4>
            <span class="text-xs px-2 py-1 rounded-full bg-green-500/15 text-green-100 border border-green-400/20">Auto</span>
          </div>
          {nextEp ? (
            <a href={`/serie/${slug}/${nextEp.id}`} class="flex items-center gap-3 group">
              <img src={nextEp.imagen_preview} alt={nextEp.titulo} class="w-20 h-14 object-cover rounded-lg ring-1 ring-white/10" />
              <div class="flex-1">
                <p>{nextEp.titulo}</p>
                <p class="text-gray-400 text-sm flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-purple-300"></span>{nextEp.idioma}
                </p>
              </div>
              <span class="text-sm text-purple-200 opacity-0 group-hover:opacity-100 transition">→</span>
            </a>
          ) : (
            <p class="text-gray-500">Este es el último episodio.</p>
          )}
        </div>
        <div class="bg-white/5 border border-white/10 rounded-2xl p-4 shadow-lg shadow-purple-500/10 backdrop-blur">
          <div class="flex items-center justify-between mb-3">
            <h4 class="font-bold">EPISODIO ANTERIOR</h4>
            <span class="text-xs px-2 py-1 rounded-full bg-blue-500/15 text-blue-100 border border-blue-400/20">Replay</span>
          </div>
          {prevEp ? (
            <a href={`/serie/${slug}/${prevEp.id}`} class="flex items-center gap-3 group">
              <img src={prevEp.imagen_preview} alt={prevEp.titulo} class="w-20 h-14 object-cover rounded-lg ring-1 ring-white/10" />
              <div class="flex-1">
                <p>{prevEp.titulo}</p>
                <p class="text-gray-400 text-sm flex items-center gap-2">
                  <span class="h-1.5 w-1.5 rounded-full bg-purple-300"></span>{prevEp.idioma}
                </p>
              </div>
              <span class="text-sm text-purple-200 opacity-0 group-hover:opacity-100 transition">←</span>
            </a>
          ) : (
            <p class="text-gray-500">Este es el primer episodio.</p>
          )}
        </div>
        <a
          href={`/serie/${slug}`}
          class="block w-full text-center border border-white/20 bg-white/10 py-3 rounded-2xl hover:bg-white hover:text-black transition font-semibold shadow-md shadow-purple-500/20"
        >
          VER MÁS EPISODIOS
        </a>
      </aside>
    </div>
  </section>
  <!-- Carga Hls.js desde CDN -->
  <script is:inline src="https://cdn.jsdelivr.net/npm/hls.js@1.5.20/dist/hls.min.js" crossorigin="anonymous"></script>
  <!-- Inicialización del reproductor -->
  <script client:load>
    const video = document.getElementById('video-player');
    const playToggle = document.getElementById('play-toggle');
    const rewindToggle = document.getElementById('rewind-toggle');
    const forwardToggle = document.getElementById('forward-toggle');
    const progressBar = document.getElementById('progress-bar');
    const timelinePreview = document.getElementById('timeline-preview');
    const timelinePreviewImage = document.getElementById('timeline-preview-image');
    const timelinePreviewTime = document.getElementById('timeline-preview-time');
    const playerShell = document.querySelector('.player-shell');
    const playerUI = document.querySelector('.player-ui');
    const seekFeedbackBackward = document.getElementById('seek-feedback-backward');
    const seekFeedbackForward = document.getElementById('seek-feedback-forward');
    const currentTimeEl = document.getElementById('current-time');
    const durationEl = document.getElementById('duration');
    const currentTimeMobileEl = document.getElementById('current-time-mobile');
    const durationMobileEl = document.getElementById('duration-mobile');
    const fullscreenToggle = document.getElementById('fullscreen-toggle');
    const muteToggle = document.getElementById('mute-toggle');
    const volumeSlider = document.getElementById('volume-slider');
    const cinemaToggle = document.getElementById('cinema-toggle');
    const subtitleSelect = document.getElementById('subtitle-select');
    const watchSection = document.getElementById('watch-section');
    const rawUrl = video.dataset.videoUrl;
    const canPlay = video.dataset.canPlay === 'true';
    const userId = video.dataset.userId;
    const episodioId = video.dataset.episodioId;
    const savedProgress = Number(video.dataset.progress || 0);
    let progressTimer = null;
    let lastSentProgress = savedProgress || 0;
    let lastSentAt = 0;
    let hideControlsTimer = null;
    let mobileTapTimer = null;
    let seekFeedbackTimer = null;
    let lastMobileTapAt = 0;
    let lastMobileTapX = 0;
    let suppressTouchClickUntil = 0;
    let cinemaMode = false;
    let isUserSeeking = false;
    let seekCommitTimer = null;
    let timelinePreviewCount = 24;
    let landscapeFullscreenRequested = false;
    let landscapeFallbackActive = false;
    let nativeFullscreenActive = false;
    // Prefs del player compartidas por browser (no por userId), así no se
    // pierden al cerrar sesión ni cambian entre perfiles del mismo PC.
    const playerPrefsKey = 'cv.player.prefs.v2';
    const isMobilePlayer = () => window.matchMedia('(max-width: 640px)').matches;
    const nextEpisodeCta = document.getElementById('next-episode-cta');
    const subtitleSettings = {
      position: 78,
      backgroundOpacity: 0.35,
      size: 110,
      selectedTrack: 'off',
    };
    const playerPrefs = {
      // 'off' = sin subs; cualquier otro string = índice del track activo.
      subtitleTrack: 'off',
      volume: 1,
      muted: false,
      playbackRate: 1,
    };

    const proxify = (target) => `/api/proxy/video?url=${encodeURIComponent(target)}`;

    const persistProgress = (value, completed = false, force = false) => {
      if (!userId || !episodioId) return;

      const normalizedValue = Math.max(0, Math.floor(value || 0));
      const now = Date.now();
      const elapsed = now - lastSentAt;
      const delta = Math.abs(normalizedValue - lastSentProgress);

      if (!force && !completed && elapsed < 8000 && delta < 8) {
        return;
      }

      lastSentProgress = normalizedValue;
      lastSentAt = now;

      fetch('/api/player/progreso', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          user_id: userId,
          episodio_id: episodioId,
          progreso: normalizedValue,
          completado: completed ? 1 : 0,
        }),
        keepalive: true,
      }).catch((err) => console.error('No se pudo guardar el progreso', err));
    };

    const allowedVideoHosts = new Set(['videos.clawn.cat', 'videos.clawn.net']);
    const normalizeHost = (targetUrl) => {
      try {
        const parsed = new URL(targetUrl);

        // Solo corrige si llega un dominio no permitido, manteniendo el host original válido.
        if (!allowedVideoHosts.has(parsed.hostname)) {
          parsed.hostname = 'videos.clawn.net';
        }
        parsed.protocol = 'https:';

        return parsed.toString();
      } catch (error) {
        console.error('No se pudo normalizar la URL del video', error);
        return targetUrl;
      }
    };

    const formatTime = (seconds) => {
      if (!Number.isFinite(seconds)) return '0:00';
      const safeSeconds = Math.floor(Math.max(seconds, 0));
      const hours = Math.floor(safeSeconds / 3600);
      const minutes = Math.floor((safeSeconds % 3600) / 60)
        .toString()
        .padStart(hours > 0 ? 2 : 1, '0');
      const secs = Math.floor(safeSeconds % 60)
        .toString()
        .padStart(2, '0');
      return hours > 0 ? `${hours}:${minutes}:${secs}` : `${minutes}:${secs}`;
    };

    const togglePlay = () => {
      if (video.paused) {
        video.play();
      } else {
        video.pause();
      }
    };

    const setButtonIcon = (button, icon) => {
      if (!button) return;
      const icons = {
        play: '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M8 5.14v13.72a1 1 0 0 0 1.5.86l10.98-6.86a1 1 0 0 0 0-1.72L9.5 4.28A1 1 0 0 0 8 5.14Z"/></svg>',
        pause: '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true"><path d="M7 5.75A1.75 1.75 0 0 1 8.75 4h.5A1.75 1.75 0 0 1 11 5.75v12.5A1.75 1.75 0 0 1 9.25 20h-.5A1.75 1.75 0 0 1 7 18.25V5.75Zm6 0A1.75 1.75 0 0 1 14.75 4h.5A1.75 1.75 0 0 1 17 5.75v12.5A1.75 1.75 0 0 1 15.25 20h-.5A1.75 1.75 0 0 1 13 18.25V5.75Z"/></svg>',
        volume: '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5 6.5 9H3v6h3.5l4.5 4V5Z"/><path stroke-linecap="round" d="M15 9.5a4 4 0 0 1 0 5m2.5-7.5a7 7 0 0 1 0 10"/></svg>',
        muted: '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M11 5 6.5 9H3v6h3.5l4.5 4V5Z"/><path stroke-linecap="round" d="m16 10 5 5m0-5-5 5"/></svg>',
        fullscreen: '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 3H5a2 2 0 0 0-2 2v3m16-5h-3m3 0v3M3 16v3a2 2 0 0 0 2 2h3m11-5v3a2 2 0 0 1-2 2h-3"/></svg>',
        fullscreenExit: '<svg class="h-5 w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.9" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M8 3v3a2 2 0 0 1-2 2H3m18 0h-3a2 2 0 0 1-2-2V3M3 16h3a2 2 0 0 1 2 2v3m8 0v-3a2 2 0 0 1 2-2h3"/></svg>',
      };
      button.innerHTML = icons[icon] || '';
    };

    const updatePlayIcon = () => {
      setButtonIcon(playToggle, video.paused ? 'play' : 'pause');
      playToggle?.setAttribute('aria-label', video.paused ? 'Reproducir' : 'Pausar');
    };

    const updateVolumeUI = () => {
      const muted = video.muted || video.volume === 0;
      setButtonIcon(muteToggle, muted ? 'muted' : 'volume');
      muteToggle?.setAttribute('aria-label', muted ? 'Activar sonido' : 'Silenciar');
      if (volumeSlider instanceof HTMLInputElement) {
        volumeSlider.value = String(muted ? 0 : video.volume);
        const percent = Number(volumeSlider.value) * 100;
        volumeSlider.style.background = `linear-gradient(90deg,
          rgba(217, 70, 239, 0.95) 0%,
          rgba(147, 51, 234, 0.95) ${percent}%,
          rgba(255, 255, 255, 0.16) ${percent}%,
          rgba(255, 255, 255, 0.1) 100%)`;
      }
    };

    const toggleMute = () => {
      video.muted = !video.muted;
      updateVolumeUI();
    };


    const renderProgressFill = (percent) => {
      if (!progressBar) return;
      const clamped = Math.min(Math.max(percent, 0), 100);

      progressBar.style.background = `linear-gradient(90deg,
        rgba(217, 70, 239, 0.96) 0%,
        rgba(147, 51, 234, 0.96) ${clamped}%,
        rgba(255, 255, 255, 0.18) ${clamped}%,
        rgba(255, 255, 255, 0.1) 100%)`;
    };

    const updateProgress = () => {
      if (!video.duration) return;
      const percent = (video.currentTime / video.duration) * 100;
      if (!isUserSeeking && progressBar) {
        progressBar.value = percent;
        renderProgressFill(percent);
      }
      currentTimeEl.textContent = formatTime(video.currentTime);
      if (currentTimeMobileEl) currentTimeMobileEl.textContent = formatTime(video.currentTime);
    };

    const getTimelinePreviewSrc = (percent) => {
      const index = Math.max(0, Math.min(timelinePreviewCount - 1, Math.floor((percent / 100) * timelinePreviewCount)));
      return `/api/player/timeline-preview?episodioId=${encodeURIComponent(episodioId)}&index=${String(index).padStart(2, '0')}`;
    };

    const showTimelinePreview = (percent, clientX = null) => {
      if (!(timelinePreview instanceof HTMLElement) || !(timelinePreviewImage instanceof HTMLImageElement) || !video.duration || !progressBar) return;
      const src = getTimelinePreviewSrc(percent);
      if (!src) return;

      timelinePreview.hidden = false;
      timelinePreviewImage.src = src;
      if (timelinePreviewTime) {
        timelinePreviewTime.textContent = formatTime((percent / 100) * video.duration);
      }

      const rect = progressBar.getBoundingClientRect();
      const x = clientX ?? (rect.left + (rect.width * percent) / 100);
      const relativeX = Math.max(0, Math.min(rect.width, x - rect.left));
      const previewParent = timelinePreview.offsetParent;
      const targetX = progressBar.offsetLeft + relativeX;
      const previewHalf = Math.max(55, timelinePreview.offsetWidth / 2);
      const parentWidth = previewParent instanceof HTMLElement ? previewParent.clientWidth : rect.width;
      const safeLeft = Math.max(previewHalf + 4, Math.min(parentWidth - previewHalf - 4, targetX));
      timelinePreview.style.left = `${safeLeft}px`;
    };

    const hideTimelinePreview = () => {
      if (timelinePreview instanceof HTMLElement) {
        timelinePreview.hidden = true;
      }
    };

    timelinePreviewImage?.addEventListener('error', hideTimelinePreview);

    const syncDuration = () => {
      durationEl.textContent = formatTime(video.duration);
      if (durationMobileEl) durationMobileEl.textContent = formatTime(video.duration);
    };

    const seekTo = (percent, commit = false) => {
      if (!video.duration) return;
      const time = (percent / 100) * video.duration;
      renderProgressFill(percent);

      if (!commit) return;

      const safeSeek = () => {
        try {
          video.currentTime = time;
        } catch (error) {
          console.warn('No se pudo mover la línea de tiempo todavía', error);
        }
      };

      if (video.readyState < 1) {
        video.addEventListener('loadedmetadata', safeSeek, { once: true });
      } else {
        safeSeek();
      }
    };

    const updateFullscreenUI = () => {
      const active = Boolean(document.fullscreenElement || landscapeFallbackActive);
      setButtonIcon(fullscreenToggle, active ? 'fullscreenExit' : 'fullscreen');
      fullscreenToggle?.setAttribute('aria-label', active ? 'Salir de pantalla completa' : 'Pantalla completa');
      fullscreenToggle?.classList.toggle('active', active);
    };

    const setLandscapeFallback = (enabled) => {
      landscapeFallbackActive = enabled;
      playerShell?.classList.toggle('mobile-landscape-fallback', enabled);
      document.body?.classList.toggle('player-landscape-active', enabled);
      updateFullscreenUI();
    };

    const unlockOrientation = async () => {
      if (window.ClawnNative?.isNative) {
        await window.ClawnNative.unlockOrientation();
        return;
      }

      try {
        screen.orientation?.unlock?.();
      } catch {
        // Algunos navegadores no exponen el desbloqueo de orientación.
      }
    };

    const requestLandscape = async () => {
      if (!isMobilePlayer()) return;

      try {
        if (window.ClawnNative?.isNative) {
          await window.ClawnNative.lockLandscape();
          setLandscapeFallback(false);
          return;
        }

        if (typeof screen.orientation?.lock === 'function') {
          await screen.orientation.lock('landscape');
          setLandscapeFallback(false);
          return;
        }
      } catch {
        // iOS y algunos navegadores Android rechazan el bloqueo; se usa el modo visual.
      }

      setLandscapeFallback(true);
    };

    const leaveFullscreen = async () => {
      landscapeFullscreenRequested = false;
      setLandscapeFallback(false);
      await unlockOrientation();

      if (document.fullscreenElement) {
        await document.exitFullscreen?.().catch(() => undefined);
      }
    };

    const toggleFullscreen = async () => {
      if (document.fullscreenElement || landscapeFallbackActive) {
        await leaveFullscreen();
        return;
      }

      landscapeFullscreenRequested = true;

      try {
        if (playerShell?.requestFullscreen) {
          await playerShell.requestFullscreen();
          await requestLandscape();
        } else {
          setLandscapeFallback(true);
        }
      } catch {
        setLandscapeFallback(true);
      }

      updateFullscreenUI();
      resetHideTimer();
    };

    const syncFullscreenState = () => {
      const isNativeFullscreen = Boolean(document.fullscreenElement);

      if (isNativeFullscreen) {
        nativeFullscreenActive = true;
      } else if (nativeFullscreenActive) {
        nativeFullscreenActive = false;
        landscapeFullscreenRequested = false;
        setLandscapeFallback(false);
        void unlockOrientation();
      }

      updateFullscreenUI();
      if (isNativeFullscreen || landscapeFallbackActive) {
        resetHideTimer();
      }
    };

    const setCinemaMode = (enabled) => {
      cinemaMode = enabled;
      playerShell?.classList.toggle('cinema-mode', cinemaMode);
      watchSection?.classList.toggle('cinema-mode', cinemaMode);
      document.body?.classList.toggle('cinema-mode-active', cinemaMode);
      cinemaToggle?.classList.toggle('active', cinemaMode);
    };

    const applySubtitleStyles = () => {
      const root = playerShell;
      if (!root) return;
      root.style.setProperty('--subtitle-bg-opacity', String(subtitleSettings.backgroundOpacity));
      root.style.setProperty('--subtitle-font-size', `${subtitleSettings.size}%`);
    };

    const loadPlayerPreferences = () => {
      try {
        const raw = localStorage.getItem(playerPrefsKey);
        if (!raw) return;
        const parsed = JSON.parse(raw);
        if (!parsed || typeof parsed !== 'object') return;

        if (typeof parsed.subtitleTrack === 'string') {
          playerPrefs.subtitleTrack = parsed.subtitleTrack;
          subtitleSettings.selectedTrack = parsed.subtitleTrack;
        }
        if (typeof parsed.volume === 'number' && Number.isFinite(parsed.volume)) {
          playerPrefs.volume = Math.max(0, Math.min(1, parsed.volume));
        }
        if (typeof parsed.muted === 'boolean') playerPrefs.muted = parsed.muted;
        if (typeof parsed.playbackRate === 'number' && Number.isFinite(parsed.playbackRate)) {
          playerPrefs.playbackRate = Math.max(0.25, Math.min(4, parsed.playbackRate));
        }
      } catch (error) {
        console.warn('No se pudieron cargar las preferencias del player', error);
      }
    };

    const persistPlayerPreferences = () => {
      try {
        localStorage.setItem(playerPrefsKey, JSON.stringify(playerPrefs));
      } catch (error) {
        console.warn('No se pudieron guardar las preferencias del player', error);
      }
    };

    // Alias para no romper los llamados existentes a persistSubtitlePreferences.
    const persistSubtitlePreferences = () => {
      playerPrefs.subtitleTrack = subtitleSettings.selectedTrack;
      persistPlayerPreferences();
    };

    const updateNextEpisodeCTA = () => {
      if (!(nextEpisodeCta instanceof HTMLElement) || !video.duration) return;
      const remaining = video.duration - video.currentTime;
      const shouldShow = video.ended || (remaining > 0 && remaining <= 25);
      nextEpisodeCta.hidden = !shouldShow;
    };

    const cueDefaults = new WeakMap();

    const cueOverlapsAnother = (cue, cues) => {
      return cues.some((otherCue) => {
        if (otherCue === cue) return false;
        return cue.startTime < otherCue.endTime && otherCue.startTime < cue.endTime;
      });
    };

    const applySubtitlePosition = () => {
      const subtitleTracks = Array.from(video.textTracks).filter((track) => track.kind === 'subtitles');
      subtitleTracks.forEach((track) => {
        const cues = track.cues ? Array.from(track.cues) : [];
        cues.forEach((cue) => {
          if (!('line' in cue)) return;

          if (!cueDefaults.has(cue)) {
            cueDefaults.set(cue, {
              line: cue.line,
              snapToLines: cue.snapToLines,
            });
          }

          const defaults = cueDefaults.get(cue);
          const hasFixedLineInSource = defaults?.line !== 'auto' && defaults?.line != null;

          if (hasFixedLineInSource || cueOverlapsAnother(cue, cues)) {
            cue.line = defaults.line;
            cue.snapToLines = defaults.snapToLines;
            return;
          }

          cue.snapToLines = false;
          cue.line = isMobilePlayer() ? 88 : 78;
        });
      });
    };

    const splitBAndICues = () => {
      const subtitleTracks = Array.from(video.textTracks).filter((track) => track.kind === 'subtitles');
      subtitleTracks.forEach((track) => {
        const cues = track.cues ? Array.from(track.cues) : [];
        cues.forEach((cue) => {
          if (!(cue instanceof VTTCue) || typeof cue.text !== 'string') return;

          const hasBoldAndItalic = /<b>[\s\S]*?<\/b>[\s\n\r]*<i>[\s\S]*?<\/i>/i.test(cue.text);
          if (!hasBoldAndItalic) return;

          cue.text = cue.text.replace(/<\/b>[\s\n\r]*<i>/gi, '</b>\n\n<i>');
        });
      });
    };

    const toggleCinemaMode = () => {
      setCinemaMode(!cinemaMode);
    };

    const showControls = () => {
      playerUI?.classList.remove('controls-hidden');
    };

    const hideControls = () => {
      if (video.paused) return;
      playerUI?.classList.add('controls-hidden');
    };

    const resetHideTimer = () => {
      if (!playerShell || !playerUI) return;
      if (hideControlsTimer) clearTimeout(hideControlsTimer);
      showControls();
      if (!video.paused) {
        const isTouchDevice = window.matchMedia('(hover: none) and (pointer: coarse)').matches || navigator.maxTouchPoints > 0;
        const isLandscapePlayer = Boolean(
          document.fullscreenElement ||
          landscapeFallbackActive ||
          window.matchMedia('(orientation: landscape)').matches
        );
        const hideDelay = isTouchDevice && isLandscapePlayer ? 6500 : 3500;
        hideControlsTimer = setTimeout(() => hideControls(), hideDelay);
      }
    };

    const toggleControlsVisibility = () => {
      if (!playerUI) return;

      if (playerUI.classList.contains('controls-hidden')) {
        resetHideTimer();
        return;
      }

      if (hideControlsTimer) {
        clearTimeout(hideControlsTimer);
        hideControlsTimer = null;
      }
      playerUI.classList.add('controls-hidden');
    };

    const flashSeekFeedback = (direction) => {
      const feedback = direction < 0 ? seekFeedbackBackward : seekFeedbackForward;
      if (!feedback) return;

      seekFeedbackBackward?.classList.remove('is-visible');
      seekFeedbackForward?.classList.remove('is-visible');
      void feedback.offsetWidth;
      feedback.classList.add('is-visible');

      if (seekFeedbackTimer) clearTimeout(seekFeedbackTimer);
      seekFeedbackTimer = setTimeout(() => {
        feedback.classList.remove('is-visible');
      }, 620);
    };

    const seekBy = (seconds) => {
      const maximum = Number.isFinite(video.duration) ? video.duration : Infinity;
      video.currentTime = Math.max(0, Math.min(maximum, video.currentTime + seconds));
      flashSeekFeedback(seconds);
    };

    const handleMobileVideoTap = (event) => {
      if (event.pointerType !== 'touch') return;

      event.preventDefault();
      suppressTouchClickUntil = Date.now() + 700;

      const now = Date.now();
      const isDoubleTap = now - lastMobileTapAt < 320 && Math.abs(event.clientX - lastMobileTapX) < 96;

      if (isDoubleTap) {
        if (mobileTapTimer) clearTimeout(mobileTapTimer);
        mobileTapTimer = null;
        lastMobileTapAt = 0;

        const rect = video.getBoundingClientRect();
        seekBy(event.clientX < rect.left + rect.width / 2 ? -10 : 10);
        return;
      }

      lastMobileTapAt = now;
      lastMobileTapX = event.clientX;
      if (mobileTapTimer) clearTimeout(mobileTapTimer);
      mobileTapTimer = setTimeout(() => {
        toggleControlsVisibility();
        mobileTapTimer = null;
        lastMobileTapAt = 0;
      }, 280);
    };

    if (!video || !rawUrl || !canPlay) {
      if (!canPlay) {
        console.warn('Reproducción bloqueada por suscripción.');
      } else {
        console.error('No se pudo inicializar el reproductor: faltan datos de video');
      }
    } else {
      const url = rawUrl;
      const extractSourceUrl = (targetUrl) => {
        if (!targetUrl) return '';
        if (!targetUrl.includes('?url=')) return targetUrl;
        return decodeURIComponent(targetUrl.split('?url=').pop() || '');
      };

      const normalizeExt = (targetUrl) => {
        const decoded = extractSourceUrl(targetUrl);
        return decoded.split('.').pop()?.split('?')[0].toLowerCase() || '';
      };

      const deriveBasePaths = (parsed) => {
        const path = parsed.pathname.replace(/\/+$/, '');
        const basePaths = new Set();

        const withoutFile = path.replace(/\/(\d+)(?:\.m3u8|\.mp4|\.mkv)$/i, '');
        basePaths.add(withoutFile || '/');

        const fileMatch = path.match(/^(.*)\/(\d+)(\.[^.\/]+)$/);
        if (fileMatch) {
          const [, parentPath, episodeSegment] = fileMatch;
          basePaths.add(`${parentPath}/${episodeSegment}`);
        }

        return Array.from(basePaths);
      };

      const deriveFileCandidates = (targetUrl, extensions) => {
        try {
          const sourceUrl = extractSourceUrl(targetUrl);
          const parsed = new URL(sourceUrl);
          const pathname = parsed.pathname;
          const trimmedPath = pathname.replace(/\/$/, '');
          const isDirectory = pathname.endsWith('/');
          const directory = isDirectory ? trimmedPath : trimmedPath.slice(0, trimmedPath.lastIndexOf('/'));
          const filename = isDirectory ? '' : trimmedPath.split('/').pop() || '';
          const cleanFilename = filename.replace(/\.(m3u8|mp4|mkv)$/i, '');
          const episodeSegment = cleanFilename || directory.split('/').pop() || '';
          const padded = /^\d+$/.test(episodeSegment) ? episodeSegment.padStart(2, '0') : episodeSegment;

          const candidates = new Set();

          if (isDirectory) {
            extensions.forEach((ext) => {
              if (episodeSegment) candidates.add(proxify(`${parsed.origin}${directory}/${episodeSegment}.${ext}`));
              if (padded && padded !== episodeSegment) candidates.add(proxify(`${parsed.origin}${directory}/${padded}.${ext}`));
            });
          } else {
            extensions.forEach((ext) => {
              candidates.add(proxify(`${parsed.origin}${directory}/${cleanFilename}.${ext}`));
            });
          }

          return Array.from(candidates);
        } catch (error) {
          console.error('No se pudo procesar la URL del video', error);
          return [];
        }
      };

      const buildCandidates = (targetUrl) => {
        const baseCandidates = [targetUrl, ...deriveFileCandidates(targetUrl, ['m3u8', 'mp4', 'mkv'])];

        const canPlay = (candidate) => {
          const candidateExt = normalizeExt(candidate);
          if (candidateExt === 'm3u8') {
            return video.canPlayType('application/vnd.apple.mpegURL') || (window.Hls && Hls.isSupported());
          }
          if (candidateExt === 'mp4') return video.canPlayType('video/mp4');
          if (candidateExt === 'mkv') return video.canPlayType('video/x-matroska');
          return false;
        };

        const unique = Array.from(new Set(baseCandidates.filter(Boolean)));
        return unique.filter(canPlay);
      };

      const buildSubtitleCandidates = (targetUrl) => {
        try {
          const sourceUrl = targetUrl.includes('?url=')
            ? decodeURIComponent(targetUrl.split('?url=').pop() || '')
            : targetUrl;
          const parsed = new URL(sourceUrl);
          const pathname = parsed.pathname;
          const trimmedPath = pathname.replace(/\/$/, '');
          const isDirectory = pathname.endsWith('/');
          const directory = isDirectory ? trimmedPath : trimmedPath.slice(0, trimmedPath.lastIndexOf('/'));
          const filename = isDirectory ? '' : trimmedPath.split('/').pop() || '';
          const cleanFilename = filename.replace(/\.(m3u8|mp4|mkv)$/i, '');
          const episodeSegment = cleanFilename || directory.split('/').pop() || '';
          const padded = /^\d+$/.test(episodeSegment) ? episodeSegment.padStart(2, '0') : episodeSegment;

          const patterns = [
            episodeSegment ? `${episodeSegment}_subtitles_latam.vtt` : null,
            padded ? `${padded}_subtitles_latam.vtt` : null,
            episodeSegment ? `${episodeSegment}.vtt` : null,
            padded ? `${padded}.vtt` : null,
          ].filter(Boolean);

          return Array.from(
            new Set(
              patterns.map((pattern) => proxify(`${parsed.origin}${directory}/${pattern}`)),
            ),
          );
        } catch (error) {
          console.error('No se pudieron construir los candidatos de subtítulos', error);
          return [];
        }
      };

      const findReachableResource = async (urls) => {
        for (const candidate of urls) {
          try {
            const response = await fetch(candidate, { method: 'HEAD' });
            if (response.ok) return candidate;
          } catch (_) {
            // ignora y continúa con el siguiente
          }
        }
        return null;
      };

      const populateSubtitleSelect = () => {
        if (!(subtitleSelect instanceof HTMLSelectElement)) return;
        const subtitleTracks = Array.from(video.textTracks).filter((track) => track.kind === 'subtitles');
        if (subtitleTracks.length === 0) {
          subtitleSelect.hidden = true;
          return;
        }

        subtitleSelect.hidden = false;
        subtitleSelect.innerHTML = '<option value="off">Subtítulos: desactivados</option>';

        subtitleTracks.forEach((track, index) => {
          const option = document.createElement('option');
          option.value = String(index);
          option.textContent = track.label ? `Subtítulos: ${track.label}` : `Subtítulos ${index + 1}`;
          subtitleSelect.appendChild(option);
        });

        const defaultIndex = subtitleTracks.findIndex((track) => track.mode === 'showing');
        const desiredValue = subtitleSettings.selectedTrack;
        const hasDesiredTrack = desiredValue !== 'off' && subtitleTracks[Number(desiredValue)];
        subtitleSelect.value = hasDesiredTrack ? desiredValue : (defaultIndex >= 0 ? String(defaultIndex) : 'off');
      };

      const applySubtitleSelection = (value) => {
        const subtitleTracks = Array.from(video.textTracks).filter((track) => track.kind === 'subtitles');
        subtitleTracks.forEach((track, index) => {
          track.mode = value === String(index) ? 'showing' : 'disabled';
        });
        subtitleSettings.selectedTrack = value;
        persistSubtitlePreferences();
        applySubtitlePosition();
      };

      const attachSubtitles = async () => {
        const subtitlesUrl = await findReachableResource(buildSubtitleCandidates(url));
        if (!subtitlesUrl) {
          populateSubtitleSelect();
          return;
        }

        const track = document.createElement('track');
        track.kind = 'subtitles';
        track.label = 'Español';
        track.srclang = 'es';
        track.src = subtitlesUrl;
        track.default = true;
        video.appendChild(track);
        track.addEventListener('load', () => {
          splitBAndICues();
          applySubtitleStyles();
          applySubtitlePosition();
          applySubtitleSelection(subtitleSettings.selectedTrack || '0');
          populateSubtitleSelect();
        });
      };

      const attachHls = (hlsUrl) => {
        const hls = new Hls();
        hls.loadSource(hlsUrl);
        hls.attachMedia(video);
        hls.on(Hls.Events.ERROR, (_, data) => console.error('HLS error', data));
      };

      const playCandidate = (candidate) => {
        const candidateExt = normalizeExt(candidate);

        if (candidateExt === 'm3u8') {
          if (video.canPlayType('application/vnd.apple.mpegURL')) {
            video.src = candidate;
            return true;
          }

          if (window.Hls && Hls.isSupported()) {
            attachHls(candidate);
            return true;
          }

          return false;
        }

        video.src = candidate;
        return true;
      };

      const initializePlayer = () => {
        const candidates = buildCandidates(url);
        let currentIndex = 0;

        const tryNext = () => {
          const candidate = candidates[currentIndex];
          if (!candidate) {
            console.error('No se encontró ninguna fuente compatible para el reproductor');
            return;
          }

          const success = playCandidate(candidate);
          if (!success) {
            currentIndex += 1;
            tryNext();
          }
        };

        video.addEventListener('error', () => {
          currentIndex += 1;
          tryNext();
        });

        tryNext();
      };

      const applySavedProgress = () => {
        if (!savedProgress || Number.isNaN(savedProgress)) return;

        const trySeek = () => {
          if (!video.duration) return false;
          const limit = Math.max(video.duration - 10, 0);
          if (savedProgress < limit) {
            video.currentTime = savedProgress;
          }
          return true;
        };

        if (!trySeek()) {
          video.addEventListener(
            'loadedmetadata',
            () => {
              trySeek();
            },
            { once: true },
          );
        }
      };

      const startProgressLoop = () => {
        if (!userId || progressTimer) return;
        progressTimer = setInterval(() => {
          if (video.paused || video.readyState < 2) return;
          persistProgress(video.currentTime, false);
        }, 8000);
      };

      const stopProgressLoop = (sendFinal = false) => {
        if (sendFinal && !video.paused) {
          persistProgress(video.currentTime, false, true);
        }
        if (progressTimer) {
          clearInterval(progressTimer);
          progressTimer = null;
        }
      };

      video.addEventListener('play', () => {
        startProgressLoop();
        updatePlayIcon();
        resetHideTimer();
      });
      video.addEventListener('pause', () => {
        stopProgressLoop(true);
        updatePlayIcon();
        showControls();
        if (hideControlsTimer) {
          clearTimeout(hideControlsTimer);
          hideControlsTimer = null;
        }
      });
      video.addEventListener('ended', () => {
        stopProgressLoop(false);
        persistProgress(video.duration || video.currentTime || savedProgress, true, true);
        updatePlayIcon();
        showControls();
        updateNextEpisodeCTA();
      });

      window.addEventListener('beforeunload', () => {
        if (!userId) return;
        persistProgress(video.currentTime || 0, video.ended, true);
      });

      video.addEventListener('loadedmetadata', () => {
        applySavedProgress();
        syncDuration();
      });
      video.addEventListener('timeupdate', updateProgress);
      video.addEventListener('timeupdate', updateNextEpisodeCTA);
      video.addEventListener('seeking', () => {
        if (progressBar && !isUserSeeking && video.duration) {
          const percent = (video.currentTime / video.duration) * 100;
          progressBar.value = percent;
          renderProgressFill(percent);
        }
      });
      video.addEventListener('seeked', () => {
        isUserSeeking = false;
      });
      video.addEventListener('pointerup', handleMobileVideoTap);
      video.addEventListener('click', (event) => {
        const cameFromTouch = event.sourceCapabilities?.firesTouchEvents === true;
        if (cameFromTouch || Date.now() < suppressTouchClickUntil) {
          event.preventDefault();
          return;
        }
        togglePlay();
      });
      playToggle?.addEventListener('click', togglePlay);
      rewindToggle?.addEventListener('click', () => {
        seekBy(-10);
      });
      forwardToggle?.addEventListener('click', () => {
        seekBy(10);
      });
      progressBar?.addEventListener('pointerdown', (event) => {
        isUserSeeking = true;
        const rect = progressBar.getBoundingClientRect();
        const percent = ((event.clientX - rect.left) / rect.width) * 100;
        showTimelinePreview(Math.max(0, Math.min(100, percent)), event.clientX);
      });
      progressBar?.addEventListener('input', (e) => {
        const value = Number(e.target.value);
        isUserSeeking = true;
        seekTo(value, false);
        showTimelinePreview(value);

        if (seekCommitTimer) clearTimeout(seekCommitTimer);
        seekCommitTimer = setTimeout(() => {
          seekTo(value, true);
        }, 120);
      });
      progressBar?.addEventListener('change', (e) => {
        const value = Number(e.target.value);
        if (seekCommitTimer) clearTimeout(seekCommitTimer);
        seekTo(value, true);
        isUserSeeking = false;
        hideTimelinePreview();
      });
      progressBar?.addEventListener('pointermove', (event) => {
        const rect = progressBar.getBoundingClientRect();
        const percent = ((event.clientX - rect.left) / rect.width) * 100;
        showTimelinePreview(Math.max(0, Math.min(100, percent)), event.clientX);
      });
      progressBar?.addEventListener('mouseenter', (event) => {
        const rect = progressBar.getBoundingClientRect();
        const percent = ((event.clientX - rect.left) / rect.width) * 100;
        showTimelinePreview(Math.max(0, Math.min(100, percent)), event.clientX);
      });
      progressBar?.addEventListener('mouseleave', hideTimelinePreview);
      progressBar?.addEventListener('pointerup', () => {
        isUserSeeking = false;
        hideTimelinePreview();
      });
      progressBar?.addEventListener('touchend', () => {
        isUserSeeking = false;
        hideTimelinePreview();
      });
      fullscreenToggle?.addEventListener('click', toggleFullscreen);
      muteToggle?.addEventListener('click', toggleMute);
      volumeSlider?.addEventListener('input', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLInputElement)) return;
        video.volume = Math.max(0, Math.min(1, Number(target.value)));
        video.muted = video.volume === 0;
        updateVolumeUI();
      });
      video.addEventListener('volumechange', updateVolumeUI);
      document.addEventListener('fullscreenchange', syncFullscreenState);
      document.addEventListener('clawn:native-back', (event) => {
        if (!document.fullscreenElement && !landscapeFallbackActive) return;
        event.preventDefault();
        void leaveFullscreen();
      });
      window.addEventListener('orientationchange', syncFullscreenState);
      window.addEventListener('resize', syncFullscreenState);
      cinemaToggle?.addEventListener('click', toggleCinemaMode);
      subtitleSelect?.addEventListener('change', (event) => {
        const target = event.target;
        if (!(target instanceof HTMLSelectElement)) return;
        applySubtitleSelection(target.value);
      });

      document.addEventListener('keydown', (event) => {
        const tag = document.activeElement?.tagName || '';
        if (['INPUT', 'TEXTAREA', 'SELECT'].includes(tag)) return;

        switch (event.key.toLowerCase()) {
          case 'f':
            event.preventDefault();
            toggleFullscreen();
            break;
          case 'm':
            event.preventDefault();
            toggleMute();
            break;
          case 't':
            event.preventDefault();
            toggleCinemaMode();
            break;
          case 'arrowright':
            event.preventDefault();
            video.currentTime = Math.min(video.duration || Infinity, video.currentTime + 10);
            break;
          case 'arrowleft':
            event.preventDefault();
            video.currentTime = Math.max(0, video.currentTime - 10);
            break;
        }
      });

      playerShell?.addEventListener('pointerdown', (event) => {
        if (event.pointerType === 'touch') {
          suppressTouchClickUntil = Date.now() + 800;
        }
      });
      playerShell?.addEventListener('pointermove', (event) => {
        if (event.pointerType !== 'mouse' || Date.now() < suppressTouchClickUntil) return;
        resetHideTimer();
      });
      playerShell?.addEventListener('keydown', resetHideTimer);
      playerUI?.addEventListener('pointerdown', (event) => {
        const target = event.target;
        if (!(target instanceof Element)) return;
        if (target.closest('button, input, select, a')) resetHideTimer();
      });

      loadPlayerPreferences();

      // Aplica volumen/mute/rate ya mismo (son del propio <video>, no esperan tracks).
      // Hls.js re-crea el media element y a veces resetea playbackRate al attach,
      // así que las re-aplicamos también en loadedmetadata para asegurarnos.
      const applyPrefsToVideo = () => {
        try {
          video.volume = playerPrefs.volume;
          video.muted = playerPrefs.muted;
          video.playbackRate = playerPrefs.playbackRate;
        } catch (error) {
          console.warn('No se pudieron aplicar las preferencias del player al <video>', error);
        }
      };
      applyPrefsToVideo();
      // Cada vez que se asigna video.src (en el fallback por 404, o en el play
      // real), el browser resetea playbackRate. Lo re-aplicamos en loadstart
      // (que dispara en cada intento, exista o no la fuente) y en loadedmetadata
      // (cuando el media efectivamente carga).
      video.addEventListener('loadstart', applyPrefsToVideo);
      video.addEventListener('loadedmetadata', applyPrefsToVideo);
      updateVolumeUI();

      // Persistimos volumen/mute cuando el usuario los toca. Sólo persistimos
      // una vez que la UI ya se asentó: hls.js dispara volumechange al attach
      // y antes de eso cualquier cambio del propio applyPrefsToVideo no debe
      // sobrescribir el preset guardado con el valor "virgen".
      let persistVolumeEnabled = false;
      video.addEventListener('loadedmetadata', () => {
        // Un tick después del metadata para dejar que hls.js termine su setup.
        setTimeout(() => { persistVolumeEnabled = true; }, 50);
      });
      // Si nunca llega loadedmetadata (archivo roto, 404), igual habilitamos
      // tras un segundo para no bloquear al usuario que ajusta el volumen.
      setTimeout(() => { persistVolumeEnabled = true; }, 1500);
      video.addEventListener('volumechange', () => {
        if (!persistVolumeEnabled) return;
        playerPrefs.volume = Number(video.volume);
        playerPrefs.muted = Boolean(video.muted);
        persistPlayerPreferences();
      });
      // playbackRate: no hay UI dedicada en el player de la serie, pero si el
      // player raw o un shortcut externo lo cambió, se persiste.
      video.addEventListener('ratechange', () => {
        if (!persistVolumeEnabled) return;
        playerPrefs.playbackRate = Number(video.playbackRate) || 1;
        persistPlayerPreferences();
      });

      syncDuration();
      updateProgress();
      updateNextEpisodeCTA();
      initializePlayer();
      // initializePlayer asigna video.src, lo cual resetea playbackRate según
      // el spec de HTML5. Re-aplicamos ya mismo para que la pref sobreviva al
      // reset. (volume y muted no se resetean por src, pero no cuesta nada.)
      applyPrefsToVideo();
      attachSubtitles();
      applySavedProgress();
      applySubtitleStyles();
      renderProgressFill(Number(progressBar?.value ?? 0));
      updatePlayIcon();
      updateVolumeUI();
      updateFullscreenUI();
      resetHideTimer();
    }
  </script>

  <script>
    (() => {
    const commentsList = document.getElementById('comments-list');
    const commentForm = document.getElementById('comment-form');
    const commentInput = document.getElementById('comment-input');
    const commentStatus = document.getElementById('comment-status');

    if (!commentsList) return;

    const episodioId = commentsList.dataset.episodioId;
    const currentUserId = Number(commentsList.dataset.userId || 0);
    const isAdmin = commentsList.dataset.userAdmin === 'true';
    const canComment = commentsList.dataset.canComment === 'true';
    const endpoint = `/api/comments/${encodeURIComponent(episodioId || '')}`;
    let comments = [];

    const escapeHtml = (value) =>
      String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    const setStatus = (text, isError = false) => {
      if (!commentStatus) return;
      commentStatus.textContent = text;
      commentStatus.classList.toggle('text-red-300', isError);
    };

    const canDeleteComment = (comment) => isAdmin || (currentUserId > 0 && Number(comment.userId) === currentUserId);

    const formatCommentDate = (comment) => {
      const parsed = new Date(comment.createdAt);
      if (Number.isNaN(parsed.getTime())) return '';
      return parsed.toLocaleString(navigator.language || 'es-ES', { dateStyle: 'medium', timeStyle: 'short' });
    };

    const renderComments = () => {
      if (comments.length === 0) {
        commentsList.innerHTML = '<p class="text-sm text-white/60">Sé la primera persona en comentar.</p>';
        return;
      }

      commentsList.innerHTML = comments
        .map((comment) => `<div class="rounded-2xl border border-white/10 bg-black/40 p-4">
            <div class="flex items-center justify-between gap-3 text-xs text-white/50">
              <span class="min-w-0 truncate font-semibold text-white/70">${escapeHtml(comment.name)}</span>
              <span class="flex shrink-0 items-center gap-3">
                <span>${escapeHtml(formatCommentDate(comment))}</span>
                ${canDeleteComment(comment) ? `<button type="button" class="text-red-200 hover:text-red-100" data-delete-id="${Number(comment.id)}">Eliminar</button>` : ''}
              </span>
            </div>
            <p class="mt-2 whitespace-pre-line break-words text-sm text-white/80">${escapeHtml(comment.text)}</p>
          </div>`)
        .join('');
    };

    const loadComments = async () => {
      try {
        const response = await fetch(endpoint, { headers: { Accept: 'application/json' } });
        const data = await response.json();
        if (!response.ok) throw new Error(data?.error || 'No se pudieron cargar los comentarios.');
        comments = Array.isArray(data.comments) ? data.comments : [];
        renderComments();
      } catch (error) {
        commentsList.innerHTML = '<p class="text-sm text-red-300">No se pudieron cargar los comentarios.</p>';
        console.error(error);
      }
    };

    commentsList.addEventListener('click', async (event) => {
      const target = event.target instanceof Element ? event.target.closest('[data-delete-id]') : null;
      if (!(target instanceof HTMLButtonElement)) return;
      const id = Number(target.dataset.deleteId);
      if (!id) return;
      target.disabled = true;
      try {
        const response = await fetch(`${endpoint}?id=${id}`, { method: 'DELETE' });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data?.error || 'No se pudo eliminar.');
        comments = comments.filter((comment) => Number(comment.id) !== id);
        renderComments();
      } catch (error) {
        target.disabled = false;
        setStatus(error instanceof Error ? error.message : 'No se pudo eliminar.', true);
      }
    });

    commentForm?.addEventListener('submit', async (event) => {
      event.preventDefault();
      if (!canComment || !(commentInput instanceof HTMLTextAreaElement)) return;
      const text = commentInput.value.trim();
      if (!text) return;

      const submit = commentForm.querySelector('button[type="submit"]');
      if (submit instanceof HTMLButtonElement) submit.disabled = true;
      setStatus('Publicando…');
      try {
        const response = await fetch(endpoint, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ text }),
        });
        const data = await response.json().catch(() => ({}));
        if (!response.ok) throw new Error(data?.error || 'No se pudo publicar el comentario.');
        comments = [data.comment, ...comments];
        commentInput.value = '';
        renderComments();
        setStatus('Comentario publicado.');
      } catch (error) {
        setStatus(error instanceof Error ? error.message : 'No se pudo publicar el comentario.', true);
      } finally {
        if (submit instanceof HTMLButtonElement) submit.disabled = false;
      }
    });

    loadComments();
    })();
  </script>

