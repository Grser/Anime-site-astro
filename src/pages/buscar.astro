---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const q = Astro.url.searchParams.get('q')?.trim() || '';
---

<Layout title="ClawnVid | Buscar anime" description="Busca series, géneros y episodios en ClawnVid.">
  <section class="min-h-[70vh] text-white">
    <div class="mx-auto max-w-screen-2xl px-3 pb-12 pt-3 sm:px-6 sm:pt-8 lg:px-8">
      <div class="overflow-hidden rounded-[1.6rem] border border-white/10 bg-gradient-to-br from-purple-950/55 via-[#111019] to-black shadow-2xl shadow-black/45 sm:rounded-[2rem]">
        <div class="grid gap-5 p-4 sm:p-7 lg:grid-cols-[minmax(0,1fr)_minmax(26rem,.8fr)] lg:items-center lg:gap-10 lg:p-10">
          <div class="min-w-0">
            <span class="inline-flex items-center gap-2 rounded-full border border-purple-400/20 bg-purple-500/10 px-3 py-1.5 text-[10px] font-semibold uppercase tracking-[0.25em] text-purple-200 sm:text-xs">
              Descubre algo nuevo
            </span>
            <h1 class="mt-3 text-3xl font-black leading-[1.04] text-white sm:text-5xl">
              ¿Qué quieres ver?
            </h1>
            <p class="mt-2 max-w-xl text-sm leading-relaxed text-white/58 sm:text-base">
              Busca por título, género o una palabra que recuerdes.
            </p>
          </div>

          <div class="min-w-0">
            <label for="search-input" class="sr-only">Buscar anime</label>
            <div class="group flex items-center gap-2 rounded-2xl border border-white/12 bg-black/35 p-2 shadow-inner shadow-black/35 transition focus-within:border-purple-400/60 focus-within:bg-black/50 focus-within:ring-4 focus-within:ring-purple-500/10 sm:rounded-[1.4rem]">
              <span class="grid h-11 w-11 shrink-0 place-items-center rounded-xl bg-purple-500/12 text-purple-200">
                <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-5 w-5">
                  <circle cx="11" cy="11" r="6.5" stroke-width="1.8" />
                  <path stroke-width="1.8" stroke-linecap="round" d="m16 16 4 4" />
                </svg>
              </span>
              <input
                id="search-input"
                type="search"
                value={q}
                autocomplete="off"
                spellcheck="false"
                enterkeyhint="search"
                autofocus
                placeholder="Ej: Naruto, romance, acción..."
                class="h-11 min-w-0 flex-1 bg-transparent text-base font-medium text-white placeholder:text-white/32 focus:outline-none"
              />
              <button
                type="button"
                id="clear-search"
                aria-label="Limpiar búsqueda"
                class={`grid h-10 w-10 shrink-0 place-items-center rounded-xl bg-white/8 text-white/60 transition hover:bg-white/14 hover:text-white ${q ? '' : 'hidden'}`}
              >
                <svg viewBox="0 0 24 24" class="h-4 w-4" fill="none" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" d="m7 7 10 10M17 7 7 17" /></svg>
              </button>
            </div>

            <div class="mt-3 grid grid-cols-3 gap-2" aria-label="Resumen de búsqueda">
              <div class="rounded-2xl border border-white/8 bg-white/[0.045] px-3 py-2.5">
                <p class="text-[9px] font-semibold uppercase tracking-[0.18em] text-white/38">Resultados</p>
                <p class="mt-1 text-lg font-black text-white" data-results-count>--</p>
              </div>
              <div class="rounded-2xl border border-white/8 bg-white/[0.045] px-3 py-2.5">
                <p class="text-[9px] font-semibold uppercase tracking-[0.18em] text-white/38">Coincidencia</p>
                <p class="mt-1 text-lg font-black text-purple-200" data-top-score>--</p>
              </div>
              <div class="rounded-2xl border border-white/8 bg-white/[0.045] px-3 py-2.5">
                <p class="text-[9px] font-semibold uppercase tracking-[0.18em] text-white/38">Episodios</p>
                <p class="mt-1 text-lg font-black text-white" data-episodes-count>--</p>
              </div>
            </div>
          </div>
        </div>
      </div>

      <div class="mt-5 grid gap-4 lg:grid-cols-[minmax(0,1fr)_15rem] lg:items-start">
        <section id="results-shell" class="hidden min-w-0 rounded-[1.6rem] border border-white/10 bg-white/[0.025] p-3 sm:p-5" aria-live="polite">
          <div class="mb-4 flex items-end justify-between gap-3 px-1">
            <div>
              <p class="text-[10px] font-semibold uppercase tracking-[0.25em] text-purple-200/65">Resultados</p>
              <h2 class="mt-1 text-xl font-black text-white sm:text-2xl">Coincidencias</h2>
            </div>
            <span class="shrink-0 rounded-full bg-purple-500/12 px-3 py-1.5 text-[11px] font-semibold text-purple-100" data-list-count>
              0 resultados
            </span>
          </div>

          <div id="results-state" class="hidden rounded-2xl border border-white/10 bg-white/[0.04] p-5 text-center text-sm text-white/60"></div>
          <div id="results-list" class="grid grid-cols-2 gap-3 sm:grid-cols-3 xl:grid-cols-4"></div>
        </section>

        <aside class="grid grid-cols-2 gap-3 lg:grid-cols-1" aria-label="Accesos rápidos">
          <a href="/explorar" class="group rounded-2xl border border-white/10 bg-gradient-to-br from-purple-500/14 to-white/[0.03] p-4 transition hover:border-purple-300/30">
            <span class="text-[10px] font-semibold uppercase tracking-[0.22em] text-purple-200/65">Sin una idea</span>
            <strong class="mt-2 block text-sm text-white group-hover:text-purple-100">Explora tendencias →</strong>
          </a>
          <a href="/directorio" class="group rounded-2xl border border-white/10 bg-white/[0.035] p-4 transition hover:border-white/20">
            <span class="text-[10px] font-semibold uppercase tracking-[0.22em] text-white/40">Todo en A–Z</span>
            <strong class="mt-2 block text-sm text-white group-hover:text-purple-100">Abrir directorio →</strong>
          </a>
        </aside>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const searchInput = document.getElementById('search-input');
      const clearButton = document.getElementById('clear-search');
      const resultsCount = document.querySelector('[data-results-count]');
      const topScore = document.querySelector('[data-top-score]');
      const episodesCount = document.querySelector('[data-episodes-count]');
      const resultsShell = document.getElementById('results-shell');
      const resultsList = document.getElementById('results-list');
      const resultsState = document.getElementById('results-state');
      const listCount = document.querySelector('[data-list-count]');

      if (!(searchInput instanceof HTMLInputElement)) return;

      // Que el cursor esté en el input al entrar. autofocus a veces es ignorado
      // tras navegación client-side, por eso lo forzamos acá en microtask.
      queueMicrotask(() => {
        try { searchInput.focus({ preventScroll: true }); } catch {}
      });

      let controller = null;
      let debounceTimer = null;

      const escapeHtml = (value) => String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');

      const setVisible = (element, visible) => {
        if (!element) return;
        element.classList.toggle('hidden', !visible);
      };

      const updateStats = (results) => {
        const hasQuery = Boolean(searchInput.value.trim());
        const totalEpisodes = results.reduce((total, serie) => total + (Number(serie.episodio_count) || 0), 0);
        if (resultsCount) resultsCount.textContent = hasQuery ? String(results.length) : '--';
        if (topScore) topScore.textContent = hasQuery && results.length ? `${results[0]?.match_score ?? 0}%` : '--';
        if (episodesCount) episodesCount.textContent = hasQuery ? String(totalEpisodes) : '--';
      };

      const resetResults = () => {
        setVisible(resultsShell, false);
        if (resultsList) resultsList.innerHTML = '';
        if (resultsState) {
          resultsState.textContent = '';
          setVisible(resultsState, false);
        }
        if (listCount) listCount.textContent = '0 resultados';
        updateStats([]);
      };

      const showState = (message) => {
        setVisible(resultsShell, true);
        if (resultsState) {
          resultsState.textContent = message;
          setVisible(resultsState, true);
        }
        if (resultsList) resultsList.innerHTML = '';
      };

      const renderResults = (results) => {
        if (!resultsList) return;
        setVisible(resultsShell, true);
        setVisible(resultsState, false);
        if (listCount) listCount.textContent = `${results.length} ${results.length === 1 ? 'resultado' : 'resultados'}`;

        if (!results.length) {
          showState('No encontramos coincidencias. Prueba con otro título o género.');
          return;
        }

        resultsList.innerHTML = results.map((serie) => `
          <a href="/serie/${encodeURIComponent(serie.slug)}" class="group relative min-w-0 overflow-hidden rounded-2xl border border-white/10 bg-[#111019] shadow-lg transition hover:-translate-y-0.5 hover:border-purple-400/40">
            <div class="aspect-[3/4] overflow-hidden bg-white/5">
              <img src="${escapeHtml(serie.icon || '/avatar.jpeg')}" alt="${escapeHtml(serie.titulo)}" class="h-full w-full object-cover transition duration-300 group-hover:scale-[1.03]" onerror="this.src='/avatar.jpeg'" />
            </div>
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/25 to-transparent"></div>
            <div class="absolute inset-x-0 bottom-0 p-3">
              <p class="line-clamp-2 text-sm font-bold leading-tight text-white sm:text-base">${escapeHtml(serie.titulo)}</p>
              <div class="mt-2 flex flex-wrap gap-1 text-[9px] font-semibold text-white/72 sm:text-[10px]">
                <span class="rounded-full border border-white/10 bg-black/45 px-2 py-1">${Number(serie.temporada_count) || 0} Temp</span>
                <span class="rounded-full border border-white/10 bg-black/45 px-2 py-1">${Number(serie.episodio_count) || 0} Ep</span>
              </div>
            </div>
          </a>
        `).join('');
      };

      const updateUrl = (query) => {
        if (!history.replaceState) return;
        const url = new URL(window.location.href);
        if (query) url.searchParams.set('q', query);
        else url.searchParams.delete('q');
        history.replaceState({}, '', url);
      };

      const runSearch = async (rawValue) => {
        const query = String(rawValue || '').trim();
        controller?.abort();

        if (!query) {
          updateUrl('');
          resetResults();
          setVisible(clearButton, false);
          return;
        }

        setVisible(clearButton, true);
        showState('Buscando coincidencias…');
        controller = new AbortController();

        try {
          const response = await fetch(`/api/search?q=${encodeURIComponent(query)}&limit=24`, {
            signal: controller.signal,
            headers: { Accept: 'application/json' },
          });
          if (!response.ok) throw new Error('Falló la búsqueda');

          const data = await response.json();
          const results = Array.isArray(data.results) ? data.results : [];
          updateUrl(query);
          updateStats(results);
          renderResults(results);
        } catch (error) {
          if (error?.name === 'AbortError') return;
          console.error(error);
          showState('No pudimos cargar la búsqueda. Inténtalo nuevamente.');
          updateStats([]);
        }
      };

      const queueSearch = (value) => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => void runSearch(value), 180);
      };

      searchInput.addEventListener('input', () => queueSearch(searchInput.value));
      searchInput.addEventListener('keydown', (event) => {
        if (event.key !== 'Enter') return;
        event.preventDefault();
        clearTimeout(debounceTimer);
        void runSearch(searchInput.value);
      });

      clearButton?.addEventListener('click', () => {
        searchInput.value = '';
        updateUrl('');
        setVisible(clearButton, false);
        resetResults();
        searchInput.focus();
      });

      if (searchInput.value.trim()) void runSearch(searchInput.value);
      else resetResults();
    })();
  </script>
</Layout>
