  .random-primary-button:hover,
  .random-secondary-button:hover {
    transform: translateY(-1px);
  }

  @media (max-width: 640px) {
    .random-series-modal {
      width: min(100vw - 0.75rem, 34rem);
      border-radius: 1.05rem;
    }

    .random-series-copy {
      display: grid;
      padding: 0.85rem;
    }

    .random-series-copy > div:last-child {
