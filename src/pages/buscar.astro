---
import Layout from '../layouts/Layout.astro';
import db from '../lib/db';

export const prerender = false;

interface Serie {
  id: number;
  slug: string;
  titulo: string;
  icon: string;
  descripcion: string;
  genero?: string;
  temporada_count: number;
  episodio_count: number;
  match_score?: number;
}

const q = Astro.url.searchParams.get('q')?.trim() || '';
let results: Serie[] = [];

if (q) {
  const normalizedQuery = q.toLowerCase();

  [results] = await db.query<Serie[]>(
    `
    SELECT
      s.id,
      s.slug,
      s.titulo,
      s.icon,
      s.descripcion,
      s.genero,
      (SELECT COUNT(*) FROM temporadas t WHERE t.serie_id = s.id) AS temporada_count,
      (SELECT COUNT(*) FROM episodios e
         JOIN temporadas t ON e.temporada_id = t.id
         WHERE t.serie_id = s.id) AS episodio_count,
      CASE
        WHEN LOWER(s.titulo) = ? THEN 100
        WHEN LOWER(s.titulo) LIKE CONCAT(?, '%') THEN 85
        WHEN LOWER(s.titulo) LIKE CONCAT('%', ?, '%') THEN 70
        WHEN LOWER(COALESCE(s.genero, '')) LIKE CONCAT('%', ?, '%') THEN 35
        WHEN LOWER(COALESCE(s.descripcion, '')) LIKE CONCAT('%', ?, '%') THEN 20
        ELSE 0
      END AS match_score
    FROM series s
    WHERE LOWER(s.titulo) LIKE CONCAT('%', ?, '%')
       OR LOWER(COALESCE(s.genero, '')) LIKE CONCAT('%', ?, '%')
       OR LOWER(COALESCE(s.descripcion, '')) LIKE CONCAT('%', ?, '%')
    ORDER BY match_score DESC, s.titulo ASC
    LIMIT 24;
    `,
    [normalizedQuery, normalizedQuery, normalizedQuery, normalizedQuery, normalizedQuery, normalizedQuery, normalizedQuery, normalizedQuery]
  );
}

const topResult = results[0] ?? null;
const moreResults = topResult ? results.slice(1) : results;
---

<Layout title="ClawnVid | Buscar" description="Busca series en ClawnVid con resultados instantáneos y una experiencia tipo app.">
  <section class="min-h-screen bg-[#0a0a0f] text-white">
    <div class="mx-auto flex max-w-screen-2xl flex-col gap-8 px-4 pb-16 pt-24 md:px-6 lg:px-8">
      <div class="rounded-[2rem] border border-white/10 bg-gradient-to-br from-[#171722] via-[#0d0d14] to-black p-5 shadow-2xl shadow-black/40 md:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl space-y-3">
            <span class="inline-flex w-fit items-center gap-2 rounded-full border border-orange-400/20 bg-orange-500/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.28em] text-orange-200">
              Buscar en ClawnVid
            </span>
            <h1 class="text-3xl font-black leading-tight text-white md:text-5xl">Una búsqueda rápida, visual y directa, como debería sentirse.</h1>
            <p class="max-w-2xl text-sm text-white/65 md:text-base">
              Escribe el nombre de un anime y te mostramos la mejor coincidencia primero, sugerencias instantáneas y el resto del catálogo ordenado por relevancia.
            </p>
          </div>

          <div class="grid grid-cols-3 gap-3 md:min-w-[360px]">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <p class="text-xs uppercase tracking-[0.24em] text-white/45">Resultados</p>
              <p class="mt-2 text-2xl font-black" data-results-count>{q ? results.length : '--'}</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <p class="text-xs uppercase tracking-[0.24em] text-white/45">Top score</p>
              <p class="mt-2 text-2xl font-black" data-top-score>{topResult?.match_score ?? '--'}</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <p class="text-xs uppercase tracking-[0.24em] text-white/45">Capítulos</p>
              <p class="mt-2 text-2xl font-black" data-episodes-count>{q ? results.reduce((acc, serie) => acc + (serie.episodio_count || 0), 0) : '--'}</p>
            </div>
          </div>
        </div>

        <form action="/buscar" method="GET" id="search-form" class="mt-6 space-y-4">
          <div class="relative">
            <div class="flex items-center gap-3 rounded-[1.6rem] border border-white/10 bg-white/5 px-4 py-3 shadow-inner shadow-black/20 transition focus-within:border-orange-400/50 focus-within:bg-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-5 w-5 shrink-0 text-white/55">
                <circle cx="11" cy="11" r="7" stroke-width="1.7" />
                <path stroke-width="1.7" stroke-linecap="round" d="m16 16 4 4" />
              </svg>
              <input
                id="search-input"
                name="q"
                type="text"
                value={q}
                autocomplete="off"
                spellcheck="false"
                placeholder="Busca por título, género o palabra clave"
                class="h-12 w-full bg-transparent text-base text-white placeholder:text-white/35 focus:outline-none md:text-lg"
              />
              <button
                type="button"
                id="clear-search"
                class={`rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/75 transition hover:bg-white/15 ${q ? '' : 'hidden'}`}
              >
                Limpiar
              </button>
              <button
                type="submit"
                class="rounded-full bg-orange-500 px-5 py-3 text-sm font-bold text-white transition hover:bg-orange-400"
              >
                Buscar
              </button>
            </div>

            <div id="search-overlay" class="absolute left-0 right-0 top-[calc(100%+0.75rem)] z-30 hidden overflow-hidden rounded-[1.75rem] border border-white/10 bg-[#111118]/95 shadow-2xl shadow-black/60 backdrop-blur-xl">
              <div class="grid gap-0 lg:grid-cols-[1.15fr_0.85fr]">
                <div class="border-b border-white/10 p-4 lg:border-b-0 lg:border-r">
                  <div class="mb-3 flex items-center justify-between gap-3">
                    <p class="text-xs font-semibold uppercase tracking-[0.28em] text-white/40">Resultados rápidos</p>
                    <span class="text-xs text-white/40" data-overlay-count></span>
                  </div>
                  <div id="quick-results" class="space-y-2"></div>
                </div>
                <div class="p-4">
                  <p class="mb-3 text-xs font-semibold uppercase tracking-[0.28em] text-white/40">Sugerencias</p>
                  <div id="search-hints" class="flex flex-wrap gap-2">
                    <button type="button" class="hint-chip rounded-full border border-white/10 bg-white/5 px-3 py-2 text-sm text-white/80 hover:bg-white/10" data-hint="Naruto">Naruto</button>
                    <button type="button" class="hint-chip rounded-full border border-white/10 bg-white/5 px-3 py-2 text-sm text-white/80 hover:bg-white/10" data-hint="One Piece">One Piece</button>
                    <button type="button" class="hint-chip rounded-full border border-white/10 bg-white/5 px-3 py-2 text-sm text-white/80 hover:bg-white/10" data-hint="Romance">Romance</button>
                    <button type="button" class="hint-chip rounded-full border border-white/10 bg-white/5 px-3 py-2 text-sm text-white/80 hover:bg-white/10" data-hint="Acción">Acción</button>
                    <button type="button" class="hint-chip rounded-full border border-white/10 bg-white/5 px-3 py-2 text-sm text-white/80 hover:bg-white/10" data-hint="Jujutsu">Jujutsu</button>
                  </div>
                </div>
              </div>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 text-sm text-white/55">
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">Relevancia primero</span>
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">Resultado principal destacado</span>
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">Sugerencias en vivo</span>
          </div>
        </form>
      </div>

      <div class={`grid gap-6 xl:grid-cols-[1.1fr_1.4fr] ${q ? '' : 'hidden'}`} id="results-shell">
        <section class={`rounded-[2rem] border border-white/10 bg-white/[0.03] p-4 md:p-6 ${topResult ? '' : 'hidden'}`} data-featured-panel>
          <div class="mb-4 flex items-center justify-between gap-3">
            <div>
              <p class="text-xs uppercase tracking-[0.28em] text-orange-200/70">Mejor coincidencia</p>
              <h2 class="text-2xl font-black text-white">Resultado destacado</h2>
            </div>
            <span class="rounded-full bg-orange-500/15 px-3 py-1 text-xs font-semibold text-orange-100" data-featured-score>
              Score {topResult?.match_score ?? '--'}
            </span>
          </div>

          <a
            id="featured-link"
            href={topResult ? `/serie/${topResult.slug}` : '#'}
            class="group block overflow-hidden rounded-[1.6rem] border border-white/10 bg-[#111118]"
          >
            <div class="relative aspect-[16/10] overflow-hidden">
              <img id="featured-image" src={topResult?.icon || '/avatar.jpeg'} alt={topResult?.titulo || 'Resultado destacado'} class="h-full w-full object-cover transition duration-500 group-hover:scale-105" />
              <div class="absolute inset-0 bg-gradient-to-t from-black via-black/35 to-transparent"></div>
              <div class="absolute inset-x-0 bottom-0 p-5">
                <p class="mb-2 inline-flex rounded-full bg-white/10 px-3 py-1 text-xs font-semibold uppercase tracking-[0.24em] text-white/75 backdrop-blur">Top match</p>
                <h3 id="featured-title" class="text-3xl font-black text-white">{topResult?.titulo || 'Sin resultado'}</h3>
                <p id="featured-meta" class="mt-2 text-sm text-white/70">{topResult ? `${topResult.temporada_count} temporadas • ${topResult.episodio_count} episodios` : 'Busca una serie para verla aquí'}</p>
              </div>
            </div>
            <div class="space-y-4 p-5">
              <p id="featured-description" class="text-sm leading-6 text-white/72">{topResult?.descripcion || 'Cuando busques un anime, aquí aparecerá la coincidencia principal con acceso directo.'}</p>
              <div class="flex items-center justify-between gap-3">
                <span id="featured-genre" class="rounded-full border border-white/10 bg-white/5 px-3 py-1 text-xs text-white/70">{topResult?.genero || 'Catálogo'}</span>
                <span class="text-sm font-semibold text-orange-200">Abrir serie →</span>
              </div>
            </div>
          </a>
        </section>

        <section class="rounded-[2rem] border border-white/10 bg-white/[0.03] p-4 md:p-6">
          <div class="mb-4 flex items-center justify-between gap-3">
            <div>
              <p class="text-xs uppercase tracking-[0.28em] text-white/40">Resultados</p>
              <h2 class="text-2xl font-black text-white" data-results-heading>{q ? `Coincidencias para "${q}"` : 'Busca una serie'}</h2>
            </div>
            <span class={`rounded-full border border-white/10 bg-white/5 px-3 py-1 text-sm text-white/70 ${q ? '' : 'hidden'}`} data-results-chip>
              {results.length} encontrados
            </span>
          </div>

          <div class={`rounded-[1.6rem] border border-dashed border-white/10 bg-white/[0.03] p-8 text-center ${q ? 'hidden' : ''}`} data-empty-start>
            <p class="text-xl font-semibold text-white">Empieza escribiendo arriba.</p>
            <p class="mt-2 text-sm text-white/55">Te voy mostrando resultados mientras buscas.</p>
          </div>

          <div class="hidden rounded-[1.6rem] border border-white/10 bg-white/[0.03] p-8 text-center" data-loading-state>
            <p class="text-xl font-semibold text-white">Buscando...</p>
            <p class="mt-2 text-sm text-white/55">Ordenando las mejores coincidencias para ti.</p>
          </div>

          <div class={`rounded-[1.6rem] border border-white/10 bg-white/[0.03] p-8 text-center ${q && results.length === 0 ? '' : 'hidden'}`} data-no-results>
            <p class="text-xl font-semibold text-white">No encontré resultados para “{q}”.</p>
            <p class="mt-2 text-sm text-white/55">Prueba con otro nombre, género o palabra parecida.</p>
          </div>

          <div id="search-results" class={`space-y-3 ${q && results.length > 0 ? '' : 'hidden'}`}>
            {moreResults.map((serie, index) => (
              <a href={`/serie/${serie.slug}`} class="group flex items-center gap-4 rounded-[1.35rem] border border-white/10 bg-[#101018] p-3 transition hover:border-orange-400/40 hover:bg-[#151520]">
                <div class="relative h-24 w-20 shrink-0 overflow-hidden rounded-xl bg-white/5">
                  <img src={serie.icon || '/avatar.jpeg'} alt={serie.titulo} class="h-full w-full object-cover" onerror="this.src='/avatar.jpeg'" />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
                </div>
                <div class="min-w-0 flex-1 space-y-2">
                  <div class="flex items-start justify-between gap-3">
                    <div class="min-w-0">
                      <p class="text-xs uppercase tracking-[0.24em] text-white/35">#{index + 2}</p>
                      <h3 class="truncate text-lg font-bold text-white group-hover:text-orange-200">{serie.titulo}</h3>
                    </div>
                    <span class="rounded-full bg-white/5 px-3 py-1 text-xs text-white/60">{serie.match_score ?? 0}</span>
                  </div>
                  <p class="line-clamp-2 text-sm text-white/60">{serie.descripcion || 'Sin descripción disponible.'}</p>
                  <div class="flex flex-wrap gap-2 text-xs text-white/55">
                    <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">{serie.temporada_count} temporadas</span>
                    <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">{serie.episodio_count} episodios</span>
                    <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">{serie.genero || 'Anime'}</span>
                  </div>
                </div>
                <div class="hidden text-sm font-semibold text-orange-200 md:block">Ver →</div>
              </a>
            ))}
          </div>
        </section>
      </div>
    </div>
  </section>

  <script type="application/json" id="search-initial-results">{JSON.stringify(results)}</script>
  <script type="application/json" id="search-initial-query">{JSON.stringify(q)}</script>

  <script>
    const searchInput = document.getElementById('search-input');
    const searchForm = document.getElementById('search-form');
    const clearButton = document.getElementById('clear-search');
    const searchOverlay = document.getElementById('search-overlay');
    const quickResults = document.getElementById('quick-results');
    const overlayCount = document.querySelector('[data-overlay-count]');
    const resultsShell = document.getElementById('results-shell');
    const featuredPanel = document.querySelector('[data-featured-panel]');
    const featuredLink = document.getElementById('featured-link');
    const featuredImage = document.getElementById('featured-image');
    const featuredTitle = document.getElementById('featured-title');
    const featuredMeta = document.getElementById('featured-meta');
    const featuredDescription = document.getElementById('featured-description');
    const featuredGenre = document.getElementById('featured-genre');
    const featuredScore = document.querySelector('[data-featured-score]');
    const resultsContainer = document.getElementById('search-results');
    const resultsHeading = document.querySelector('[data-results-heading]');
    const resultsChip = document.querySelector('[data-results-chip]');
    const resultsCount = document.querySelector('[data-results-count]');
    const topScore = document.querySelector('[data-top-score]');
    const episodesCount = document.querySelector('[data-episodes-count]');
    const emptyStart = document.querySelector('[data-empty-start]');
    const loadingState = document.querySelector('[data-loading-state]');
    const noResults = document.querySelector('[data-no-results]');
    const initialResults = JSON.parse(document.getElementById('search-initial-results')?.textContent || '[]');
    const initialQuery = JSON.parse(document.getElementById('search-initial-query')?.textContent || '""');

    let currentQuery = (initialQuery || '').trim();
    let activeController;

    const escapeHtml = value => String(value || '')
      .replaceAll('&', '&amp;')
      .replaceAll('<', '&lt;')
      .replaceAll('>', '&gt;')
      .replaceAll('"', '&quot;')
      .replaceAll("'", '&#39;');

    const debounce = (fn, delay = 220) => {
      let timeoutId;
      return (...args) => {
        clearTimeout(timeoutId);
        timeoutId = setTimeout(() => fn(...args), delay);
      };
    };

    const setVisible = (element, visible) => {
      if (!element) return;
      element.classList.toggle('hidden', !visible);
    };

    const syncUrl = query => {
      const url = new URL(window.location.href);
      if (query) url.searchParams.set('q', query);
      else url.searchParams.delete('q');
      window.history.replaceState({}, '', url);
    };

    const renderQuickResults = results => {
      if (!quickResults) return;

      if (!currentQuery) {
        quickResults.innerHTML = '<p class="rounded-2xl bg-white/5 p-4 text-sm text-white/55">Empieza a escribir para ver sugerencias.</p>';
        overlayCount.textContent = '';
        return;
      }

      if (!results.length) {
        quickResults.innerHTML = '<p class="rounded-2xl bg-white/5 p-4 text-sm text-white/55">No encontré coincidencias rápidas.</p>';
        overlayCount.textContent = '0 resultados';
        return;
      }

      overlayCount.textContent = `${results.length} resultados`;
      quickResults.innerHTML = results.slice(0, 5).map((serie, index) => `
        <a href="/serie/${serie.slug}" class="flex items-center gap-3 rounded-2xl px-3 py-3 transition hover:bg-white/5">
          <div class="h-16 w-12 overflow-hidden rounded-xl bg-white/5">
            <img src="${escapeHtml(serie.icon || '/avatar.jpeg')}" alt="${escapeHtml(serie.titulo)}" class="h-full w-full object-cover" />
          </div>
          <div class="min-w-0 flex-1">
            <p class="truncate text-sm font-semibold text-white">${escapeHtml(serie.titulo)}</p>
            <p class="mt-1 text-xs text-white/45">#${index + 1} • ${serie.temporada_count || 0} temporadas • ${serie.episodio_count || 0} episodios</p>
          </div>
          <span class="text-xs font-semibold text-orange-200">Abrir</span>
        </a>
      `).join('');
    };

    const renderFeatured = serie => {
      if (!serie) {
        setVisible(featuredPanel, false);
        return;
      }

      setVisible(featuredPanel, true);
      featuredLink.href = `/serie/${serie.slug}`;
      featuredImage.src = serie.icon || '/avatar.jpeg';
      featuredImage.alt = serie.titulo || 'Serie';
      featuredTitle.textContent = serie.titulo || 'Sin título';
      featuredMeta.textContent = `${serie.temporada_count || 0} temporadas • ${serie.episodio_count || 0} episodios`;
      featuredDescription.textContent = serie.descripcion || 'Sin descripción disponible.';
      featuredGenre.textContent = serie.genero || 'Anime';
      featuredScore.textContent = `Score ${serie.match_score ?? 0}`;
    };

    const renderList = results => {
      if (!resultsContainer) return;

      const list = results.slice(1);
      if (!list.length) {
        resultsContainer.innerHTML = '';
        return;
      }

      resultsContainer.innerHTML = list.map((serie, index) => `
        <a href="/serie/${serie.slug}" class="group flex items-center gap-4 rounded-[1.35rem] border border-white/10 bg-[#101018] p-3 transition hover:border-orange-400/40 hover:bg-[#151520]">
          <div class="relative h-24 w-20 shrink-0 overflow-hidden rounded-xl bg-white/5">
            <img src="${escapeHtml(serie.icon || '/avatar.jpeg')}" alt="${escapeHtml(serie.titulo)}" class="h-full w-full object-cover" />
            <div class="absolute inset-0 bg-gradient-to-t from-black/60 to-transparent"></div>
          </div>
          <div class="min-w-0 flex-1 space-y-2">
            <div class="flex items-start justify-between gap-3">
              <div class="min-w-0">
                <p class="text-xs uppercase tracking-[0.24em] text-white/35">#${index + 2}</p>
                <h3 class="truncate text-lg font-bold text-white group-hover:text-orange-200">${escapeHtml(serie.titulo)}</h3>
              </div>
              <span class="rounded-full bg-white/5 px-3 py-1 text-xs text-white/60">${serie.match_score ?? 0}</span>
            </div>
            <p class="line-clamp-2 text-sm text-white/60">${escapeHtml(serie.descripcion || 'Sin descripción disponible.')}</p>
            <div class="flex flex-wrap gap-2 text-xs text-white/55">
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">${serie.temporada_count || 0} temporadas</span>
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">${serie.episodio_count || 0} episodios</span>
              <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">${escapeHtml(serie.genero || 'Anime')}</span>
            </div>
          </div>
          <div class="hidden text-sm font-semibold text-orange-200 md:block">Ver →</div>
        </a>
      `).join('');
    };

    const updateSummary = results => {
      const totalResults = results.length;
      const totalEpisodes = results.reduce((acc, serie) => acc + (Number(serie.episodio_count) || 0), 0);
      const bestScore = results[0]?.match_score ?? '--';

      resultsCount.textContent = currentQuery ? String(totalResults) : '--';
      topScore.textContent = currentQuery ? String(bestScore) : '--';
      episodesCount.textContent = currentQuery ? String(totalEpisodes) : '--';
      resultsHeading.textContent = currentQuery ? `Coincidencias para "${currentQuery}"` : 'Busca una serie';

      if (resultsChip) {
        resultsChip.textContent = `${totalResults} encontrados`;
        setVisible(resultsChip, Boolean(currentQuery));
      }
    };

    const updateStates = (results, { loading = false } = {}) => {
      const hasQuery = Boolean(currentQuery);
      const hasResults = hasQuery && results.length > 0;

      setVisible(resultsShell, hasQuery);
      setVisible(emptyStart, !hasQuery);
      setVisible(loadingState, hasQuery && loading);
      setVisible(noResults, hasQuery && !loading && !hasResults);
      setVisible(resultsContainer, hasResults && results.length > 1);
    };

    const renderAll = (results, options = {}) => {
      renderQuickResults(results);
      renderFeatured(results[0]);
      renderList(results);
      updateSummary(results);
      updateStates(results, options);
      setVisible(clearButton, Boolean(currentQuery));
    };

    const fetchResults = async query => {
      if (activeController) activeController.abort();
      activeController = new AbortController();

      const response = await fetch(`/api/search?q=${encodeURIComponent(query)}&limit=24`, {
        signal: activeController.signal,
      });

      if (!response.ok) throw new Error('No se pudo buscar');

      const data = await response.json();
      return Array.isArray(data.results) ? data.results : [];
    };

    const runSearch = debounce(async value => {
      currentQuery = value.trim();
      syncUrl(currentQuery);

      if (!currentQuery) {
        renderAll([]);
        setVisible(searchOverlay, false);
        return;
      }

      renderAll([], { loading: true });
      setVisible(searchOverlay, true);

      try {
        const results = await fetchResults(currentQuery);
        renderAll(results);
      } catch (error) {
        if (error.name !== 'AbortError') {
          console.error('Error en búsqueda', error);
          renderAll([]);
        }
      }
    }, 240);

    searchInput?.addEventListener('input', e => {
      const target = e.currentTarget;
      if (!(target instanceof HTMLInputElement)) return;
      runSearch(target.value);
    });

    searchInput?.addEventListener('focus', () => {
      setVisible(searchOverlay, true);
      if (searchInput.value.trim()) runSearch(searchInput.value);
      else renderQuickResults([]);
    });

    document.addEventListener('click', event => {
      const target = event.target;
      if (!(target instanceof Node)) return;
      if (!searchForm?.contains(target) && !searchOverlay?.contains(target)) {
        setVisible(searchOverlay, false);
      }
    });

    searchForm?.addEventListener('submit', event => {
      event.preventDefault();
      runSearch(searchInput?.value || '');
      setVisible(searchOverlay, true);
    });

    clearButton?.addEventListener('click', () => {
      if (!(searchInput instanceof HTMLInputElement)) return;
      searchInput.value = '';
      currentQuery = '';
      syncUrl('');
      renderAll([]);
      setVisible(searchOverlay, false);
      searchInput.focus();
    });

    document.querySelectorAll('[data-hint]').forEach(button => {
      button.addEventListener('click', () => {
        const hint = button.getAttribute('data-hint') || '';
        if (!(searchInput instanceof HTMLInputElement)) return;
        searchInput.value = hint;
        runSearch(hint);
        setVisible(searchOverlay, true);
      });
    });

    renderAll(initialResults);
  </script>
</Layout>
