      transform: translateY(-1px);
    }

    .notification-action-icon {
      display: grid;
      width: 2rem;
      height: 2rem;
      flex: 0 0 auto;
      place-items: center;
      border-radius: 0.65rem;
      background: rgba(232, 121, 249, 0.12);
    }

    .notification-action[data-active="true"] {
      border-color: rgba(244, 114, 182, 0.5);
      color: white;
      background: linear-gradient(135deg, rgb(147 51 234), rgb(219 39 119));
      box-shadow: 0 12px 28px rgba(192, 38, 211, 0.2);
    }

    .notification-action:disabled {
      cursor: wait;
      opacity: 0.65;
      transform: none;
    }

    .favorite-action.is-saving .favorite-action-icon {
      animation: favorite-pulse 850ms ease-in-out infinite alternate;
    }

    @keyframes favorite-pulse {
      to {
        transform: scale(0.86);
        opacity: 0.62;
      }
    }

    .aspect-video {
      aspect-ratio: 16/9;
    }
  </style>
</Layout>
