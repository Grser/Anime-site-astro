    inset: auto 0 0;
    height: 34%;
    content: '';
    pointer-events: none;
    background: linear-gradient(transparent, rgba(2, 2, 4, 0.52));
  }

  .random-trailer-poster,
  .random-trailer-media {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
  }

  .random-trailer-poster {
    object-fit: cover;
    opacity: 0.52;
    transition: opacity 180ms ease;
  }

  .random-trailer-media {
    z-index: 1;
    border: 0;
    background: #000;
    object-fit: contain;
  }

  .random-trailer-stage:has(.random-trailer-media:not([hidden])) .random-trailer-poster {
    opacity: 0.14;
  }

  .random-trailer-unavailable {
    position: absolute;
    inset: 0;
    z-index: 2;
    display: grid;
    place-items: center;
    padding: 2rem;
    color: rgba(255, 255, 255, 0.76);
    font-size: 0.875rem;
    text-align: center;
  }

  .random-sound-button {
    position: absolute;
    right: 0.85rem;
    bottom: 0.85rem;
    z-index: 3;
    min-height: 2rem;
    border: 1px solid rgba(255, 255, 255, 0.18);
    border-radius: 999px;
    padding: 0.35rem 0.7rem;
    background: rgba(8, 7, 12, 0.72);
    color: white;
    font-size: 0.72rem;
    font-weight: 700;
    backdrop-filter: blur(10px);
  }

  /* Click en el video alterna play/pause; sin controles nativos */
  .random-trailer-media[hidden] { display: none; }
  video.random-trailer-media { cursor: pointer; }

  /* Overlay central con el icono de play cuando está pausado */
  .random-play-overlay {
    position: absolute; inset: 0;
    z-index: 2;
    display: grid; place-items: center;
    border: 0;
    background: rgba(8, 6, 15, 0.45);
    color: rgba(255, 255, 255, 0.95);
    cursor: pointer;
    opacity: 0; pointer-events: none;
    transition: opacity 180ms ease;
  }
  .random-play-overlay svg {
    width: 64px; height: 64px;
    filter: drop-shadow(0 6px 16px rgba(0, 0, 0, 0.55));
    transform: translateX(2px);
  }
  .random-trailer-stage.is-paused .random-play-overlay[hidden="false"],
  .random-trailer-stage.is-paused .random-play-overlay:not([hidden]) {
    opacity: 1; pointer-events: auto;
  }

  /* Barra de progreso delgada abajo del stage */
  .random-progress {
    position: absolute; left: 0; right: 0; bottom: 0;
    z-index: 3;
    height: 3px;
    background: rgba(255, 255, 255, 0.1);
    pointer-events: none;
    opacity: 0; transition: opacity 180ms ease;
  }
  .random-trailer-stage.has-media .random-progress { opacity: 1; }
  .random-progress > span {
    display: block;
    height: 100%;
    width: 0%;
    background: linear-gradient(90deg, #a855f7, #ec4899);
    transition: width 120ms linear;
  }

  /* Alturas mínimas para que el shape del cuadro no salte entre series */
  .random-copy-title { min-height: calc(1.3em * 2); }
  .random-copy-meta  { min-height: calc(1.3em * 2); }
  .random-copy-description { min-height: calc(1.55em * 3); }

  /* Transición al cambiar de serie con "Otra opción" */
  .random-series-copy, .random-trailer-stage {
    transition: opacity 180ms ease, transform 180ms ease;
  }
  .random-series-modal.is-swapping .random-series-copy,
  .random-series-modal.is-swapping .random-trailer-stage {
    opacity: 0;
    transform: translateY(8px);
  }

  .random-series-copy {
    display: flex;
    flex-direction: column;
    gap: 1.1rem;
    padding: 1.25rem 1.4rem 1.5rem;
  }

  .random-series-copy .actions {
    display: flex;
    gap: 0.6rem;
    flex-wrap: wrap;
  }

  .random-series-copy .actions > * {
    flex: 1 1 auto;
    min-width: 150px;
  }

  @media (min-width: 640px) {
    .random-series-copy {
      flex-direction: row;
      align-items: flex-end;
      justify-content: space-between;
      padding: 1.4rem 1.6rem 1.6rem;
    }
    .random-series-copy .actions {
      flex: 0 0 auto;
      justify-content: flex-end;
    }
    .random-series-copy .actions > * {
      flex: 0 0 auto;
      min-width: 0;
