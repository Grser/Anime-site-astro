---
import Layout from '../../layouts/Layout.astro';
import db from '../../lib/db';
import { ensureCommunityTables } from '../../lib/community';
import type { RowDataPacket } from 'mysql2';

export const prerender = false;

interface Serie extends RowDataPacket {
  id: number;
  slug: string;
  titulo: string;
  banner: string;
  descripcion: string;
  clasificacion_edad: string;
  idioma: string;
  genero: string;
}

interface Temporada extends RowDataPacket {
  id: number;
  nombre_temporada: string;
  serie_id: number;
}

interface Episodio extends RowDataPacket {
  id: number;
  numero_episodio: number;
  titulo: string;
  imagen_preview: string;
  duracion: number;
  idioma: string;
  temporada_id: number;
  suscripcion_requerida: string;
}

interface LikeCount extends RowDataPacket {
  likes: number;
}

interface DislikeCount extends RowDataPacket {
  dislikes: number;
}

interface ReactionRow extends RowDataPacket {
  tipo: string;
}

interface FavoriteRow extends RowDataPacket {
  existe: number;
}

let likes = 0;
let dislikes = 0;
let userReaction: string | null = null;
let isFavorite = false;
let seriesNotificationsActive = false;
let userSubscription = 'Gratis';
const subscriptionRanks: Record<string, number> = {
  Gratis: 0,
  Super: 1,
  Estelar: 2,
};

const { slug } = Astro.params;
const usuarioId = Astro.locals.user?.id;
const perfilId = Astro.locals.user?.perfilId;

// 1) Datos de la serie
const [[serie]] = await db.query<Serie[]>(
  `SELECT * FROM series WHERE slug = ? LIMIT 1`,
  [slug]
);
if (!serie) {
  return Astro.redirect('/404');
}
const id = serie.id;

// 2) Temporadas
const [temporadas] = await db.query<Temporada[]>(
  `SELECT * FROM temporadas WHERE serie_id = ? ORDER BY numero_temporada`,
  [id]
);

// 3) Episodios de la primera temporada
let episodios: Episodio[] = [];
if (temporadas.length > 0) {
  const [eps] = await db.query<Episodio[]>(
    `SELECT * FROM episodios WHERE temporada_id = ? ORDER BY numero_episodio`,
    [temporadas[0].id]
  );
  episodios = eps;
}

// 4) Likes / Dislikes
const [[likeCount]] = await db.query<LikeCount[]>(
  `SELECT COUNT(*) AS likes FROM likes_dislikes WHERE serie_id = ? AND tipo='like'`,
  [id]
);
const [[dislikeCount]] = await db.query<DislikeCount[]>(
  `SELECT COUNT(*) AS dislikes FROM likes_dislikes WHERE serie_id = ? AND tipo='dislike'`,
  [id]
);
likes = likeCount?.likes ?? 0;
dislikes = dislikeCount?.dislikes ?? 0;

// 5) Reacción del perfil activo
if (usuarioId && perfilId) {
  await ensureCommunityTables();
  const [[reactionRow]] = await db.query<ReactionRow[]>(
    `SELECT tipo FROM likes_dislikes WHERE perfil_id = ? AND serie_id = ? LIMIT 1`,
    [perfilId, id]
  );
  userReaction = reactionRow?.tipo ?? null;

  const [[favoriteRow]] = await db.query<FavoriteRow[]>(
    `SELECT 1 AS existe FROM favoritos WHERE perfil_id = ? AND serie_id = ? LIMIT 1`,
    [perfilId, id]
  );
  isFavorite = Boolean(favoriteRow?.existe);

  const [[notificationRow]] = await db.query<{ activa: number }[]>(
    `SELECT activa FROM notificaciones_series WHERE perfil_id = ? AND serie_id = ? LIMIT 1`,
    [perfilId, id]
  );
  seriesNotificationsActive = Boolean(notificationRow?.activa);

  const [[subscriptionRow]] = await db.query<{ suscripcion: string }[]>(
    `SELECT suscripcion FROM usuarios WHERE id = ? LIMIT 1`,
    [usuarioId]
  );
  userSubscription = subscriptionRow?.suscripcion || 'Gratis';
}

const userLevel = subscriptionRanks[userSubscription] ?? 0;
const pageTitle = `${serie.titulo} | ClawnVid`;
const pageDescription =
  serie.descripcion?.trim() ||
  `Descubre ${serie.titulo} en ClawnVid y explora todos sus episodios.`;
const pageImage = serie.banner || '/avatar.jpeg';
const trailerUrl = serie.trailer_url?.trim() || '';
---

<Layout
  title={pageTitle}
  description={pageDescription}
  image={pageImage}
  type="article"
  class="bg-[#050507] text-white"
>
  <section class="relative isolate overflow-hidden bg-gradient-to-b from-black via-black/80 to-[#0b0b0f]">
    <div
      class="absolute inset-0 opacity-60"
      style={`background-image: url(${serie.banner}); background-size: cover; background-position: center; filter: blur(12px); transform: scale(1.05);`}
    />
    <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent" />

    <div class="relative mx-auto max-w-6xl px-3 py-8 sm:px-6 sm:py-16 md:py-24 space-y-6 sm:space-y-8">
      <div class="inline-flex items-center rounded-full bg-white/5 px-3 py-1 text-xs font-semibold uppercase tracking-[0.12em] text-pink-300 backdrop-blur">
        Serie destacada
      </div>

      <div class="space-y-6 md:max-w-3xl">
        <h1 class="text-3xl sm:text-4xl md:text-5xl font-extrabold leading-tight drop-shadow-lg">
          {serie.titulo}
        </h1>
        <p class="text-sm sm:text-lg text-white/80 leading-relaxed">
          {serie.descripcion}
        </p>

        <div class="flex flex-wrap items-center gap-3 text-sm text-white/80">
          <span class="rounded-full bg-pink-600/20 px-3 py-1 text-pink-200 ring-1 ring-pink-500/40">
            {serie.clasificacion_edad}
          </span>
          <span class="rounded-full bg-white/10 px-3 py-1 text-white ring-1 ring-white/15">
            {serie.idioma}
          </span>
          <span class="rounded-full bg-white/10 px-3 py-1 text-white ring-1 ring-white/15">
            {serie.genero}
          </span>
        </div>
      </div>

      <div class="flex flex-col gap-4 rounded-2xl bg-white/5 p-4 sm:p-5 shadow-xl backdrop-blur md:flex-row md:items-center md:justify-between">
        <div class="text-sm text-white/70">
          Guarda la serie, reacciona y continúa donde te quedaste.
        </div>

        <div class="flex flex-wrap items-center gap-4">
          {trailerUrl && (
            <button id="series-trailer-btn" type="button" data-trailer-url={trailerUrl} class="trailer-action">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="currentColor" aria-hidden="true"><path d="M8.2 5.1v13.8a1 1 0 0 0 1.52.85l10.93-6.9a1 1 0 0 0 0-1.7L9.72 4.25A1 1 0 0 0 8.2 5.1Z" /></svg>
              Ver tráiler
            </button>
          )}
          <button
            id="favorite-btn"
            type="button"
            data-serie-id={id}
            data-favorite={isFavorite}
            aria-pressed={isFavorite}
            class="favorite-action"
          >
            <span class="favorite-action-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8">
                <path stroke-linecap="round" stroke-linejoin="round" d="m12 20.5-1.25-1.13C6.3 15.32 3 12.34 3 8.7 3 5.72 5.36 4 8.05 4A5.1 5.1 0 0 1 12 5.88 5.1 5.1 0 0 1 15.95 4C18.64 4 21 5.72 21 8.7c0 3.64-3.3 6.62-7.75 10.68L12 20.5Z" />
              </svg>
            </span>
            <span data-favorite-label>{isFavorite ? 'Guardada en favoritos' : 'Guardar en favoritos'}</span>
          </button>

          <button
            id="series-notification-btn"
            type="button"
            data-active={seriesNotificationsActive}
            aria-pressed={seriesNotificationsActive}
            class="notification-action"
          >
            <span class="notification-action-icon" aria-hidden="true">
              <svg viewBox="0 0 24 24" class="h-5 w-5" fill="none" stroke="currentColor" stroke-width="1.8"><path stroke-linecap="round" stroke-linejoin="round" d="M15 18H9m10-3H5c1.2-1.4 2-2.7 2-6a5 5 0 0 1 10 0c0 3.3.8 4.6 2 6Zm-5 3a2 2 0 0 1-4 0" /></svg>
            </span>
            <span data-notification-label>{seriesNotificationsActive ? 'Avisos activados' : 'Avisarme de novedades'}</span>
          </button>

          <div
            id="reactions"
            data-serie-id={id}
            data-user-id={usuarioId}
            data-user-reaction={userReaction}
            class="flex items-center gap-3 rounded-xl bg-white/10 px-4 py-2 backdrop-blur"
          >
            <button
              id="btn-like"
              class={`flex items-center gap-2 rounded-lg px-2 py-1 transition-colors hover:text-green-400 ${
                userReaction === 'like' ? 'text-green-400' : 'text-white'
              }`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="h-5 w-5" fill="currentColor">
                <path d="M104 224H24c-13.3 0-24 10.7-24 24v216c0 13.3 10.7 24 24 24h80c13.3 0 24-10.7 24-24V248c0-13.3-10.7-24-24-24zm400-32h-158.6l17-81.6.5-5.6c0-7.3-3-14.3-8.2-19.4L331 64 182.8 212.2c-4.5 4.5-6.8 10.6-6.8 16.9V440c0 13.3 10.7 24 24 24h216c10.1 0 19.2-6.1 22.9-15.4l72-168c.7-1.7 1.1-3.6 1.1-5.6V216c0-13.3-10.7-24-24-24z" />
              </svg>
              <span id="count-like" class="text-sm font-semibold">{likes}</span>
            </button>

            <span class="h-5 w-px bg-white/20" aria-hidden="true" />

            <button
              id="btn-dislike"
              class={`flex items-center gap-2 rounded-lg px-2 py-1 transition-colors hover:text-red-400 ${
                userReaction === 'dislike' ? 'text-red-400' : 'text-white'
              }`}
            >
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 512 512" class="h-5 w-5" fill="currentColor">
                <path d="M313.4 479.1c26-5.2 42.9-30.5 37.7-56.5l-2.3-11.4c-5.3-26.7-15.1-52.1-28.8-75.2h144c26.5 0 48-21.5 48-48 0-18.5-10.5-34.6-25.9-42.6C497 236.6 504 223.1 504 208c0-23.4-16.8-42.9-38.9-47.1 4.4-7.3 6.9-15.8 6.9-24.9 0-21.3-13.9-39.4-33.1-45.6.7-3.3 1.1-6.8 1.1-10.4 0-26.5-21.5-48-48-48h-97.5c-19 0-37.5 5.6-53.3 16.1l-38.5 25.7C176 91.6 160 121.6 160 153.7v111.2c0 29.2 13.3 56.7 36 75l7.4 5.9c26.5 21.2 44.6 51 51.2 84.2l2.3 11.4c5.2 26 30.5 42.9 56.5 37.7zM32 384h64c17.7 0 32-14.3 32-32V128c0-17.7-14.3-32-32-32H32C14.3 96 0 110.3 0 128v224c0 17.7 14.3 32 32 32z" />
              </svg>
              <span id="count-dislike" class="text-sm font-semibold">{dislikes}</span>
            </button>
          </div>
        </div>
      </div>
    </div>
  </section>

  <div class="mx-auto max-w-6xl px-3 sm:px-6">

    <section class="py-10 space-y-6">
      <div class="flex flex-col gap-4 sm:flex-row sm:items-center sm:justify-between">
        <div>
          <h2 class="text-2xl font-bold">Temporadas</h2>
          <p class="text-white/60">Selecciona la temporada para ver sus episodios.</p>
        </div>

        <div class="rounded-xl bg-white/5 px-4 py-3 shadow-lg shadow-pink-500/10">
          <label class="block text-xs uppercase tracking-[0.2em] text-white/60">Temporada</label>
          <select
            id="temporadaSelect"
            data-slug={slug}
            class="mt-2 w-full min-w-[200px] rounded-lg border border-white/15 bg-[#0f0f17] px-3 py-2 text-sm text-white focus:border-pink-500 focus:outline-none focus:ring-2 focus:ring-pink-500/50"
          >
            {temporadas.map(t => (
              <option value={t.id}>{t.nombre_temporada}</option>
            ))}
          </select>
        </div>
      </div>

      <div class="rounded-2xl bg-white/5 p-4 shadow-xl shadow-pink-500/5">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
            <h3 class="text-xl font-semibold">Episodios</h3>
            <p class="text-sm text-white/60">Disfruta el siguiente capítulo o repite tu favorito.</p>
          </div>
          <div
            id="episodiosCount"
            class="rounded-full bg-pink-600/20 px-3 py-1 text-xs font-semibold uppercase tracking-[0.2em] text-pink-200"
          >
            {episodios.length} disponibles
          </div>
        </div>

        <div
          id="episodiosContainer"
          data-user-level={userLevel}
          data-user-auth={Boolean(usuarioId)}
          class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3 xl:grid-cols-4"
        >
          {episodios.length > 0 ? (
            episodios.map(ep => (
              (() => {
                const requiredPlan = ep.suscripcion_requerida || 'Gratis';
                const requiredLevel = subscriptionRanks[requiredPlan] ?? 0;
                const canAccess = requiredLevel === 0 || userLevel >= requiredLevel;
                const destination = canAccess
                  ? `/serie/${slug}/${ep.id}`
                  : usuarioId
                    ? '/suscripciones'
                    : '/login';
                return (
              <a
                href={destination}
                class={`group relative overflow-hidden rounded-xl border border-white/10 bg-gradient-to-b from-[#12121b] to-[#0b0b13] shadow-lg transition duration-300 ${
                  canAccess ? 'hover:-translate-y-1 hover:border-pink-500/50 hover:shadow-pink-500/20' : 'opacity-80'
                }`}
              >
                <div class="aspect-video relative">
                  <img
                    src={ep.imagen_preview || '/avatar.jpeg'}
                    alt={ep.titulo}
                    class="h-full w-full object-cover"
                    onerror="this.src='/avatar.jpeg'"
                  />
                  <div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent" />
                  <div class="absolute left-3 top-3 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white backdrop-blur">
                    {ep.idioma}
                  </div>
                  {requiredLevel > 0 && (
                    <div class="absolute right-3 top-3 rounded-full bg-purple-600/80 px-3 py-1 text-xs font-semibold text-white shadow-lg">
                      {requiredPlan}
                    </div>
                  )}
                  {!canAccess && (
                    <div class="absolute inset-0 flex items-center justify-center bg-black/70 text-sm font-semibold text-white">
                      🔒 Suscripción requerida
                    </div>
                  )}
                </div>
                <div class="space-y-2 p-3 sm:p-4">
                  <h4 class="line-clamp-2 text-sm font-semibold text-white transition-colors group-hover:text-pink-300 sm:text-lg">
                    {ep.titulo}
                  </h4>
                  <div class="flex flex-wrap items-center gap-1 text-[10px] text-white/60 sm:gap-2 sm:text-sm">
                    <span class="rounded-full bg-white/10 px-2 py-1 sm:px-3">{ep.duracion} min</span>
                    <span class="rounded-full bg-white/10 px-2 py-1 sm:px-3">Ep. {ep.numero_episodio ?? ep.id}</span>
                  </div>
                  {!canAccess && (
                    <p class="text-xs text-purple-200">
                      {usuarioId ? 'Activa tu plan para verlo.' : 'Inicia sesión para continuar.'}
                    </p>
                  )}
                </div>
              </a>
                );
              })()
            ))
          ) : (
            <p class="col-span-full text-center text-white/60">No hay episodios disponibles.</p>
          )}
        </div>
      </div>
    </section>
  </div>

  {trailerUrl && (
    <dialog id="series-trailer-modal" class="series-trailer-modal" aria-label={`Tráiler de ${serie.titulo}`}>
      <div class="relative overflow-hidden rounded-2xl bg-[#09080d]">
        <button id="series-trailer-close" type="button" class="series-trailer-close" aria-label="Cerrar tráiler">×</button>
        <div class="relative aspect-video bg-black">
          <img id="series-trailer-poster" src={serie.banner || serie.icon || '/avatar.jpeg'} alt="" class="absolute inset-0 h-full w-full object-cover opacity-40" />
          <video id="series-trailer-video" class="absolute inset-0 h-full w-full bg-black object-contain" playsinline muted controls preload="metadata" hidden></video>
          <iframe id="series-trailer-embed" class="absolute inset-0 h-full w-full border-0 bg-black" title={`Tráiler de ${serie.titulo}`} allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen hidden></iframe>
          <button id="series-trailer-sound" type="button" class="series-trailer-sound" hidden>Activar sonido</button>
        </div>
      </div>
    </dialog>
  )}

  <script client:load>
    const reactionsEl = document.getElementById('reactions');
    const serieId = Number(reactionsEl.dataset.serieId);
    let currentReaction = reactionsEl.dataset.userReaction;
    const btnLike = document.getElementById('btn-like');
    const btnDislike = document.getElementById('btn-dislike');
    const countLike = document.getElementById('count-like');
    const countDislike = document.getElementById('count-dislike');
    const favoriteBtn = document.getElementById('favorite-btn');
    const favoriteLabel = favoriteBtn?.querySelector('[data-favorite-label]');
    let isFavorite = favoriteBtn?.dataset.favorite === 'true';
    const notificationBtn = document.getElementById('series-notification-btn');
    const notificationLabel = notificationBtn?.querySelector('[data-notification-label]');
    let notificationsActive = notificationBtn?.dataset.active === 'true';
    const trailerButton = document.getElementById('series-trailer-btn');
    const trailerModal = document.getElementById('series-trailer-modal');
    const trailerVideo = document.getElementById('series-trailer-video');
    const trailerEmbed = document.getElementById('series-trailer-embed');
    const trailerSound = document.getElementById('series-trailer-sound');
    const trailerClose = document.getElementById('series-trailer-close');

    const stopTrailer = () => {
      if (trailerVideo instanceof HTMLVideoElement) {
        trailerVideo.pause();
        trailerVideo.removeAttribute('src');
        trailerVideo.load();
        trailerVideo.hidden = true;
      }
      if (trailerEmbed instanceof HTMLIFrameElement) {
        trailerEmbed.src = 'about:blank';
        trailerEmbed.hidden = true;
      }
      if (trailerSound instanceof HTMLButtonElement) trailerSound.hidden = true;
    };

    const getTrailerEmbedUrl = (source) => {
      try {
        const url = new URL(source, window.location.origin);
        const host = url.hostname.replace(/^www\./, '').toLowerCase();
        const youtubeId = host === 'youtu.be'
          ? url.pathname.split('/').filter(Boolean)[0]
          : (host === 'youtube.com' || host === 'm.youtube.com')
            ? url.searchParams.get('v') || url.pathname.match(/^\/(?:embed|shorts|live)\/([^/?]+)/)?.[1]
            : '';
        if (youtubeId) return `https://www.youtube-nocookie.com/embed/${encodeURIComponent(youtubeId)}?autoplay=1&mute=1&playsinline=1&rel=0&modestbranding=1`;

        if (host === 'vimeo.com' || host === 'player.vimeo.com') {
          const vimeoId = url.pathname.match(/\/(?:video\/)?(\d+)/)?.[1];
          if (vimeoId) return `https://player.vimeo.com/video/${vimeoId}?autoplay=1&muted=1&title=0&byline=0&portrait=0`;
        }
      } catch {
        // Los archivos directos se reproducen con el elemento de video.
      }
      return null;
    };

    trailerButton?.addEventListener('click', () => {
      if (!(trailerModal instanceof HTMLDialogElement)) return;
      const source = trailerButton.dataset.trailerUrl?.trim();
      if (!source) return;

      stopTrailer();
      if (!trailerModal.open) trailerModal.showModal();
      const embedUrl = getTrailerEmbedUrl(source);
      if (embedUrl && trailerEmbed instanceof HTMLIFrameElement) {
        trailerEmbed.src = embedUrl;
        trailerEmbed.hidden = false;
      } else if (trailerVideo instanceof HTMLVideoElement) {
        trailerVideo.src = source;
        trailerVideo.muted = true;
        trailerVideo.hidden = false;
        trailerVideo.play().catch(() => {});
        if (trailerSound instanceof HTMLButtonElement) {
          trailerSound.textContent = 'Activar sonido';
          trailerSound.hidden = false;
        }
      }
    });

    trailerClose?.addEventListener('click', () => trailerModal?.close());
    trailerModal?.addEventListener('click', event => {
      if (event.target === trailerModal) trailerModal.close();
    });
    trailerModal?.addEventListener('close', stopTrailer);
    trailerSound?.addEventListener('click', () => {
      if (!(trailerVideo instanceof HTMLVideoElement) || !(trailerSound instanceof HTMLButtonElement)) return;
      trailerVideo.muted = !trailerVideo.muted;
      trailerSound.textContent = trailerVideo.muted ? 'Activar sonido' : 'Silenciar';
    });

    const updateNotificationButton = () => {
      if (!notificationBtn) return;
      notificationBtn.dataset.active = String(notificationsActive);
      notificationBtn.setAttribute('aria-pressed', String(notificationsActive));
      if (notificationLabel) notificationLabel.textContent = notificationsActive ? 'Avisos activados' : 'Avisarme de novedades';
    };

    notificationBtn?.addEventListener('click', async () => {
      if (!(notificationBtn instanceof HTMLButtonElement)) return;
      notificationBtn.disabled = true;
      if (notificationLabel) notificationLabel.textContent = 'Actualizando...';
      try {
        const response = await fetch(`/api/notifications/series/${serieId}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ active: !notificationsActive }),
        });
        if (response.status === 401) {
          window.location.href = `/login?redirect=${encodeURIComponent(window.location.pathname)}`;
          return;
        }
        const data = await response.json();
        if (!response.ok) throw new Error(data.error || 'No se pudo cambiar la suscripción.');
        notificationsActive = Boolean(data.active);
      } catch (error) {
        console.error(error);
      } finally {
        updateNotificationButton();
        notificationBtn.disabled = false;
      }
    });

    favoriteBtn?.addEventListener('click', async () => {
      if (!favoriteBtn) return;
      if (favoriteLabel) favoriteLabel.textContent = 'Guardando...';
      favoriteBtn.classList.add('is-saving');
      favoriteBtn.setAttribute('disabled', 'true');

      try {
        const res = await fetch(`/api/favoritos/${serieId}`, {
          method: 'POST',
          credentials: 'same-origin',
          headers: {
            'Accept': 'application/json',
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({}),
        });

        if (res.status === 401) {
          window.location.href = '/login';
          return;
        }

        if (!res.ok) {
          const errorData = await res.json().catch(() => null);
          throw new Error(errorData?.error || `No se pudo actualizar (${res.status})`);
        }

        const data = await res.json();
        isFavorite = data.favorito;
        updateFavoriteButton();
      } catch (error) {
        console.error(error);
        if (favoriteLabel) favoriteLabel.textContent = 'No se pudo guardar';
        window.setTimeout(updateFavoriteButton, 1400);
      } finally {
        favoriteBtn.classList.remove('is-saving');
        favoriteBtn?.removeAttribute('disabled');
      }
    });

    function updateFavoriteButton() {
      if (!favoriteBtn) return;
      favoriteBtn.dataset.favorite = String(isFavorite);
      favoriteBtn.setAttribute('aria-pressed', String(isFavorite));
      if (favoriteLabel) {
        favoriteLabel.textContent = isFavorite ? 'Guardada en favoritos' : 'Guardar en favoritos';
      }
    }

    btnLike.addEventListener('click', () => sendReaction('like'));
    btnDislike.addEventListener('click', () => sendReaction('dislike'));

    async function sendReaction(tipo) {
      try {
        const res = await fetch(`/api/reaction/${serieId}`, {
          method: 'POST',
          credentials: 'same-origin',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ tipo })
        });
        if (!res.ok) throw new Error('Error al enviar reacción');
        const data = await res.json();
        countLike.textContent = data.likes;
        countDislike.textContent = data.dislikes;
        currentReaction = data.reaction;
        updateReactionStyles();
      } catch (err) {
        console.error(err);
      }
    }

    function updateReactionStyles() {
      btnLike.classList.toggle('text-green-400', currentReaction === 'like');
      btnLike.classList.toggle('text-white', currentReaction !== 'like');
      btnDislike.classList.toggle('text-red-400', currentReaction === 'dislike');
      btnDislike.classList.toggle('text-white', currentReaction !== 'dislike');
    }

    const temporadaSelect = document.getElementById('temporadaSelect');
    const episodiosContainer = document.getElementById('episodiosContainer');
    const episodiosCount = document.getElementById('episodiosCount');
    const slug = temporadaSelect.dataset.slug;
    const userLevel = Number(episodiosContainer.dataset.userLevel || 0);
    const isAuthed = episodiosContainer.dataset.userAuth === 'true';
    const subscriptionRanks = { Gratis: 0, Super: 1, Estelar: 2 };

    const escapeHtml = (value) =>
      String(value ?? '')
        .replace(/&/g, '&amp;')
        .replace(/</g, '&lt;')
        .replace(/>/g, '&gt;')
        .replace(/"/g, '&quot;')
        .replace(/'/g, '&#39;');

    temporadaSelect.addEventListener('change', async (e) => {
      try {
        const temporadaId = e.target.value;
        const res = await fetch(`/api/episodios/${encodeURIComponent(temporadaId)}`);
        if (!res.ok) throw new Error('Error al cargar episodios');
        const data = await res.json();
        const nuevos = Array.isArray(data) ? data : Array.isArray(data?.data) ? data.data : [];

        let html = '';
        if (nuevos.length > 0) {
          nuevos.forEach(ep => {
            const requiredPlan = ep.suscripcion_requerida || 'Gratis';
            const requiredLevel = subscriptionRanks[requiredPlan] ?? 0;
            const canAccess = requiredLevel === 0 || userLevel >= requiredLevel;
            const destination = canAccess
              ? '/serie/' + encodeURIComponent(slug) + '/' + Number(ep.id)
              : isAuthed
                ? '/suscripciones'
                : '/login';
            html +=
              '<a href="' + destination + '" class="group relative overflow-hidden rounded-xl border border-white/10 bg-gradient-to-b from-[#12121b] to-[#0b0b13] shadow-lg transition duration-300 ' + (canAccess ? 'hover:-translate-y-1 hover:border-pink-500/50 hover:shadow-pink-500/20' : 'opacity-80') + '">' +
                '<div class="aspect-video relative">' +
                  '<img src="' + escapeHtml(ep.imagen_preview || '/avatar.jpeg') + '" alt="' + escapeHtml(ep.titulo) + '" class="h-full w-full object-cover" onerror="this.src=\'/avatar.jpeg\'" />' +
                  '<div class="absolute inset-0 bg-gradient-to-t from-black/70 via-black/30 to-transparent"></div>' +
                  '<div class="absolute left-3 top-3 rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white backdrop-blur">' + escapeHtml(ep.idioma) + '</div>' +
                  (requiredLevel > 0 ? '<div class="absolute right-3 top-3 rounded-full bg-purple-600/80 px-3 py-1 text-xs font-semibold text-white shadow-lg">' + escapeHtml(requiredPlan) + '</div>' : '') +
                  (!canAccess ? '<div class="absolute inset-0 flex items-center justify-center bg-black/70 text-sm font-semibold text-white">🔒 Suscripción requerida</div>' : '') +
                '</div>' +
                '<div class="space-y-2 p-4">' +
                  '<h4 class="text-lg font-semibold text-white transition-colors group-hover:text-pink-300">' + escapeHtml(ep.titulo) + '</h4>' +
                  '<div class="flex items-center gap-2 text-sm text-white/60">' +
                    '<span class="rounded-full bg-white/10 px-3 py-1">' + (Number(ep.duracion) || 0) + ' min</span>' +
                    '<span class="h-1 w-1 rounded-full bg-white/30" aria-hidden="true"></span>' +
                    '<span>Episodio #' + escapeHtml(ep.numero_episodio ?? ep.id) + '</span>' +
                  '</div>' +
                  (!canAccess ? '<p class="text-xs text-purple-200">' + (isAuthed ? 'Activa tu plan para verlo.' : 'Inicia sesión para continuar.') + '</p>' : '') +
                '</div>' +
              '</a>';
          });
        } else {
          html = '<p class="col-span-full text-center text-white/60">No hay episodios disponibles.</p>';
        }

        episodiosContainer.innerHTML = html;
        episodiosCount.textContent = `${nuevos.length} disponibles`;
      } catch (err) {
        console.error(err);
        episodiosContainer.innerHTML = '<p class="col-span-full text-center text-red-400">Error al cargar los episodios. Por favor, intenta de nuevo.</p>';
        episodiosCount.textContent = '0 disponibles';
      }
    });
  </script>

  <style>
    .trailer-action {
      display: inline-flex;
      min-height: 3rem;
      align-items: center;
      gap: 0.6rem;
      border: 1px solid rgba(216, 180, 254, 0.26);
      border-radius: 0.9rem;
      padding: 0.65rem 1rem;
      color: rgb(243 232 255);
      background: rgba(126, 34, 206, 0.18);
      font-weight: 700;
      transition: border-color 160ms ease, background 160ms ease, transform 160ms ease;
    }

    .trailer-action:hover {
      border-color: rgba(232, 121, 249, 0.48);
      background: rgba(126, 34, 206, 0.32);
      transform: translateY(-1px);
    }

    .series-trailer-modal {
      width: min(62rem, calc(100vw - 1.25rem));
      max-width: none;
      overflow: hidden;
      border: 1px solid rgba(216, 180, 254, 0.24);
      border-radius: 1rem;
      padding: 0;
      background: #09080d;
      box-shadow: 0 28px 90px rgba(0, 0, 0, 0.75);
    }

    .series-trailer-modal::backdrop {
      background: rgba(0, 0, 0, 0.82);
      backdrop-filter: blur(8px);
    }

    .series-trailer-close {
      position: absolute;
      top: 0.7rem;
      right: 0.7rem;
      z-index: 4;
      display: grid;
      width: 2.3rem;
      height: 2.3rem;
      place-items: center;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      background: rgba(8, 7, 12, 0.72);
      color: white;
      font-size: 1.5rem;
      line-height: 1;
      backdrop-filter: blur(10px);
    }

    .series-trailer-sound {
      position: absolute;
      right: 0.8rem;
      bottom: 0.8rem;
      z-index: 3;
      min-height: 2rem;
      border: 1px solid rgba(255, 255, 255, 0.16);
      border-radius: 999px;
      padding: 0.35rem 0.7rem;
      background: rgba(8, 7, 12, 0.72);
      color: white;
      font-size: 0.72rem;
      font-weight: 700;
      backdrop-filter: blur(10px);
    }

    .favorite-action {
      display: inline-flex;
      min-height: 3rem;
      align-items: center;
      gap: 0.65rem;
      border: 1px solid rgba(244, 114, 182, 0.24);
      border-radius: 0.9rem;
      padding: 0.65rem 1rem;
      color: rgb(253 242 248);
      background: linear-gradient(135deg, rgba(219, 39, 119, 0.9), rgba(147, 51, 234, 0.9));
      box-shadow: 0 12px 28px rgba(192, 38, 211, 0.18);
      font-weight: 700;
      transition: border-color 160ms ease, box-shadow 160ms ease, opacity 160ms ease, transform 160ms ease;
    }

    .favorite-action:hover {
      border-color: rgba(249, 168, 212, 0.52);
      box-shadow: 0 14px 34px rgba(192, 38, 211, 0.28);
      transform: translateY(-1px);
    }

    .favorite-action-icon {
      display: grid;
      width: 2rem;
      height: 2rem;
      flex: 0 0 auto;
      place-items: center;
      border-radius: 0.65rem;
      background: rgba(255, 255, 255, 0.12);
    }

    .favorite-action[data-favorite="true"] {
      border-color: rgba(216, 180, 254, 0.32);
      color: rgb(243 232 255);
      background: linear-gradient(135deg, rgba(88, 28, 135, 0.94), rgba(126, 34, 206, 0.92));
    }

    .favorite-action[data-favorite="true"] svg {
      fill: currentColor;
    }

    .favorite-action:disabled {
      cursor: wait;
      opacity: 0.7;
      transform: none;
    }

    .notification-action {
      display: inline-flex;
      min-height: 3rem;
      align-items: center;
      gap: 0.65rem;
      border: 1px solid rgba(232, 121, 249, 0.22);
      border-radius: 0.9rem;
      padding: 0.65rem 1rem;
      color: rgb(243 232 255);
      background: rgba(168, 85, 247, 0.1);
      font-weight: 700;
      transition: border-color 160ms ease, background 160ms ease, opacity 160ms ease, transform 160ms ease;
    }

    .notification-action:hover {
      border-color: rgba(232, 121, 249, 0.45);
