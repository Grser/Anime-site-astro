  .hero-stage,
  .hero-stage-content,
  .carousel-track {
    min-width: 0;
    max-width: 100%;
  }

  .carousel-track {
    box-sizing: border-box;
    overscroll-behavior-inline: contain;
  }

  .continue-menu-button {
    display: grid;
    width: 2.25rem;
    height: 2.25rem;
    place-items: center;
    border: 1px solid rgba(255, 255, 255, 0.14);
    border-radius: 0.7rem;
    background: rgba(8, 6, 12, 0.78);
    color: white;
    font-size: 1.25rem;
    font-weight: 800;
    line-height: 1;
    transition: border-color 150ms ease, background 150ms ease;
  }

  .continue-menu-button:hover,
  .continue-menu-button[aria-expanded="true"] {
    border-color: rgba(232, 121, 249, 0.4);
    background: rgba(88, 28, 135, 0.88);
  }

  .continue-menu {
    position: absolute;
    right: 0;
    top: calc(100% + 0.4rem);
    width: 10.5rem;
    overflow: hidden;
    border: 1px solid rgba(216, 180, 254, 0.2);
    border-radius: 0.8rem;
    background: #110d18;
