---
import AdminLayout from '../_layout.astro';
export const prerender = false;
---
<AdminLayout>
  <div class="max-w-3xl space-y-6">
    <div>
      <p class="text-sm text-purple-200/80">Monetización</p>
      <h1 class="text-white text-3xl font-extrabold">Crear nueva suscripción</h1>
      <p class="text-gray-300 mt-1">Define un plan claro, su precio y cómo se lo presentarás al usuario.</p>
    </div>

    <form id="sub-nuevo" class="rounded-2xl border border-purple-800/40 bg-gray-900/70 p-6 space-y-5 backdrop-blur">
      <div class="grid gap-5 md:grid-cols-2">
        <label class="space-y-2 text-sm text-gray-200">
          <span class="font-semibold text-white">Nombre del plan</span>
          <input name="nombre" type="text" placeholder="Ej. Premium Anual" required class="w-full rounded-xl border border-white/10 bg-gray-800 px-4 py-3 outline-none focus:border-purple-400" />
        </label>

        <label class="space-y-2 text-sm text-gray-200">
          <span class="font-semibold text-white">Precio base en USD</span>
          <input name="precio" type="number" step="0.01" placeholder="Ej. 49.99" required class="w-full rounded-xl border border-white/10 bg-gray-800 px-4 py-3 outline-none focus:border-purple-400" />
        </label>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <label class="space-y-2 text-sm text-gray-200">
          <span class="font-semibold text-white">Perfiles por cuenta</span>
          <input name="max_perfiles" type="number" min="1" max="5" step="1" value="1" required class="w-full rounded-xl border border-white/10 bg-gray-800 px-4 py-3 outline-none focus:border-purple-400" />
          <span class="block text-xs text-gray-400">Cuántos perfiles puede crear un usuario con este plan. Entre 1 y 5.</span>
        </label>

        <label class="space-y-2 text-sm text-gray-200">
          <span class="font-semibold text-white">Período de facturación</span>
          <select name="periodo" class="w-full rounded-xl border border-white/10 bg-gray-800 px-4 py-3 outline-none focus:border-purple-400">
            <option value="mensual">Mensual (cobro cada 30 días)</option>
            <option value="anual">Anual (cobro cada 12 meses)</option>
          </select>
        </label>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <label class="space-y-2 text-sm text-gray-200">
          <span class="font-semibold text-white">Precio anual en USD (opcional)</span>
          <input name="precio_anual" type="number" step="0.01" placeholder="Dejar vacío para calcular 12x con 20% off" class="w-full rounded-xl border border-white/10 bg-gray-800 px-4 py-3 outline-none focus:border-purple-400" />
          <span class="block text-xs text-gray-400">Si se completa, el checkout anual usa este valor; si no, usa <code>precio × 12 × 0.8</code>.</span>
        </label>

        <label class="space-y-2 text-sm text-gray-200">
          <span class="font-semibold text-white">Moneda</span>
          <input type="text" value="USD base" disabled class="w-full rounded-xl border border-dashed border-white/10 bg-gray-800/60 px-4 py-3 text-gray-500" />
        </label>
      </div>

      <label class="space-y-2 text-sm text-gray-200 block">
        <span class="font-semibold text-white">Descripción</span>
        <textarea name="descripcion" rows="5" placeholder="Resume el valor del plan, por ejemplo: acceso premium completo, estrenos antes que nadie y varios dispositivos." class="w-full rounded-2xl border border-white/10 bg-gray-800 px-4 py-3 outline-none focus:border-purple-400"></textarea>
      </label>

      <div class="rounded-2xl border border-white/10 bg-white/5 p-4 text-sm text-gray-300">
        <p class="font-semibold text-white mb-2">Consejo</p>
        <p>Guarda aquí el precio base en dólares estadounidenses. Luego la web mostrará una estimación regional al usuario según su país o idioma.</p>
      </div>

      <div class="flex flex-wrap items-center gap-3">
        <button type="submit" class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-purple-600 to-blue-600 px-5 py-3 font-semibold text-white shadow-lg shadow-purple-900/40 transition hover:from-purple-500 hover:to-blue-500">
          Crear suscripción
        </button>
        <a href="/admin/suscripciones" class="inline-flex items-center justify-center rounded-full border border-white/10 px-5 py-3 text-white/80 transition hover:border-white/20 hover:text-white">
          Cancelar
        </a>
      </div>

      <p id="sub-status" class="hidden rounded-2xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm font-semibold text-emerald-300"></p>
    </form>
  </div>

  <script>
    const form = document.getElementById('sub-nuevo');
    const status = document.getElementById('sub-status');

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const res = await fetch('/api/suscripciones', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await res.json().catch(() => ({}));
      if (!res.ok) {
        status.textContent = result.error || 'No se pudo crear la suscripción.';
        status.classList.remove('hidden', 'text-emerald-300', 'border-emerald-500/20', 'bg-emerald-500/10');
        status.classList.add('text-red-300', 'border-red-500/20', 'bg-red-500/10');
        return;
      }

      status.textContent = 'Suscripción creada correctamente. Redirigiendo...';
      status.classList.remove('hidden', 'text-red-300', 'border-red-500/20', 'bg-red-500/10');
      status.classList.add('text-emerald-300', 'border-emerald-500/20', 'bg-emerald-500/10');
      setTimeout(() => {
        location.href = '/admin/suscripciones';
      }, 900);
    });
  </script>
</AdminLayout>
