---
import AdminLayout from '../../_layout.astro';
import db from '../../../../lib/db';
export const prerender = false;
const { params } = Astro;

let s = {};
try {
  const [rows] = await db.query('SELECT * FROM suscripciones WHERE id=?', [params.id]);
  s = rows[0];
} catch (e) {
  console.error(e);
}
---
<AdminLayout>
  <div class="max-w-3xl space-y-6">
    <div>
      <p class="text-sm text-purple-200/80">Monetización</p>
      <h1 class="text-white text-3xl font-extrabold">Editar suscripción</h1>
      <p class="text-gray-300 mt-1">Ajusta precio, duración y propuesta de valor del plan.</p>
    </div>

    <form id="sub-edit" data-sub-id={params.id} class="rounded-2xl border border-purple-800/40 bg-gray-900/70 p-6 space-y-5 backdrop-blur">
      <div class="grid gap-5 md:grid-cols-2">
        <label class="space-y-2 text-sm text-gray-200">
          <span class="font-semibold text-white">Nombre del plan</span>
          <input name="nombre" type="text" value={s.nombre} class="w-full rounded-xl border border-white/10 bg-gray-800 px-4 py-3 outline-none focus:border-purple-400" />
        </label>

        <label class="space-y-2 text-sm text-gray-200">
          <span class="font-semibold text-white">Precio base en USD</span>
          <input name="precio" type="number" step="0.01" value={s.precio} class="w-full rounded-xl border border-white/10 bg-gray-800 px-4 py-3 outline-none focus:border-purple-400" />
        </label>
      </div>

      <div class="grid gap-5 md:grid-cols-2">
        <label class="space-y-2 text-sm text-gray-200">
          <span class="font-semibold text-white">Perfiles por cuenta</span>
          <input name="max_perfiles" type="number" min="1" max="5" step="1" value={s.max_perfiles ?? 1} class="w-full rounded-xl border border-white/10 bg-gray-800 px-4 py-3 outline-none focus:border-purple-400" />
          <span class="block text-xs text-gray-400">Máximo de perfiles que puede crear un usuario con este plan. Mín 1, máx 5.</span>
        </label>

        <label class="space-y-2 text-sm text-gray-200">
          <span class="font-semibold text-white">Moneda</span>
          <input type="text" value="USD base" disabled class="w-full rounded-xl border border-dashed border-white/10 bg-gray-800/60 px-4 py-3 text-gray-500" />
        </label>
      </div>

      <label class="space-y-2 text-sm text-gray-200 block">
        <span class="font-semibold text-white">Descripción</span>
        <textarea name="descripcion" rows="5" class="w-full rounded-2xl border border-white/10 bg-gray-800 px-4 py-3 outline-none focus:border-purple-400">{s.descripcion}</textarea>
      </label>

      <div class="flex flex-wrap items-center gap-3">
        <button type="submit" class="inline-flex items-center justify-center rounded-full bg-gradient-to-r from-purple-600 to-blue-600 px-5 py-3 font-semibold text-white shadow-lg shadow-purple-900/40 transition hover:from-purple-500 hover:to-blue-500">
          Guardar cambios
        </button>
        <a href="/admin/suscripciones" class="inline-flex items-center justify-center rounded-full border border-white/10 px-5 py-3 text-white/80 transition hover:border-white/20 hover:text-white">
          Volver
        </a>
      </div>

      <p id="sub-status" class="hidden rounded-2xl border border-emerald-500/20 bg-emerald-500/10 px-4 py-3 text-sm font-semibold text-emerald-300"></p>
    </form>
  </div>
  <script>
    const form = document.getElementById('sub-edit');
    const status = document.getElementById('sub-status');
    const subId = Number(form?.dataset.subId || 0);

    form?.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const res = await fetch(`/api/suscripciones/${subId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data),
      });

      const result = await res.json().catch(() => ({}));
      if (!res.ok) {
        status.textContent = result.error || 'No se pudieron guardar los cambios.';
        status.classList.remove('hidden', 'text-emerald-300', 'border-emerald-500/20', 'bg-emerald-500/10');
        status.classList.add('text-red-300', 'border-red-500/20', 'bg-red-500/10');
        return;
      }

      status.textContent = 'Cambios guardados correctamente.';
      status.classList.remove('hidden', 'text-red-300', 'border-red-500/20', 'bg-red-500/10');
      status.classList.add('text-emerald-300', 'border-emerald-500/20', 'bg-emerald-500/10');
      setTimeout(() => {
        location.href = '/admin/suscripciones';
      }, 900);
    });
  </script>
</AdminLayout>
