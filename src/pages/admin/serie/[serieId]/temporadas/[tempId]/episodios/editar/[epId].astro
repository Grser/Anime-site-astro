---
import AdminLayout from '../../../../../../_layout.astro';
import db from '../../../../../../../../lib/db';
export const prerender = false;
const { params } = Astro;

let ep = {};
try {
  const [rows] = await db.query(
    'SELECT * FROM episodios WHERE id = ?',
    [params.epId]
  );
  ep = rows[0] || {};
} catch (e) {
  console.error(e);
}

// Helper para formatear la fecha (puede venir como Date o como string)
const formatDate = (d) => {
  const dt = d instanceof Date ? d : new Date(d);
  return isNaN(dt) ? '' : dt.toISOString().slice(0, 10);
};

// Segundos → "mm:ss" (o "h:mm:ss" si pasan de 60 min). Vacío si es null/0 "no definido".
const formatSeconds = (secs) => {
  const n = Number(secs);
  if (!Number.isFinite(n) || n < 0 || secs === null || secs === undefined) return '';
  const h = Math.floor(n / 3600);
  const m = Math.floor((n % 3600) / 60);
  const s = n % 60;
  const pad = (v) => String(v).padStart(2, '0');
  return h > 0 ? `${h}:${pad(m)}:${pad(s)}` : `${m}:${pad(s)}`;
};
---

<AdminLayout>
  <h1 class="text-white text-3xl font-bold mb-6">
    Editar Episodio #{ep.numero_episodio}
  </h1>

  <form
    id="ep-editar"
    class="bg-gray-800 p-6 rounded-lg space-y-4"
    data-ep-id={params.epId}
    data-serie-id={params.serieId}
    data-temp-id={params.tempId}
  >
    <input
      name="numero_episodio"
      type="number"
      value={ep.numero_episodio}
      required
      class="w-full p-2 bg-gray-700 rounded"
    />
    <input
      name="titulo"
      type="text"
      value={ep.titulo}
      required
      class="w-full p-2 bg-gray-700 rounded"
    />
    <textarea
      name="descripcion"
      class="w-full p-2 bg-gray-700 rounded"
    >{ep.descripcion}</textarea>
    <input
      name="duracion"
      type="number"
      value={ep.duracion}
      class="w-full p-2 bg-gray-700 rounded"
    />
    <input
      name="video_url"
      type="url"
      value={ep.video_url}
      class="w-full p-2 bg-gray-700 rounded"
    />
    <input
      name="fecha_estreno"
      type="date"
      value={formatDate(ep.fecha_estreno)}
      class="w-full p-2 bg-gray-700 rounded"
    />
    <input
      name="idioma"
      type="text"
      value={ep.idioma}
      class="w-full p-2 bg-gray-700 rounded"
    />
    <input
      name="imagen_preview"
      type="url"
      value={ep.imagen_preview}
      class="w-full p-2 bg-gray-700 rounded"
    />
    <select
      name="suscripcion_requerida"
      class="w-full p-2 bg-gray-700 rounded"
    >
      <option value="Gratis" selected={ep.suscripcion_requerida === 'Gratis'}>
        Gratis
      </option>
      <option value="Super" selected={ep.suscripcion_requerida === 'Super'}>
        Super
      </option>
      <option value="Estelar" selected={ep.suscripcion_requerida === 'Estelar'}>
        Estelar
      </option>
    </select>

    <fieldset class="border border-purple-800/40 rounded-lg p-4 space-y-3">
      <legend class="px-2 text-purple-200 font-semibold text-sm">Saltar intro / outro (opcional)</legend>
      <p class="text-xs text-gray-400">Formato: <code>mm:ss</code> o segundos. Deja en blanco para desactivar.</p>
      <div class="grid grid-cols-2 gap-3">
        <label class="text-xs text-gray-300">
          Intro inicio
          <input name="intro_start" type="text" placeholder="1:30" value={formatSeconds(ep.intro_start_seconds)} class="mt-1 w-full p-2 bg-gray-700 rounded" />
        </label>
        <label class="text-xs text-gray-300">
          Intro fin
          <input name="intro_end" type="text" placeholder="3:00" value={formatSeconds(ep.intro_end_seconds)} class="mt-1 w-full p-2 bg-gray-700 rounded" />
        </label>
        <label class="text-xs text-gray-300">
          Outro inicio
          <input name="outro_start" type="text" placeholder="22:30" value={formatSeconds(ep.outro_start_seconds)} class="mt-1 w-full p-2 bg-gray-700 rounded" />
        </label>
        <label class="text-xs text-gray-300">
          Outro fin
          <input name="outro_end" type="text" placeholder="24:00" value={formatSeconds(ep.outro_end_seconds)} class="mt-1 w-full p-2 bg-gray-700 rounded" />
        </label>
      </div>
    </fieldset>

    <button
      type="submit"
      class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded"
    >
      Guardar Episodio
    </button>
  </form>

  <script client:load>
    const form = document.getElementById('ep-editar');
    const epId    = form.dataset.epId;
    const serieId = form.dataset.serieId;
    const tempId  = form.dataset.tempId;

    // Mismo parser que /nuevo: "mm:ss", "h:mm:ss" o segundos; null si vacío/inválido.
    const parseTimeInput = (raw) => {
      const s = String(raw ?? '').trim();
      if (!s) return null;
      if (/^\d+$/.test(s)) return Number(s);
      const parts = s.split(':').map(p => p.trim());
      if (!parts.every(p => /^\d+$/.test(p))) return null;
      const nums = parts.map(Number);
      if (nums.length === 2) return nums[0] * 60 + nums[1];
      if (nums.length === 3) return nums[0] * 3600 + nums[1] * 60 + nums[2];
      return null;
    };

    form.addEventListener('submit', async e => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      data.intro_start_seconds = parseTimeInput(data.intro_start);
      data.intro_end_seconds   = parseTimeInput(data.intro_end);
      data.outro_start_seconds = parseTimeInput(data.outro_start);
      data.outro_end_seconds   = parseTimeInput(data.outro_end);
      delete data.intro_start; delete data.intro_end;
      delete data.outro_start; delete data.outro_end;

      const res = await fetch(`/api/episodios/${epId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) {
        location.href = `/admin/serie/${serieId}/temporadas/${tempId}/episodios`;
      } else {
        alert('Error al guardar el episodio.');
      }
    });
  </script>
</AdminLayout>
