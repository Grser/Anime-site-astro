<script>
  document.addEventListener('DOMContentLoaded', () => {
    const randomSeriesButton = document.querySelector('[data-random-series]');
    const randomSeriesModal = document.getElementById('random-series-modal');
    const randomSeriesDataEl = document.getElementById('random-series-data');
    const randomTrailerVideo = document.getElementById('random-trailer-video');
    const randomTrailerEmbed = document.getElementById('random-trailer-embed');
    const randomTrailerPoster = document.getElementById('random-trailer-poster');
    const randomTrailerUnavailable = document.getElementById('random-trailer-unavailable');
    const randomTrailerSound = document.getElementById('random-trailer-sound');
    const randomTrailerPlay = document.getElementById('random-trailer-play');
    const randomTrailerProgress = document.getElementById('random-trailer-progress')?.querySelector('span') || null;
    const randomTrailerStage = document.querySelector('.random-trailer-stage');
    const randomSeriesTitle = document.getElementById('random-series-title');
    const randomSeriesMeta = document.getElementById('random-series-meta');
    const randomSeriesDescription = document.getElementById('random-series-description');
    const randomSeriesLink = document.getElementById('random-series-link');
    const randomAgainButton = document.querySelector('[data-random-again]');
    const randomCloseButton = document.querySelector('[data-random-close]');
    let randomSeries = [];
    let lastRandomId = null;

    try {
      const parsed = JSON.parse(randomSeriesDataEl?.textContent || '[]');
      randomSeries = Array.isArray(parsed) ? parsed : [];
    } catch (error) {
      console.error('No se pudieron leer las series aleatorias:', error);
    }

    const resetRandomTrailer = () => {
      if (randomTrailerVideo instanceof HTMLVideoElement) {
        randomTrailerVideo.pause();
        randomTrailerVideo.removeAttribute('src');
        randomTrailerVideo.load();
        randomTrailerVideo.hidden = true;
      }
      if (randomTrailerEmbed instanceof HTMLIFrameElement) {
        randomTrailerEmbed.src = 'about:blank';
        randomTrailerEmbed.hidden = true;
      }
      if (randomTrailerUnavailable instanceof HTMLElement) randomTrailerUnavailable.hidden = true;
      if (randomTrailerSound instanceof HTMLButtonElement) randomTrailerSound.hidden = true;
      if (randomTrailerPlay instanceof HTMLButtonElement) randomTrailerPlay.hidden = true;
      if (randomTrailerStage instanceof HTMLElement) {
        randomTrailerStage.classList.remove('has-media', 'is-paused');
      }
      if (randomTrailerProgress) randomTrailerProgress.style.width = '0%';
    };

    const trailerEmbedUrl = source => {
      try {
        if (typeof source === 'string' && source.startsWith('/')) return null;
        const url = new URL(source, window.location.origin);
        const host = url.hostname.replace(/^www\./, '').toLowerCase();

        // YouTube
        if (host === 'youtu.be' || host.endsWith('youtube.com') || host.endsWith('youtube-nocookie.com')) {
          let id = '';
          if (host === 'youtu.be') id = url.pathname.split('/').filter(Boolean)[0] || '';
          else {
            id = url.searchParams.get('v') || '';
            if (!id) id = url.pathname.match(/^\/(?:embed|shorts|live|v)\/([^/?]+)/)?.[1] || '';
          }
          if (id) return `https://www.youtube-nocookie.com/embed/${encodeURIComponent(id)}?autoplay=1&mute=1&playsinline=1&rel=0&modestbranding=1`;
        }

        // Vimeo
        if (host === 'vimeo.com' || host === 'player.vimeo.com') {
          const id = url.pathname.match(/\/(?:video\/)?(\d+)/)?.[1];
          if (id) return `https://player.vimeo.com/video/${id}?autoplay=1&muted=1&title=0&byline=0&portrait=0`;
        }

        // Dailymotion
        if (host === 'dailymotion.com' || host === 'dai.ly') {
          let id = '';
          if (host === 'dai.ly') id = url.pathname.split('/').filter(Boolean)[0] || '';
          else id = url.pathname.match(/^\/(?:video|embed\/video)\/([^/?]+)/)?.[1] || '';
          if (id) return `https://www.dailymotion.com/embed/video/${encodeURIComponent(id)}?autoplay=1&mute=1`;
        }

        // archive.org
        if (host === 'archive.org') {
          const m = url.pathname.match(/^\/details\/([^/?]+)/);
          if (m) return `https://archive.org/embed/${encodeURIComponent(m[1])}?autoplay=1`;
          if (url.pathname.startsWith('/embed/')) return source;
        }

        // Google Drive: NO retornamos iframe aquí. El iframe /preview trae el
        // player de Drive con su marca y menú de descarga; en vez de eso
        // dejamos que caiga al <video> nuestro con la URL proxyeada.
      } catch {
        // Los enlaces directos de video se reproducen con el elemento <video>.
      }
      return null;
    };

    // Para hosts donde el <video> necesita un stream resuelto por el server
    // (Google Drive hoy), convertimos a la ruta del proxy; el resto se usa tal cual.
    const trailerVideoUrl = source => {
      try {
        const url = new URL(source, window.location.origin);
        const host = url.hostname.replace(/^www\./, '').toLowerCase();
        if (host === 'drive.google.com' || host === 'drive.usercontent.google.com' || host === 'docs.google.com') {
          return `/api/proxy/trailer?src=${encodeURIComponent(source)}`;
        }
      } catch { /* path relativo o inválido, usamos el valor crudo */ }
      return source;
    };

    const playRandomTrailer = serie => {
      resetRandomTrailer();
      const source = typeof serie.trailer_url === 'string' ? serie.trailer_url.trim() : '';
      if (!source) {
        if (randomTrailerUnavailable instanceof HTMLElement) randomTrailerUnavailable.hidden = false;
        return;
      }

      const embedUrl = trailerEmbedUrl(source);
      if (embedUrl && randomTrailerEmbed instanceof HTMLIFrameElement) {
        randomTrailerEmbed.src = embedUrl;
        randomTrailerEmbed.hidden = false;
        return;
      }

      if (randomTrailerVideo instanceof HTMLVideoElement) {
        randomTrailerVideo.src = trailerVideoUrl(source);
        randomTrailerVideo.muted = true;
        randomTrailerVideo.hidden = false;
        if (randomTrailerStage instanceof HTMLElement) randomTrailerStage.classList.add('has-media');
        randomTrailerVideo.play().catch(() => {
          // El usuario puede iniciarlo manualmente si su navegador bloquea el autoplay.
        });
        if (randomTrailerSound instanceof HTMLButtonElement) {
          randomTrailerSound.textContent = 'Activar sonido';
          randomTrailerSound.hidden = false;
        }
      }
    };

    const openRandomSeries = () => {
      if (!(randomSeriesModal instanceof HTMLDialogElement) || randomSeries.length === 0) return;

      const withTrailer = randomSeries.filter(serie => typeof serie.trailer_url === 'string' && serie.trailer_url.trim());
      const candidates = withTrailer.length > 0 ? withTrailer : randomSeries;
      const alternatives = candidates.filter(serie => serie.id !== lastRandomId);
      const source = alternatives.length > 0 ? alternatives : candidates;
      const serie = source[Math.floor(Math.random() * source.length)];
      if (!serie) return;

      lastRandomId = serie.id;
      if (randomTrailerPoster instanceof HTMLImageElement) {
        randomTrailerPoster.src = serie.banner || serie.icon || '/avatar.jpeg';
        randomTrailerPoster.alt = `Portada de ${serie.titulo || 'serie aleatoria'}`;
      }
      if (randomSeriesTitle) randomSeriesTitle.textContent = serie.titulo || 'Selección aleatoria';
      if (randomSeriesDescription) randomSeriesDescription.textContent = serie.descripcion || 'Descubre una nueva serie del catálogo.';
      if (randomSeriesMeta) {
        const seasons = Number.isFinite(Number(serie.temporada_count)) ? `${serie.temporada_count} temporadas` : '';
        const episodes = Number.isFinite(Number(serie.episodio_count)) ? `${serie.episodio_count} episodios` : '';
        randomSeriesMeta.textContent = [serie.genero, seasons, episodes].filter(Boolean).join(' · ');
      }
      if (randomSeriesLink instanceof HTMLAnchorElement) randomSeriesLink.href = `/serie/${serie.slug}`;

      if (!randomSeriesModal.open) randomSeriesModal.showModal();
      playRandomTrailer(serie);
    };

    randomSeriesButton?.addEventListener('click', openRandomSeries);

    // "Otra opción": fade out, swap, fade in. 180ms matchea la transición CSS.
    randomAgainButton?.addEventListener('click', () => {
      if (!randomSeriesModal) { openRandomSeries(); return; }
      randomSeriesModal.classList.add('is-swapping');
      setTimeout(() => {
        openRandomSeries();
        requestAnimationFrame(() => randomSeriesModal.classList.remove('is-swapping'));
      }, 180);
    });

    randomCloseButton?.addEventListener('click', () => randomSeriesModal?.close());
    randomSeriesModal?.addEventListener('click', event => {
      if (event.target === randomSeriesModal) randomSeriesModal.close();
    });
    randomSeriesModal?.addEventListener('close', () => {
      resetRandomTrailer();
      randomSeriesModal.classList.remove('is-swapping');
    });
    randomTrailerVideo?.addEventListener('error', () => {
      randomTrailerVideo.hidden = true;
      if (randomTrailerSound instanceof HTMLButtonElement) randomTrailerSound.hidden = true;
      if (randomTrailerUnavailable instanceof HTMLElement) randomTrailerUnavailable.hidden = false;
    });
    randomTrailerSound?.addEventListener('click', () => {
      if (!(randomTrailerVideo instanceof HTMLVideoElement) || !(randomTrailerSound instanceof HTMLButtonElement)) return;
      randomTrailerVideo.muted = !randomTrailerVideo.muted;
      randomTrailerSound.textContent = randomTrailerVideo.muted ? 'Activar sonido' : 'Silenciar';
    });

    // Reemplazo de los controles nativos: click en el video = toggle play/pause,
    // play overlay central cuando está pausado, barra de progreso propia.
    const togglePlay = () => {
      if (!(randomTrailerVideo instanceof HTMLVideoElement)) return;
      if (randomTrailerVideo.paused) randomTrailerVideo.play().catch(() => {});
      else randomTrailerVideo.pause();
    };
    randomTrailerVideo?.addEventListener('click', togglePlay);
    randomTrailerPlay?.addEventListener('click', togglePlay);
    randomTrailerVideo?.addEventListener('play', () => {
      if (randomTrailerStage instanceof HTMLElement) randomTrailerStage.classList.remove('is-paused');
      if (randomTrailerPlay instanceof HTMLButtonElement) randomTrailerPlay.hidden = true;
    });
    randomTrailerVideo?.addEventListener('pause', () => {
      if (randomTrailerStage instanceof HTMLElement) randomTrailerStage.classList.add('is-paused');
      if (randomTrailerPlay instanceof HTMLButtonElement) randomTrailerPlay.hidden = false;
    });
    randomTrailerVideo?.addEventListener('timeupdate', () => {
      if (!(randomTrailerVideo instanceof HTMLVideoElement) || !randomTrailerProgress) return;
      const dur = randomTrailerVideo.duration;
      if (!Number.isFinite(dur) || dur <= 0) return;
      const pct = Math.max(0, Math.min(100, (randomTrailerVideo.currentTime / dur) * 100));
      randomTrailerProgress.style.width = pct.toFixed(2) + '%';
    });
    randomTrailerVideo?.addEventListener('ended', () => {
      if (randomTrailerProgress) randomTrailerProgress.style.width = '100%';
    });

    const continueMenuButtons = Array.from(document.querySelectorAll('[data-continue-menu-button]'));
    const closeContinueMenus = (except = null) => {
      continueMenuButtons.forEach(button => {
        if (button === except) return;
        button.setAttribute('aria-expanded', 'false');
        button.parentElement?.querySelector('[data-continue-menu]')?.classList.add('hidden');
      });
    };

    continueMenuButtons.forEach(button => {
      button.addEventListener('click', event => {
        event.stopPropagation();
        const menu = button.parentElement?.querySelector('[data-continue-menu]');
        if (!menu) return;
        const shouldOpen = menu.classList.contains('hidden');
        closeContinueMenus(button);
        menu.classList.toggle('hidden', !shouldOpen);
        button.setAttribute('aria-expanded', String(shouldOpen));
      });
    });

    document.querySelectorAll('[data-mark-watched]').forEach(button => {
      button.addEventListener('click', async event => {
        event.stopPropagation();
        if (!(button instanceof HTMLButtonElement)) return;
        const episodeId = Number(button.dataset.episodeId);
        const card = button.closest('[data-continue-card]');
        button.disabled = true;
        button.textContent = 'Marcando…';

        try {
          const response = await fetch('/api/player/mark-watched', {
            method: 'POST',
            credentials: 'same-origin',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ episodeId }),
          });
          const data = await response.json();
          if (!response.ok) throw new Error(data.error || 'No se pudo actualizar.');
          card?.remove();
          const grid = document.querySelector('[data-continue-grid]');
          if (grid && !grid.querySelector('[data-continue-card]')) {
            document.querySelector('[data-continue-section]')?.classList.add('hidden');
          }
        } catch (error) {
          console.error(error);
          button.disabled = false;
          button.textContent = 'Inténtalo de nuevo';
        }
      });
    });

    document.addEventListener('click', () => closeContinueMenus());
    document.addEventListener('keydown', event => {
      if (event.key === 'Escape') closeContinueMenus();
    });

    const heroRoot = document.querySelector('[data-hero-root]');
    const heroDataEl = document.getElementById('hero-data');

    let heroData = [];

    try {
      heroData = JSON.parse(heroDataEl?.textContent || '[]');
    } catch (error) {
      console.error('Error leyendo destacados del hero:', error);
    }

    if (heroRoot && heroData.length) {
      const bannerEl = heroRoot.querySelector('[data-hero-banner]');
      const titleEl = heroRoot.querySelector('[data-hero-title]');
      const descriptionEl = heroRoot.querySelector('[data-hero-description]');
      const genreEl = heroRoot.querySelector('[data-hero-genre]');
      const seasonsEl = heroRoot.querySelector('[data-hero-seasons-text]');
      const episodesEl = heroRoot.querySelector('[data-hero-episodes-text]');
      const languageEl = heroRoot.querySelector('[data-hero-language]');
      const languageText = heroRoot.querySelector('[data-hero-language-text]');
      const ctaLink = heroRoot.querySelector('[data-hero-link]');
      const thumbTrack = heroRoot.querySelector('[data-hero-thumbs]');
      const thumbs = Array.from(heroRoot.querySelectorAll('[data-hero-thumb]'));
      const prevHero = heroRoot.querySelector('[data-hero-prev]');
      const nextHero = heroRoot.querySelector('[data-hero-next]');

      let heroIndex = 0;
      let heroTimer;
      let heroInView = false;

      const truncate = text => {
        if (!text) return '';
        return text.length > 200 ? `${text.slice(0, 200)}…` : text;
      };

      const highlightThumb = idx => {
        thumbs.forEach(thumb => {
          const thumbIndex = Number(thumb.dataset.heroThumb);
          const isActive = thumbIndex === idx;
          thumb.classList.toggle('is-active', isActive);
        });

        const activeThumb = thumbs.find(thumb => Number(thumb.dataset.heroThumb) === idx);

        if (activeThumb && thumbTrack) {
          const thumbRect = activeThumb.getBoundingClientRect();
          const trackRect = thumbTrack.getBoundingClientRect();

          if (thumbRect.left < trackRect.left || thumbRect.right > trackRect.right) {
            const targetLeft = activeThumb.offsetLeft - Math.max(0, (thumbTrack.clientWidth - activeThumb.clientWidth) / 2);
            thumbTrack.scrollTo({ left: Math.max(0, targetLeft), behavior: 'smooth' });
          }
        }
      };

      const renderHero = idx => {
        const hero = heroData[idx];
        if (!hero) return;

        heroIndex = idx;

        if (bannerEl && hero.banner) {
          bannerEl.src = hero.banner;
          bannerEl.alt = hero.titulo || 'Serie destacada';
        }

        if (titleEl) {
          titleEl.textContent = hero.titulo || 'Destacado';
        }

        if (descriptionEl) {
          descriptionEl.textContent = truncate(hero.descripcion);
        }

        if (genreEl) {
          genreEl.textContent = hero.genero || '';
          genreEl.classList.toggle('hidden', !hero.genero);
        }

        if (seasonsEl) {
          seasonsEl.textContent = `${hero.temporada_count ?? '–'} Temporadas`;
        }

        if (episodesEl) {
          episodesEl.textContent = `${hero.episodio_count ?? '–'} Episodios`;
        }

        if (languageEl && languageText) {
          const hasLanguage = Boolean(hero.idioma);
          languageEl.classList.toggle('hidden', !hasLanguage);
          languageText.textContent = hasLanguage ? `Idioma ${hero.idioma}` : '';
        }

        if (ctaLink && hero.slug) {
          ctaLink.href = `/serie/${hero.slug}`;
        }

        highlightThumb(idx);
      };

      const goNext = () => {
        renderHero((heroIndex + 1) % heroData.length);
      };

      const goPrev = () => {
        renderHero((heroIndex - 1 + heroData.length) % heroData.length);
      };

      const stopAuto = () => {
        if (heroTimer) {
          clearInterval(heroTimer);
          heroTimer = undefined;
        }
      };

      const startAuto = () => {
        stopAuto();
        if (heroData.length <= 1 || !heroInView || document.hidden) return;
        heroTimer = setInterval(goNext, 7000);
      };

      prevHero?.addEventListener('click', () => {
        goPrev();
        startAuto();
      });

      nextHero?.addEventListener('click', () => {
        goNext();
        startAuto();
      });

      thumbs.forEach(thumb => {
        thumb.addEventListener('click', event => {
          if (event.metaKey || event.ctrlKey || event.button !== 0) return;

          event.preventDefault();
          const thumbIndex = Number(thumb.dataset.heroThumb);

          if (!Number.isNaN(thumbIndex)) {
            renderHero(thumbIndex);
            startAuto();
          }
        });
      });

      heroRoot.addEventListener('mouseenter', stopAuto);
      heroRoot.addEventListener('mouseleave', startAuto);

      const heroVisibilityObserver = new IntersectionObserver(
        ([entry]) => {
          heroInView = Boolean(entry?.isIntersecting);
          if (heroInView) {
            startAuto();
          } else {
            stopAuto();
          }
        },
        { threshold: 0.08 },
      );

      heroVisibilityObserver.observe(heroRoot);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stopAuto();
        } else {
          startAuto();
        }
      });

      renderHero(0);
    }

    const carousels = document.querySelectorAll('[data-carousel]');

    carousels.forEach(carousel => {
      const track = carousel.querySelector('[data-carousel-track]');
      const cards = Array.from(carousel.querySelectorAll('[data-carousel-card]'));

      if (!track || !cards.length) return;

      const prev = carousel.querySelector('[data-carousel-prev]');
      const next = carousel.querySelector('[data-carousel-next]');

      let autoTimer;
      let currentIndex = 0;
      let carouselInView = false;

      const getMaxScroll = () => Math.max(0, track.scrollWidth - track.clientWidth);

      const updateButtons = () => {
        const maxScroll = getMaxScroll();
        const atStart = track.scrollLeft <= 1;
        const atEnd = track.scrollLeft + track.clientWidth >= maxScroll - 1;

        prev?.toggleAttribute('disabled', atStart);
        next?.toggleAttribute('disabled', atEnd);
      };

      const scrollToIndex = index => {
        currentIndex = ((index % cards.length) + cards.length) % cards.length;
        const target = cards[currentIndex];
        if (!target) return;

        const targetLeft = target.offsetLeft - Math.max(0, (track.clientWidth - target.clientWidth) / 2);
        track.scrollTo({ left: Math.max(0, targetLeft), behavior: 'smooth' });
        requestAnimationFrame(updateButtons);
      };

      const goNext = () => {
        scrollToIndex(currentIndex + 1);
      };

      const goPrev = () => {
        scrollToIndex(currentIndex - 1);
      };

      const stopAuto = () => {
        if (autoTimer) {
          clearInterval(autoTimer);
          autoTimer = undefined;
        }
      };

      const startAuto = () => {
        stopAuto();
        if (cards.length <= 1 || !carouselInView || document.hidden) return;
        autoTimer = setInterval(goNext, 5000);
      };

      prev?.addEventListener('click', () => {
        goPrev();
        startAuto();
      });

      next?.addEventListener('click', () => {
        goNext();
        startAuto();
      });

      track.addEventListener(
        'scroll',
        () => {
          let closestIndex = 0;
          let closestDistance = Number.POSITIVE_INFINITY;
          const trackCenter = track.scrollLeft + track.clientWidth / 2;

          cards.forEach((card, index) => {
            const cardCenter = card.offsetLeft + card.clientWidth / 2;
            const distance = Math.abs(trackCenter - cardCenter);
            if (distance < closestDistance) {
              closestDistance = distance;
              closestIndex = index;
            }
          });

          currentIndex = closestIndex;
          updateButtons();
        },
        { passive: true },
      );
      window.addEventListener('resize', updateButtons);

      carousel.addEventListener('mouseenter', stopAuto);
      carousel.addEventListener('mouseleave', startAuto);

      const observer = new IntersectionObserver(
        entries => {
          entries.forEach(entry => {
            const card = entry.target;

            if (entry.intersectionRatio > 0.75) {
              card.classList.add('is-active');
              card.classList.remove('is-near');
            } else if (entry.intersectionRatio > 0.45) {
              card.classList.add('is-near');
              card.classList.remove('is-active');
            } else {
              card.classList.remove('is-active');
              card.classList.remove('is-near');
            }
          });
        },
        {
          root: track,
          threshold: [0.45, 0.75],
        }
      );

      cards.forEach(card => observer.observe(card));

      const playbackObserver = new IntersectionObserver(
        ([entry]) => {
          carouselInView = Boolean(entry?.isIntersecting);
          if (carouselInView) {
            startAuto();
          } else {
            stopAuto();
          }
        },
        { threshold: 0.08 },
      );

      playbackObserver.observe(carousel);
      document.addEventListener('visibilitychange', () => {
        if (document.hidden) {
          stopAuto();
        } else {
          startAuto();
        }
      });

      updateButtons();
      scrollToIndex(0);
    });
  });

</script>
