---
import AdminLayout from '../../../../../../_layout.astro';
import db from '../../../../../../../../lib/db';
export const prerender = false;
const { params } = Astro;

let ep = {};
try {
  const [rows] = await db.query(
    'SELECT * FROM episodios WHERE id = ?',
    [params.epId]
  );
  ep = rows[0] || {};
} catch (e) {
  console.error(e);
}

// Helper para formatear la fecha (puede venir como Date o como string)
const formatDate = (d) => {
  const dt = d instanceof Date ? d : new Date(d);
  return isNaN(dt) ? '' : dt.toISOString().slice(0, 10);
};
---

<AdminLayout>
  <h1 class="text-white text-3xl font-bold mb-6">
    Editar Episodio #{ep.numero_episodio}
  </h1>

  <form
    id="ep-editar"
    class="bg-gray-800 p-6 rounded-lg space-y-4"
    data-ep-id={params.epId}
    data-serie-id={params.serieId}
    data-temp-id={params.tempId}
  >
    <input
      name="numero_episodio"
      type="number"
      value={ep.numero_episodio}
      required
      class="w-full p-2 bg-gray-700 rounded"
    />
    <input
      name="titulo"
      type="text"
      value={ep.titulo}
      required
      class="w-full p-2 bg-gray-700 rounded"
    />
    <textarea
      name="descripcion"
      class="w-full p-2 bg-gray-700 rounded"
    >{ep.descripcion}</textarea>
    <input
      name="duracion"
      type="number"
      value={ep.duracion}
      class="w-full p-2 bg-gray-700 rounded"
    />
    <input
      name="video_url"
      type="url"
      value={ep.video_url}
      class="w-full p-2 bg-gray-700 rounded"
    />
    <input
      name="fecha_estreno"
      type="date"
      value={formatDate(ep.fecha_estreno)}
      class="w-full p-2 bg-gray-700 rounded"
    />
    <input
      name="idioma"
      type="text"
      value={ep.idioma}
      class="w-full p-2 bg-gray-700 rounded"
    />
    <input
      name="imagen_preview"
      type="url"
      value={ep.imagen_preview}
      class="w-full p-2 bg-gray-700 rounded"
    />
    <select
      name="suscripcion_requerida"
      class="w-full p-2 bg-gray-700 rounded"
    >
      <option value="Gratis" selected={ep.suscripcion_requerida === 'Gratis'}>
        Gratis
      </option>
      <option value="Super" selected={ep.suscripcion_requerida === 'Super'}>
        Super
      </option>
      <option value="Estelar" selected={ep.suscripcion_requerida === 'Estelar'}>
        Estelar
      </option>
    </select>

    <button
      type="submit"
      class="bg-blue-500 hover:bg-blue-600 text-white px-4 py-2 rounded"
    >
      Guardar Episodio
    </button>
  </form>

  <script client:load>
    const form = document.getElementById('ep-editar');
    const epId    = form.dataset.epId;
    const serieId = form.dataset.serieId;
    const tempId  = form.dataset.tempId;

    form.addEventListener('submit', async e => {
      e.preventDefault();
      const data = Object.fromEntries(new FormData(form));
      const res = await fetch(`/api/episodios/${epId}`, {
        method: 'PUT',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(data)
      });
      if (res.ok) {
        location.href = `/admin/serie/${serieId}/temporadas/${tempId}/episodios`;
      } else {
        alert('Error al guardar el episodio.');
      }
    });
  </script>
</AdminLayout>
