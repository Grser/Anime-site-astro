# Copia este archivo como .env (desarrollo) o define estas variables en el servidor.

# Base de datos MySQL
DB_HOST=localhost
DB_PORT=3306
DB_USER=conexiones
DB_PASSWORD=pon-aqui-una-contraseña-nueva
DB_NAME=streamplus

# Clave para firmar las sesiones (mínimo 32 caracteres aleatorios).
# Genera una con: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
SESSION_SECRET=

# Clave para cifrar los tokens de video del CDN (ocultan la URL real a los clientes).
# Si no se setea, se usa SESSION_SECRET como fallback; en prod poné una distinta.
VIDEO_SIGNING_SECRET=

# Opcional: clave para integraciones externas que crean series vía POST /api/series.
# El panel de administración ya no la necesita (usa la sesión del administrador).
KITSU_API_KEY=

# Carpeta donde están los videos (miniaturas y previews de la línea de tiempo)
CLAWN_VIDEO_ROOT=/mnt/archivos/todo-video
