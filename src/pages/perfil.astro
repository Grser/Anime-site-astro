---
import Layout from '../layouts/Layout.astro';
import db from '../lib/db';
import { ensureCommunityTables } from '../lib/community';

export const prerender = false;

const sessionUser = Astro.locals.user;
if (!sessionUser) return Astro.redirect('/login');
const usuarioId = sessionUser.id;
const perfilId = sessionUser.perfilId;

const [[user]] = await db.query<any[]>(
  `SELECT nickname, correo, imagen, suscripcion, region
     FROM usuarios
    WHERE id = ?
    LIMIT 1`,
  [usuarioId]
);
if (!user) return Astro.redirect('/login');

await ensureCommunityTables();
// Las solicitudes de anime son por cuenta (el admin responde al dueño de la cuenta),
// no por perfil, así que se consultan por usuario_id.
const [animeRequests] = await db.query<any[]>(
  `SELECT id, titulo, enlace, comentario, estado, respuesta, anime_url, created_at
     FROM anime_solicitudes
    WHERE usuario_id = ?
    ORDER BY created_at DESC
    LIMIT 10`,
  [usuarioId]
);
// Las notificaciones son por perfil (cada perfil tiene su bandeja).
const [notifications] = perfilId
  ? await db.query<any[]>(
      `SELECT id, tipo, titulo, mensaje, enlace, leida, created_at
         FROM notificaciones
        WHERE perfil_id = ?
        ORDER BY created_at DESC
        LIMIT 12`,
      [perfilId]
    )
  : [[]];
const [[unreadRow]] = perfilId
  ? await db.query<any[]>(
      'SELECT COUNT(*) AS total FROM notificaciones WHERE perfil_id = ? AND leida = 0',
      [perfilId]
    )
  : [[{ total: 0 }]];

const currentPlan = user.suscripcion || 'Gratis';
const currentRegion = user.region || 'US';
const hasPremium = currentPlan !== 'Gratis';
const avatarUrl = user.imagen || '/avatar.jpeg';
const unreadNotifications = Number(unreadRow?.total || 0);
const pendingRequests = animeRequests.filter((request) => request.estado === 'pendiente').length;
const formatDate = (value: string | Date) =>
  new Intl.DateTimeFormat('es-CL', { day: '2-digit', month: 'short', year: 'numeric' }).format(new Date(value));
---

<Layout title="ClawnVid | Mi perfil" description="Administra tu cuenta, solicitudes y notificaciones en ClawnVid.">
  <main class="mx-auto max-w-5xl px-3 py-5 sm:px-5 sm:py-8">
    <header class="rounded-3xl border border-white/10 bg-[#0e0d14] p-4 sm:p-6">
      <div class="flex items-center gap-4">
        <img src={avatarUrl} alt={`Foto de ${user.nickname}`} class="h-16 w-16 shrink-0 rounded-2xl border border-white/10 object-cover sm:h-20 sm:w-20" />
        <div class="min-w-0 flex-1">
          <p class="text-xs font-semibold uppercase tracking-[0.2em] text-purple-300/70">Mi perfil</p>
          <h1 class="truncate text-2xl font-black text-white sm:text-3xl">{user.nickname}</h1>
          <p class="truncate text-sm text-white/50">{user.correo}</p>
        </div>
        <span class:list={['hidden rounded-full px-3 py-1.5 text-xs font-bold sm:inline-flex', hasPremium ? 'bg-emerald-500/15 text-emerald-200' : 'bg-white/8 text-white/60']}>
          Plan {currentPlan}
        </span>
      </div>
    </header>

    <nav class="mt-4 grid grid-cols-3 gap-2 rounded-2xl border border-white/10 bg-[#0e0d14] p-2" aria-label="Secciones del perfil">
      <button type="button" data-profile-tab="cuenta" class="profile-tab is-active">
        <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3.5"/><path d="M5 20c.5-4 3-6 7-6s6.5 2 7 6"/></svg>
        <span>Cuenta</span>
      </button>
      <button type="button" data-profile-tab="solicitudes-anime" class="profile-tab">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M5 4h14v16H5zM8 8h8M8 12h8M8 16h5"/></svg>
        <span>Solicitudes</span>
        {pendingRequests > 0 && <small>{pendingRequests}</small>}
      </button>
      <button type="button" data-profile-tab="notificaciones" class="profile-tab">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M15 18H9m10-3H5c1.2-1.4 2-2.7 2-6a5 5 0 0 1 10 0c0 3.3.8 4.6 2 6Z"/></svg>
        <span>Avisos</span>
        {unreadNotifications > 0 && <small>{unreadNotifications > 99 ? '99+' : unreadNotifications}</small>}
      </button>
    </nav>

    <section data-profile-panel="cuenta" class="profile-panel mt-4 space-y-4">
      <div class="grid gap-4 md:grid-cols-2">
        <article class="profile-card">
          <div class="section-heading">
            <div><p>Foto de perfil</p><h2>Tu imagen</h2></div>
            <span>JPG, PNG, GIF o WebP · máx. 5 MB</span>
          </div>
          <form action="/api/profile/photo" method="POST" enctype="multipart/form-data" id="profile-photo-form" class="mt-5 space-y-4">
            <div class="flex items-center gap-4 rounded-2xl bg-black/20 p-4">
              <img id="profile-avatar-preview" src={avatarUrl} alt="Vista previa" class="h-20 w-20 shrink-0 rounded-2xl object-cover" />
              <div class="min-w-0">
                <p class="font-semibold text-white">Elige una imagen cuadrada</p>
                <p class="mt-1 text-xs leading-relaxed text-white/45">Usa un archivo ligero para que el perfil cargue más rápido.</p>
              </div>
            </div>
            <label class="block cursor-pointer rounded-xl border border-dashed border-purple-300/30 bg-purple-500/[0.06] px-4 py-3 text-center text-sm font-semibold text-purple-200 hover:bg-purple-500/10">
              Seleccionar imagen
              <input id="profile-photo-input" type="file" name="photo" accept="image/png,image/jpeg,image/gif,image/webp" class="hidden" />
            </label>
            <button type="submit" class="primary-button">Guardar foto</button>
            <p id="photo-msg" class="min-h-5 text-sm text-white/50" aria-live="polite"></p>
          </form>
        </article>

        <article class="profile-card">
          <div class="section-heading">
            <div><p>Preferencias</p><h2>Plan y región</h2></div>
            <a href="/suscripciones">Ver planes</a>
          </div>
          <dl class="mt-5 grid grid-cols-2 gap-3">
            <div class="info-box"><dt>Plan actual</dt><dd>{currentPlan}</dd></div>
            <div class="info-box"><dt>Estado</dt><dd>{hasPremium ? 'Premium activo' : 'Cuenta gratuita'}</dd></div>
          </dl>
          <form id="region-form" class="mt-4 space-y-3">
            <label for="region" class="block text-sm font-semibold text-white/70">Región de precios</label>
            <select id="region" class="field">
              <option value="US" selected={currentRegion === 'US'}>Estados Unidos (USD)</option>
              <option value="CL" selected={currentRegion === 'CL'}>Chile (CLP)</option>
              <option value="CO" selected={currentRegion === 'CO'}>Colombia (COP)</option>
              <option value="MX" selected={currentRegion === 'MX'}>México (MXN)</option>
              <option value="AR" selected={currentRegion === 'AR'}>Argentina (ARS)</option>
              <option value="PE" selected={currentRegion === 'PE'}>Perú (PEN)</option>
              <option value="ES" selected={currentRegion === 'ES'}>España (EUR)</option>
            </select>
            <button type="submit" class="secondary-button">Guardar región</button>
            <p id="region-msg" class="min-h-5 text-sm text-white/50" aria-live="polite"></p>
          </form>
        </article>
      </div>

      <article class="profile-card">
        <div class="section-heading">
          <div><p>Seguridad</p><h2>Cambiar contraseña</h2></div>
        </div>
        <form id="password-form" class="mt-5 grid gap-3 md:grid-cols-[1fr,1fr,auto] md:items-end">
          <label class="space-y-2 text-sm font-semibold text-white/70"><span>Contraseña actual</span><input id="oldPassword" type="password" class="field" autocomplete="current-password" /></label>
          <label class="space-y-2 text-sm font-semibold text-white/70"><span>Nueva contraseña</span><input id="newPassword" type="password" class="field" minlength="8" autocomplete="new-password" /></label>
          <button type="submit" class="primary-button md:w-auto">Actualizar</button>
          <p id="pwd-msg" class="min-h-5 text-sm text-white/50 md:col-span-3" aria-live="polite"></p>
        </form>
      </article>
    </section>

    <section id="solicitudes-anime" data-profile-panel="solicitudes-anime" class="profile-panel mt-4 hidden">
      <div class="mb-4 rounded-2xl border border-purple-400/15 bg-purple-500/[0.05] p-4">
        <h2 class="text-xl font-black text-white">Solicitar un anime</h2>
        <p class="mt-1 text-sm text-white/55">Envía el nombre una sola vez. Verás aquí si está pendiente, aceptado o rechazado.</p>
      </div>
      <div class="grid gap-4 lg:grid-cols-[0.85fr,1.15fr]">
        <article class="profile-card self-start">
          <form id="anime-request-form" class="space-y-4">
            <label class="form-label"><span>Nombre del anime</span><input name="title" required minlength="2" maxlength="180" class="field" placeholder="Ej: Frieren" /></label>
            <label class="form-label"><span>Enlace de referencia <em>Opcional</em></span><input name="link" type="url" maxlength="500" class="field" placeholder="https://..." /></label>
            <label class="form-label"><span>Comentario <em>Opcional</em></span><textarea name="comment" maxlength="1000" rows="4" class="field resize-none" placeholder="Temporada, idioma u otro dato útil"></textarea></label>
            <button type="submit" class="primary-button">Enviar solicitud</button>
            <p id="anime-request-message" class="min-h-5 text-sm text-white/50" aria-live="polite"></p>
          </form>
        </article>

        <article class="profile-card">
          <div class="section-heading"><div><p>Seguimiento</p><h2>Tus solicitudes</h2></div><span>{animeRequests.length} recientes</span></div>
          <div class="mt-4 space-y-3">
            {animeRequests.length ? animeRequests.map((request) => (
              <article class="rounded-2xl border border-white/8 bg-black/20 p-4">
                <div class="flex items-start justify-between gap-3">
                  <div class="min-w-0"><h3 class="truncate font-bold text-white">{request.titulo}</h3><p class="mt-1 text-xs text-white/35">{formatDate(request.created_at)}</p></div>
                  <span class:list={['status-pill', request.estado === 'aceptada' && 'is-approved', request.estado === 'rechazada' && 'is-rejected', request.estado === 'pendiente' && 'is-pending']}>{request.estado}</span>
                </div>
                {request.respuesta && <p class="mt-3 text-sm leading-relaxed text-white/60">{request.respuesta}</p>}
                {request.estado === 'aceptada' && request.anime_url && <a href={request.anime_url} class="mt-3 inline-flex rounded-lg bg-emerald-500/15 px-3 py-2 text-sm font-bold text-emerald-200 hover:bg-emerald-500/25">Ver anime →</a>}
              </article>
            )) : <div class="empty-state"><p>No tienes solicitudes todavía.</p><span>Completa el formulario para enviar la primera.</span></div>}
          </div>
        </article>
      </div>
    </section>

    <section id="notificaciones" data-profile-panel="notificaciones" class="profile-panel mt-4 hidden">
      <div class="mb-4 flex items-center justify-between gap-4 rounded-2xl border border-fuchsia-400/15 bg-purple-500/[0.06] p-4">
        <div><h2 class="text-xl font-black text-white">Tus avisos</h2><p class="mt-1 text-sm text-white/55">Solicitudes aceptadas y nuevos contenidos de las series que sigues.</p></div>
        {unreadNotifications > 0 && <button id="mark-all-notifications" type="button" class="shrink-0 rounded-xl bg-fuchsia-500/15 px-3 py-2 text-xs font-bold text-fuchsia-200 hover:bg-fuchsia-500/25">Marcar leídas</button>}
      </div>
      <article class="profile-card">
        {notifications.length ? (
          <div class="grid gap-3 md:grid-cols-2">
            {notifications.map((notification) => (
              <a href={notification.enlace || '/perfil#notificaciones'} data-notification-id={notification.id} class:list={['notification-item', !notification.leida && 'is-unread']}>
                <span class="notification-dot"></span>
                <div class="min-w-0"><h3>{notification.titulo}</h3><p>{notification.mensaje}</p><time>{formatDate(notification.created_at)}</time></div>
              </a>
            ))}
          </div>
        ) : (
          <div class="empty-state py-12"><p>No tienes notificaciones.</p><span>Activa “Avisarme de novedades” en la ficha de una serie.</span></div>
        )}
      </article>
    </section>
  </main>
</Layout>

<script type="module">
  const tabs = Array.from(document.querySelectorAll('[data-profile-tab]'));
  const panels = Array.from(document.querySelectorAll('[data-profile-panel]'));
  const validPanels = ['cuenta', 'solicitudes-anime', 'notificaciones'];

  const showPanel = (name, updateHash = false) => {
    const selected = validPanels.includes(name) ? name : 'cuenta';
    tabs.forEach((tab) => {
      const active = tab.getAttribute('data-profile-tab') === selected;
      tab.classList.toggle('is-active', active);
      tab.setAttribute('aria-selected', String(active));
    });
    panels.forEach((panel) => panel.classList.toggle('hidden', panel.getAttribute('data-profile-panel') !== selected));
    if (updateHash) history.replaceState(null, '', selected === 'cuenta' ? window.location.pathname : `#${selected}`);
  };

  tabs.forEach((tab) => tab.addEventListener('click', () => showPanel(tab.getAttribute('data-profile-tab') || 'cuenta', true)));
  showPanel(window.location.hash.slice(1) || 'cuenta');
  window.addEventListener('hashchange', () => showPanel(window.location.hash.slice(1) || 'cuenta'));

  const photoInput = document.getElementById('profile-photo-input');
  const avatarPreview = document.getElementById('profile-avatar-preview');
  const photoForm = document.getElementById('profile-photo-form');
  const photoMessage = document.getElementById('photo-msg');
  const setPhotoMessage = (text, tone = 'muted') => {
    if (!photoMessage) return;
    photoMessage.textContent = text;
    photoMessage.className = `min-h-5 text-sm ${tone === 'ok' ? 'text-emerald-300' : tone === 'error' ? 'text-red-300' : 'text-white/50'}`;
  };
  photoInput?.addEventListener('change', (event) => {
    const file = event.target?.files?.[0];
    if (!file || !(avatarPreview instanceof HTMLImageElement)) return;
    if (file.size > 5 * 1024 * 1024) {
      setPhotoMessage('La imagen no puede superar 5 MB.', 'error');
      return;
    }
    avatarPreview.src = URL.createObjectURL(file);
    setPhotoMessage('Vista previa lista. Pulsa «Guardar foto».');
  });
  // Antes el formulario se enviaba de forma nativa y el navegador terminaba en una
  // página con JSON en bruto. Ahora se envía con fetch y se muestra el resultado.
  photoForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(photoForm instanceof HTMLFormElement)) return;
    const file = photoInput instanceof HTMLInputElement ? photoInput.files?.[0] : null;
    if (!file) {
      setPhotoMessage('Selecciona una imagen primero.', 'error');
      return;
    }
    const submit = photoForm.querySelector('button[type="submit"]');
    if (submit instanceof HTMLButtonElement) submit.disabled = true;
    setPhotoMessage('Subiendo…');
    try {
      const response = await fetch('/api/profile/photo', { method: 'POST', body: new FormData(photoForm) });
      const data = await response.json().catch(() => ({}));
      if (!response.ok) throw new Error(data.error || 'No se pudo guardar la foto.');
      if (data.imagen && avatarPreview instanceof HTMLImageElement) avatarPreview.src = data.imagen;
      document.querySelectorAll('[data-user-avatar]').forEach((img) => {
        if (img instanceof HTMLImageElement && data.imagen) img.src = data.imagen;
      });
      setPhotoMessage(data.message || 'Foto actualizada.', 'ok');
      photoForm.reset();
    } catch (error) {
      setPhotoMessage(error instanceof Error ? error.message : 'No se pudo guardar la foto.', 'error');
    } finally {
      if (submit instanceof HTMLButtonElement) submit.disabled = false;
    }
  });

  const regionForm = document.getElementById('region-form');
  const regionEl = document.getElementById('region');
  const regionMsg = document.getElementById('region-msg');
  regionForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (regionMsg) regionMsg.textContent = 'Guardando…';
    try {
      const response = await fetch('/api/profile/region', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ region: regionEl?.value || 'US' }) });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'No se pudo guardar.');
      if (regionMsg) { regionMsg.textContent = data.message || 'Región actualizada.'; regionMsg.className = 'min-h-5 text-sm text-emerald-300'; }
    } catch (error) {
      if (regionMsg) { regionMsg.textContent = error instanceof Error ? error.message : 'No se pudo guardar.'; regionMsg.className = 'min-h-5 text-sm text-red-300'; }
    }
  });

  const passwordForm = document.getElementById('password-form');
  const passwordMessage = document.getElementById('pwd-msg');
  passwordForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    const oldPassword = document.getElementById('oldPassword');
    const newPassword = document.getElementById('newPassword');
    if (passwordMessage) passwordMessage.textContent = 'Actualizando…';
    try {
      const response = await fetch('/api/profile/password', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ oldPassword: oldPassword?.value || '', newPassword: newPassword?.value || '' }) });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'No se pudo actualizar.');
      if (passwordMessage) { passwordMessage.textContent = data.message || 'Contraseña actualizada.'; passwordMessage.className = 'min-h-5 text-sm text-emerald-300 md:col-span-3'; }
      passwordForm.reset();
    } catch (error) {
      if (passwordMessage) { passwordMessage.textContent = error instanceof Error ? error.message : 'No se pudo actualizar.'; passwordMessage.className = 'min-h-5 text-sm text-red-300 md:col-span-3'; }
    }
  });

  const requestForm = document.getElementById('anime-request-form');
  const requestMessage = document.getElementById('anime-request-message');
  requestForm?.addEventListener('submit', async (event) => {
    event.preventDefault();
    if (!(requestForm instanceof HTMLFormElement)) return;
    const submit = requestForm.querySelector('button[type="submit"]');
    const formData = new FormData(requestForm);
    if (submit instanceof HTMLButtonElement) submit.disabled = true;
    if (requestMessage) requestMessage.textContent = 'Enviando…';
    try {
      const response = await fetch('/api/anime-requests', { method: 'POST', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ title: formData.get('title'), link: formData.get('link'), comment: formData.get('comment') }) });
      const data = await response.json();
      if (!response.ok) throw new Error(data.error || 'No se pudo enviar.');
      if (requestMessage) { requestMessage.textContent = data.message; requestMessage.className = 'min-h-5 text-sm text-emerald-300'; }
      requestForm.reset();
      window.setTimeout(() => window.location.reload(), 600);
    } catch (error) {
      if (requestMessage) { requestMessage.textContent = error instanceof Error ? error.message : 'No se pudo enviar.'; requestMessage.className = 'min-h-5 text-sm text-red-300'; }
    } finally {
      if (submit instanceof HTMLButtonElement) submit.disabled = false;
    }
  });

  document.getElementById('mark-all-notifications')?.addEventListener('click', async () => {
    const response = await fetch('/api/notifications', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: '{}' });
    if (response.ok) window.location.reload();
  });
  document.querySelectorAll('[data-notification-id]').forEach((link) => link.addEventListener('click', () => {
    const id = Number(link.getAttribute('data-notification-id'));
    if (id) fetch('/api/notifications', { method: 'PATCH', headers: { 'Content-Type': 'application/json' }, body: JSON.stringify({ id }), keepalive: true });
  }));
</script>

<style>
  .profile-card { border: 1px solid rgba(255,255,255,.08); border-radius: 1.25rem; background: #0e0d14; padding: 1rem; }
  .section-heading { display: flex; align-items: center; justify-content: space-between; gap: .75rem; }
  .section-heading p { font-size: .68rem; font-weight: 700; letter-spacing: .18em; text-transform: uppercase; color: rgba(216,180,254,.65); }
  .section-heading h2 { margin-top: .15rem; font-size: 1.15rem; font-weight: 800; color: white; }
  .section-heading > span, .section-heading > a { border-radius: 999px; background: rgba(255,255,255,.06); padding: .4rem .7rem; font-size: .68rem; font-weight: 700; color: rgba(255,255,255,.55); }
  .profile-tab { position: relative; display: flex; min-width: 0; min-height: 3.25rem; align-items: center; justify-content: center; gap: .45rem; border-radius: .8rem; padding: .65rem .5rem; color: rgba(255,255,255,.48); font-size: .75rem; font-weight: 800; transition: background-color .15s ease, color .15s ease; }
  .profile-tab svg { width: 1.1rem; height: 1.1rem; fill: none; stroke: currentColor; stroke-width: 1.8; }
  .profile-tab small { position: absolute; right: .35rem; top: .3rem; min-width: 1.15rem; border-radius: 999px; background: #d946ef; padding: .1rem .3rem; color: white; font-size: .58rem; }
  .profile-tab.is-active { background: rgba(168,85,247,.14); color: #f3e8ff; }
  .field { display: block; width: 100%; border: 1px solid rgba(255,255,255,.1); border-radius: .75rem; background: #08070c; padding: .75rem .85rem; color: white; outline: none; }
  .field:focus { border-color: rgba(192,132,252,.65); }
  .form-label { display: block; color: rgba(255,255,255,.72); font-size: .82rem; font-weight: 700; }
  .form-label > span { margin-bottom: .45rem; display: flex; justify-content: space-between; gap: .5rem; }
  .form-label em { color: rgba(255,255,255,.35); font-size: .7rem; font-style: normal; font-weight: 500; }
  .primary-button, .secondary-button { display: inline-flex; width: 100%; min-height: 2.75rem; align-items: center; justify-content: center; border-radius: .75rem; padding: .65rem 1rem; font-size: .85rem; font-weight: 800; color: white; }
  .primary-button { background: #9333ea; }
  .primary-button:hover { background: #a855f7; }
  .secondary-button { border: 1px solid rgba(255,255,255,.1); background: rgba(255,255,255,.06); }
  .primary-button:disabled { cursor: wait; opacity: .55; }
  .info-box { border-radius: .85rem; background: rgba(255,255,255,.04); padding: .8rem; }
  .info-box dt { font-size: .65rem; text-transform: uppercase; letter-spacing: .12em; color: rgba(255,255,255,.4); }
  .info-box dd { margin-top: .3rem; font-size: .88rem; font-weight: 800; color: white; }
  .status-pill { flex: 0 0 auto; border-radius: 999px; padding: .3rem .6rem; font-size: .62rem; font-weight: 800; text-transform: uppercase; }
  .status-pill.is-approved { background: rgba(16,185,129,.14); color: #a7f3d0; }
  .status-pill.is-rejected { background: rgba(239,68,68,.14); color: #fecaca; }
  .status-pill.is-pending { background: rgba(245,158,11,.14); color: #fde68a; }
  .notification-item { display: flex; gap: .75rem; min-width: 0; border: 1px solid rgba(255,255,255,.07); border-radius: 1rem; background: rgba(0,0,0,.16); padding: .9rem; transition: border-color .15s ease, background-color .15s ease; }
  .notification-item:hover { border-color: rgba(232,121,249,.28); }
  .notification-item.is-unread { border-color: rgba(217,70,239,.14); background: rgba(168,85,247,.07); }
  .notification-dot { margin-top: .35rem; width: .5rem; height: .5rem; flex: 0 0 auto; border-radius: 999px; background: rgba(255,255,255,.16); }
