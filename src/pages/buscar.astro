---
import Layout from '../layouts/Layout.astro';

export const prerender = false;

const q = Astro.url.searchParams.get('q')?.trim() || '';
---

<Layout title="ClawnVid | Buscar" description="Busca series en ClawnVid con resultados instantáneos.">
  <section class="min-h-screen bg-[#0a0a0f] text-white">
    <div class="mx-auto flex max-w-screen-2xl flex-col gap-8 px-4 pb-16 pt-24 md:px-6 lg:px-8">
      <div class="rounded-[2rem] border border-white/10 bg-gradient-to-br from-[#171722] via-[#0d0d14] to-black p-5 shadow-2xl shadow-black/40 md:p-8">
        <div class="flex flex-col gap-6 lg:flex-row lg:items-end lg:justify-between">
          <div class="max-w-3xl space-y-3">
            <span class="inline-flex w-fit items-center gap-2 rounded-full border border-purple-400/20 bg-purple-500/10 px-4 py-2 text-xs font-semibold uppercase tracking-[0.28em] text-purple-200">
              Buscar en ClawnVid
            </span>
            <h1 class="text-3xl font-black leading-tight text-white md:text-5xl">Una búsqueda rápida, visual y directa, como debería sentirse.</h1>
            <p class="max-w-2xl text-sm text-white/65 md:text-base">
              Escribe el nombre de un anime y te mostramos todas las coincidencias abajo al instante, sin tener que dar Enter.
            </p>
          </div>

          <div class="grid grid-cols-3 gap-3 md:min-w-[360px]">
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <p class="text-xs uppercase tracking-[0.24em] text-white/45">Resultados</p>
              <p class="mt-2 text-2xl font-black" data-results-count>--</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <p class="text-xs uppercase tracking-[0.24em] text-white/45">Top score</p>
              <p class="mt-2 text-2xl font-black" data-top-score>--</p>
            </div>
            <div class="rounded-2xl border border-white/10 bg-white/5 p-4">
              <p class="text-xs uppercase tracking-[0.24em] text-white/45">Capítulos</p>
              <p class="mt-2 text-2xl font-black" data-episodes-count>--</p>
            </div>
          </div>
        </div>

        <div class="mt-6 space-y-4">
          <div class="relative">
            <div class="flex items-center gap-3 rounded-[1.6rem] border border-white/10 bg-white/5 px-4 py-3 shadow-inner shadow-black/20 transition focus-within:border-purple-400/50 focus-within:bg-white/10">
              <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="none" stroke="currentColor" class="h-5 w-5 shrink-0 text-white/55">
                <circle cx="11" cy="11" r="7" stroke-width="1.7" />
                <path stroke-width="1.7" stroke-linecap="round" d="m16 16 4 4" />
              </svg>
              <input
                id="search-input"
                type="text"
                value={q}
                autocomplete="off"
                spellcheck="false"
                placeholder="Busca por título, género o palabra clave"
                class="h-12 w-full bg-transparent text-base text-white placeholder:text-white/35 focus:outline-none md:text-lg"
              />
              <button
                type="button"
                id="clear-search"
                class={`rounded-full bg-white/10 px-3 py-1 text-xs font-semibold text-white/75 transition hover:bg-white/15 ${q ? '' : 'hidden'}`}
              >
                Limpiar
              </button>
            </div>
          </div>

          <div class="flex flex-wrap items-center gap-2 text-sm text-white/55">
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">Resultados automáticos</span>
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">Sin Enter</span>
            <span class="rounded-full border border-white/10 bg-white/5 px-3 py-1">Listado en vivo abajo</span>
          </div>
        </div>
      </div>

      <div id="results-shell" class="hidden mx-auto w-full max-w-6xl rounded-[2rem] border border-white/10 bg-white/[0.03] p-4 md:p-6">
        <div class="mb-4 flex items-center justify-between gap-3">
          <div>
            <p class="text-xs uppercase tracking-[0.28em] text-purple-200/70">Resultados</p>
            <h2 class="text-2xl font-black text-white">Coincidencias encontradas</h2>
          </div>
          <span class="rounded-full bg-purple-500/15 px-3 py-1 text-xs font-semibold text-purple-100" data-list-count>
            0 resultados
          </span>
        </div>

        <div id="results-state" class="hidden rounded-2xl border border-white/10 bg-white/5 p-4 text-sm text-white/60"></div>
        <div id="results-list" class="mt-4 space-y-3"></div>
      </div>
    </div>
  </section>

  <script>
    (() => {
      const searchInput = document.getElementById('search-input');
      const clearButton = document.getElementById('clear-search');
      const resultsCount = document.querySelector('[data-results-count]');
      const topScore = document.querySelector('[data-top-score]');
      const episodesCount = document.querySelector('[data-episodes-count]');
      const resultsShell = document.getElementById('results-shell');
      const resultsList = document.getElementById('results-list');
      const resultsState = document.getElementById('results-state');
      const listCount = document.querySelector('[data-list-count]');

      if (!(searchInput instanceof HTMLInputElement)) return;

      let controller = null;
      let debounceTimer = null;

      const escapeHtml = value => String(value || '')
        .replaceAll('&', '&amp;')
        .replaceAll('<', '&lt;')
        .replaceAll('>', '&gt;')
        .replaceAll('"', '&quot;')
        .replaceAll("'", '&#39;');

      const setVisible = (element, visible) => {
        if (!element) return;
        element.classList.toggle('hidden', !visible);
      };

      const updateStats = results => {
        const totalResults = results.length;
        const totalEpisodes = results.reduce((acc, serie) => acc + (Number(serie.episodio_count) || 0), 0);
        const bestScore = results[0]?.match_score ?? '--';

        if (resultsCount) resultsCount.textContent = searchInput.value.trim() ? String(totalResults) : '--';
        if (topScore) topScore.textContent = searchInput.value.trim() ? String(bestScore) : '--';
        if (episodesCount) episodesCount.textContent = searchInput.value.trim() ? String(totalEpisodes) : '--';
      };

      const resetResults = () => {
        setVisible(resultsShell, false);
        if (resultsList) resultsList.innerHTML = '';
        if (resultsState) {
          resultsState.textContent = '';
          setVisible(resultsState, false);
        }
        if (listCount) listCount.textContent = '0 resultados';
        updateStats([]);
      };

      const showState = message => {
        setVisible(resultsShell, true);
        if (resultsState) {
          resultsState.textContent = message;
          setVisible(resultsState, true);
        }
        if (resultsList) resultsList.innerHTML = '';
      };

      const renderResults = results => {
        if (!resultsList) return;

        setVisible(resultsShell, true);
        setVisible(resultsState, false);
        if (listCount) listCount.textContent = `${results.length} resultados`;

        if (!results.length) {
          showState('No encontré coincidencias con ese nombre.');
          return;
        }

        resultsList.innerHTML = results.map((serie, index) => `
          <a href="/serie/${serie.slug}" class="group flex items-center gap-3 rounded-[1.35rem] border border-white/10 bg-[#101018] px-4 py-3 transition hover:border-purple-400/40 hover:bg-[#151520]">
            <div class="h-20 w-14 shrink-0 overflow-hidden rounded-xl bg-white/5">
              <img src="${escapeHtml(serie.icon || '/avatar.jpeg')}" alt="${escapeHtml(serie.titulo)}" class="h-full w-full object-cover" />
            </div>
            <div class="min-w-0 flex-1">
              <p class="truncate text-base font-semibold text-white group-hover:text-purple-200">${escapeHtml(serie.titulo)}</p>
              <p class="mt-1 text-xs text-white/45">#${index + 1} • ${serie.temporada_count || 0} temporadas • ${serie.episodio_count || 0} episodios</p>
              <p class="mt-2 line-clamp-2 text-sm text-white/60">${escapeHtml(serie.descripcion || 'Sin descripción disponible.')}</p>
            </div>
            <span class="text-sm font-semibold text-purple-200">Abrir</span>
          </a>
        `).join('');
      };

      const runSearch = async rawValue => {
        const query = String(rawValue || '').trim();

        if (controller) controller.abort();

        if (!query) {
          if (history.replaceState) {
            const url = new URL(window.location.href);
            url.searchParams.delete('q');
            history.replaceState({}, '', url);
          }
          resetResults();
          setVisible(clearButton, false);
          return;
        }

        setVisible(clearButton, true);
        showState('Buscando coincidencias...');
        controller = new AbortController();

        try {
          const response = await fetch(`/api/search?q=${encodeURIComponent(query)}&limit=24`, {
            signal: controller.signal,
            headers: { 'Accept': 'application/json' }
          });

          if (!response.ok) throw new Error('Falló la búsqueda');

          const data = await response.json();
          const results = Array.isArray(data.results) ? data.results : [];

          if (history.replaceState) {
            const url = new URL(window.location.href);
            url.searchParams.set('q', query);
            history.replaceState({}, '', url);
          }

          updateStats(results);
          renderResults(results);
        } catch (error) {
          if (error?.name === 'AbortError') return;
          console.error(error);
          showState('No se pudo cargar la búsqueda.');
          updateStats([]);
        }
      };

      const queueSearch = value => {
        clearTimeout(debounceTimer);
        debounceTimer = setTimeout(() => {
          void runSearch(value);
        }, 80);
      };

      searchInput.addEventListener('input', () => queueSearch(searchInput.value));
      searchInput.addEventListener('keyup', () => queueSearch(searchInput.value));
      searchInput.addEventListener('search', () => queueSearch(searchInput.value));
      searchInput.addEventListener('change', () => queueSearch(searchInput.value));
      searchInput.addEventListener('keydown', event => {
        if (event.key === 'Enter') {
          event.preventDefault();
        }
      });

      clearButton?.addEventListener('click', () => {
        searchInput.value = '';
        setVisible(clearButton, false);
        resetResults();
        searchInput.focus();
      });

      if (searchInput.value.trim()) {
        void runSearch(searchInput.value);
      } else {
        resetResults();
      }
    })();
  </script>
</Layout>
