---
import Layout from '../layouts/Layout.astro';
import db from '../lib/db';

export const prerender = false;

let featured = [], recent = [], popular = [], allSeries = [], continueWatching = [];
let randomPool = [];
let totalSeries = 0;
const perfilId = Astro.locals.user?.perfilId;

try {
  [featured] = await db.query(`
    SELECT s.*,
      (SELECT COUNT(*) FROM temporadas t WHERE t.serie_id = s.id) AS temporada_count,
      (SELECT COUNT(*) FROM episodios e
         JOIN temporadas t ON e.temporada_id = t.id
         WHERE t.serie_id = s.id) AS episodio_count
    FROM series s
    WHERE s.carrucel_1 = 1
    ORDER BY s.popularidad DESC;
  `);

  [popular] = await db.query(`
    SELECT 
      s.*, 
      COUNT(ld.id) AS total_likes,
      (SELECT COUNT(*) FROM temporadas t WHERE t.serie_id = s.id) AS temporada_count,
      (SELECT COUNT(*) FROM episodios e
        JOIN temporadas t ON e.temporada_id = t.id
        WHERE t.serie_id = s.id) AS episodio_count
    FROM series s
    JOIN likes_dislikes ld
      ON ld.serie_id = s.id AND ld.tipo = 'like'
    GROUP BY s.id
    ORDER BY total_likes DESC
    LIMIT 10;
  `);

  [recent] = await db.query(`
    SELECT s.*,
      (SELECT COUNT(*) FROM temporadas t WHERE t.serie_id = s.id) AS temporada_count,
      (SELECT COUNT(*) FROM episodios e
         JOIN temporadas t ON e.temporada_id = t.id
         WHERE t.serie_id = s.id) AS episodio_count
    FROM series s
    WHERE destacado_reciente = 1;
  `);

  // Para la grid "Directorio Completo" del home solo mostramos una muestra; el
  // listado real con paginación vive en /directorio. Antes traíamos TODAS las
  // series del catálogo con todas sus columnas, lo que pegaba al rendimiento.
  [allSeries] = await db.query(`
    SELECT s.id, s.slug, s.titulo, s.descripcion, s.icon,
      (SELECT COUNT(*) FROM temporadas t WHERE t.serie_id = s.id) AS temporada_count,
      (SELECT COUNT(*) FROM episodios e
         JOIN temporadas t ON e.temporada_id = t.id
         WHERE t.serie_id = s.id) AS episodio_count
    FROM series s
    ORDER BY s.titulo
    LIMIT 20;
  `);
  const [[totalRow]] = await db.query('SELECT COUNT(*) AS total FROM series');
  totalSeries = Number(totalRow?.total ?? 0);

  // Pool mínimo para el dialog "Algo al azar": solo las series que TIENEN trailer
  // y solo los campos que el modal necesita (id, slug, títulos, descripción,
  // banner, icon, género, trailer_url, conteos). Antes serializábamos TODO el
  // catálogo con s.*, lo que inflaba el HTML inicial y pegaba al rendimiento.
  [randomPool] = await db.query(`
    SELECT s.id, s.slug, s.titulo, s.descripcion, s.icon, s.banner, s.genero, s.trailer_url,
      (SELECT COUNT(*) FROM temporadas t WHERE t.serie_id = s.id) AS temporada_count,
      (SELECT COUNT(*) FROM episodios e
         JOIN temporadas t ON e.temporada_id = t.id
         WHERE t.serie_id = s.id) AS episodio_count
    FROM series s
    WHERE s.trailer_url IS NOT NULL AND s.trailer_url <> ''
    ORDER BY RAND()
    LIMIT 40;
  `);

  if (perfilId) {
    [continueWatching] = await db.query(
      `SELECT * FROM (
         SELECT
           h.episodio_id,
           h.progreso,
           h.completado,
           h.fecha_actualizacion,
           e.titulo      AS episodio_titulo,
           e.imagen_preview,
           e.duracion,
           e.idioma,
           s.titulo      AS serie_titulo,
           s.slug,
           s.id          AS serie_id,
           t.id          AS temporada_id,
           ROW_NUMBER() OVER (PARTITION BY s.id ORDER BY h.fecha_actualizacion DESC, h.id DESC) AS serie_rank
         FROM historial h
         JOIN episodios e ON h.episodio_id = e.id
         JOIN temporadas t ON e.temporada_id = t.id
         JOIN series s ON t.serie_id = s.id
         WHERE h.perfil_id = ?
       ) ranked
       WHERE ranked.serie_rank = 1
       ORDER BY ranked.fecha_actualizacion DESC
       LIMIT 6;`,
      [perfilId],
    );
  }
} catch (e) {
  console.error('Error cargando datos home:', e);
}

const continueWatchingNormalized = continueWatching
  .map((item) => {
    const totalSeconds = (item.duracion || 0) * 60;
    const percent = totalSeconds > 0 ? Math.min(100, Math.round((item.progreso / totalSeconds) * 100)) : 0;

    return { ...item, percent };
  })
  .filter((item) => !item.completado && item.percent < 98);

const featuredShowcase = featured.slice(1, 7);
const heroSlides =
  featured.length > 0
    ? featured
    : recent.length > 0
      ? recent
      : popular.length > 0
        ? popular
        : allSeries.slice(0, 6);
const initialHero = heroSlides[0] ?? allSeries[0];
const heroThumbs = heroSlides.slice(0, 6);
const monthlyHighlights =
  featuredShowcase.length > 0
    ? featuredShowcase
    : featured.length > 0
      ? featured
      : recent.length > 0
        ? recent
        : popular.slice(0, 8);
---

<Layout
  title="ClawnVid | Mira anime online"
  description="Descubre animes destacados, estrenos y continúa viendo tus episodios favoritos en ClawnVid."
  image={initialHero?.banner || initialHero?.icon || "/avatar.jpeg"}
>
  <section class="relative mt-2 sm:mt-6 px-2 sm:px-4 pb-6 sm:pb-12 max-w-screen-2xl mx-auto overflow-x-hidden" data-hero-root>
    <div class="hero-stage relative overflow-hidden rounded-[22px] sm:rounded-3xl bg-gradient-to-br from-purple-950/90 via-slate-950 to-black shadow-2xl ring-1 ring-purple-500/30 max-w-full">
        <div class="absolute inset-0">
          <div class="absolute inset-0 bg-white/5 opacity-10" aria-hidden="true" />
          <img
            data-hero-banner
            src={initialHero?.banner || initialHero?.icon || '/avatar.jpeg'}
            alt={initialHero?.titulo || 'Serie destacada'}
            class="w-full h-full object-cover opacity-40"
          />
        <div class="absolute inset-0 bg-gradient-to-r from-black via-black/80 to-transparent" />
      </div>

      {heroSlides.length > 1 && (
        <div class="absolute right-4 top-4 sm:right-6 sm:top-6 z-20 hidden sm:flex items-center gap-2 text-white/90">
          <button
            type="button"
            aria-label="Anterior destacado"
            data-hero-prev
            class="p-2 rounded-full bg-white/10 border border-white/15 hover:border-purple-300/60 hover:bg-white/15 transition"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7" /></svg>
          </button>
          <button
            type="button"
            aria-label="Siguiente destacado"
            data-hero-next
            class="p-2 rounded-full bg-white/10 border border-white/15 hover:border-purple-300/60 hover:bg-white/15 transition"
          >
            <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
          </button>
        </div>
      )}

      <div class="hero-stage-content relative flex flex-col lg:flex-row gap-4 sm:gap-8 p-3.5 sm:p-6 lg:p-12 items-start">
        <div class="flex-1 space-y-4 sm:space-y-6 max-w-3xl w-full min-w-0">
          <div class="flex flex-wrap items-center gap-2 sm:gap-3 text-[10px] sm:text-xs uppercase tracking-[0.18em] sm:tracking-[0.25em] text-purple-200/90">
            <span class="px-3 py-1 rounded-full bg-purple-600/70 backdrop-blur text-[11px]">Estreno destacado</span>
            {initialHero && (
              <span class="max-w-full truncate px-3 py-1 rounded-full bg-white/10 border border-white/10" data-hero-genre>{initialHero.genero}</span>
            )}
          </div>

          <div class="space-y-3">
            <p class="text-xs sm:text-sm text-purple-100/70">Bienvenido a tu hub de anime</p>
            <h1 class="line-clamp-2 text-[1.75rem] sm:text-4xl lg:text-5xl font-black text-white drop-shadow-xl leading-[1.05]" data-hero-title>
              {initialHero?.titulo || 'Descubre tu próximo anime favorito'}
            </h1>
            <p class="line-clamp-3 text-[13px] sm:text-base text-gray-100/90 leading-relaxed max-w-2xl pr-1" data-hero-description>
              {initialHero
                ? `${(initialHero.descripcion || '').slice(0, 200)}${initialHero.descripcion && initialHero.descripcion.length > 200 ? '…' : ''}`
                : 'Explora estrenos, clásicos y recomendaciones seleccionadas con información clara de temporadas y episodios.'}
            </p>
          </div>

          <div class="flex flex-wrap gap-2 sm:gap-3 text-xs sm:text-sm text-white/90" data-hero-meta>
            <span class="inline-flex items-center gap-2 px-3 sm:px-4 py-2 rounded-full bg-white/10 border border-white/10" data-hero-seasons>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M4 7h16M4 12h16M4 17h16" /></svg>
              <span data-hero-seasons-text>{initialHero?.temporada_count ?? '–'} Temporadas</span>
            </span>
            <span class="inline-flex items-center gap-2 px-3 sm:px-4 py-2 rounded-full bg-white/10 border border-white/10" data-hero-episodes>
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 6v6l4 2" /></svg>
              <span data-hero-episodes-text>{initialHero?.episodio_count ?? '–'} Episodios</span>
            </span>
            <span
              class={`inline-flex items-center gap-2 px-3 sm:px-4 py-2 rounded-full bg-white/10 border border-white/10 ${initialHero?.idioma ? '' : 'hidden'}`}
              data-hero-language
            >
              <svg class="w-4 h-4" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M12 18c4.418 0 8-2.686 8-6s-3.582-6-8-6-8 2.686-8 6 3.582 6 8 6z" /><path stroke-linecap="round" stroke-linejoin="round" d="M2 12h20M12 6c1.667 4 1.667 8 0 12" /></svg>
              <span data-hero-language-text>Idioma {initialHero?.idioma}</span>
            </span>
          </div>

          <div class="grid grid-cols-2 gap-2.5 sm:grid-cols-3 sm:gap-4 w-full sm:w-auto">
            {initialHero && (
              <a
                href={`/serie/${initialHero.slug}`}
                data-hero-link
                class="flex min-h-12 items-center justify-center text-center px-3 sm:px-6 py-3 rounded-xl bg-gradient-to-r from-purple-500 to-fuchsia-500 text-sm sm:text-base text-white font-semibold shadow-lg shadow-purple-600/40 hover:-translate-y-0.5 transition"
              >
                Ver ahora
              </a>
            )}
            <a href="/explorar" class="flex min-h-12 items-center justify-center text-center px-3 sm:px-6 py-3 rounded-xl border border-white/15 text-sm sm:text-base text-white/90 hover:border-white/40 hover:text-white transition">
              Explorar catálogo
            </a>
            {totalSeries > 0 && (
              <button
                type="button"
                data-random-series
                class="col-span-2 flex min-h-12 items-center justify-center gap-2 rounded-xl border border-purple-300/20 bg-purple-500/10 px-3 py-3 text-sm font-semibold text-purple-100 transition hover:-translate-y-0.5 hover:border-purple-200/45 hover:bg-purple-500/20 sm:col-span-1 sm:text-base"
              >
                <svg class="h-4 w-4 sm:h-5 sm:w-5" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8" aria-hidden="true"><path stroke-linecap="round" stroke-linejoin="round" d="M16 3h5v5M4 20l6.5-6.5M21 16v5h-5M14 14l7 7M3 4l6.5 6.5" /></svg>
                Algo al azar
              </button>
            )}
          </div>
        </div>

        <div class="w-full lg:w-[420px] space-y-3 sm:space-y-4 min-w-0 lg:pl-2">
          <div class="grid grid-cols-2 gap-2.5 sm:gap-3">
            <div class="rounded-2xl bg-white/10 border border-white/10 p-3 sm:p-4 text-white/90 backdrop-blur shadow-lg min-w-0">
              <p class="text-xs text-purple-100/70">Series listadas</p>
              <p class="text-2xl sm:text-3xl font-black">{totalSeries}</p>
              <p class="text-xs mt-1 text-white/70">Con temporadas y episodios contados</p>
            </div>
            <div class="rounded-2xl bg-gradient-to-br from-purple-600/80 to-fuchsia-500/60 p-3 sm:p-4 text-white shadow-lg min-w-0">
              <p class="text-xs opacity-90">Novedades</p>
              <p class="text-2xl sm:text-3xl font-black">{recent.length}</p>
              <p class="text-xs mt-1 opacity-90">Estrenos recientes</p>
            </div>
          </div>
          <div class={`rounded-2xl border border-white/10 bg-white/5 backdrop-blur p-3 sm:p-4 space-y-3 shadow-xl overflow-hidden ${heroThumbs.length ? '' : 'hidden'}`}>
            <div class="flex items-start sm:items-center justify-between gap-2">
              <p class="text-sm uppercase tracking-[0.2em] text-purple-100/80">Destacadas</p>
              {heroSlides.length > 1 && (
                <span class="text-[10px] sm:text-[11px] text-white/60 text-right">Selecciona para ver en grande</span>
              )}
            </div>
            <div class="flex gap-2.5 sm:gap-3 overflow-x-auto px-0.5 pb-1 scrollbar-hide snap-x snap-mandatory max-w-full" data-hero-thumbs>
              {heroThumbs.map((item, idx) => (
                <a
                  href={`/serie/${item.slug}`}
                  data-hero-thumb={idx}
                  class={`flex items-center gap-3 p-3 rounded-xl bg-black/30 border border-white/5 hover:border-purple-400/40 transition shrink-0 w-[220px] max-w-[78vw] min-w-0 sm:max-w-[250px] sm:w-[250px] snap-center sm:snap-start ${idx === 0 ? 'is-active' : ''}`}
                >
                  <img src={item.icon} alt={item.titulo} class="w-14 h-14 rounded-xl object-cover" />
                  <div class="space-y-1 text-left">
                    <p class="text-sm text-white font-semibold line-clamp-1">{item.titulo}</p>
                    <p class="text-[11px] text-purple-100/80">{item.temporada_count} Temp · {item.episodio_count} Ep</p>
                  </div>
                </a>
              ))}
            </div>
          </div>
        </div>
      </div>
    </div>
  </section>

  <script type="application/json" id="hero-data" set:html={JSON.stringify(heroSlides).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026')} />
  <script type="application/json" id="random-series-data" set:html={JSON.stringify(randomPool).replace(/</g, '\\u003c').replace(/>/g, '\\u003e').replace(/&/g, '\\u0026')} />

  <dialog id="random-series-modal" class="random-series-modal" aria-labelledby="random-series-title">
    <article class="random-series-dialog">
      <button type="button" class="random-modal-close" data-random-close aria-label="Cerrar avance">×</button>
      <div class="random-trailer-stage">
        <img id="random-trailer-poster" class="random-trailer-poster" src="/avatar.jpeg" alt="" />
        <video id="random-trailer-video" class="random-trailer-media" playsinline muted preload="metadata" controlsList="nodownload noplaybackrate noremoteplayback" disablePictureInPicture hidden></video>
        <iframe id="random-trailer-embed" class="random-trailer-media" title="Tráiler" allow="autoplay; encrypted-media; picture-in-picture" allowfullscreen hidden></iframe>
        <div id="random-trailer-unavailable" class="random-trailer-unavailable" hidden>
          <span>Esta serie aún no tiene tráiler.</span>
        </div>
        <button id="random-trailer-play" type="button" class="random-play-overlay" aria-label="Reproducir" hidden>
          <svg viewBox="0 0 24 24" width="42" height="42" aria-hidden="true"><path fill="currentColor" d="M8 5v14l11-7z"/></svg>
        </button>
        <div id="random-trailer-progress" class="random-progress"><span></span></div>
        <button id="random-trailer-sound" type="button" class="random-sound-button" hidden>
          Activar sonido
        </button>
      </div>
      <div class="random-series-copy">
        <div class="min-w-0 random-copy-body">
          <p class="text-[11px] font-semibold uppercase tracking-[0.25em] text-purple-200/75">Selección aleatoria</p>
          <h2 id="random-series-title" class="mt-1 line-clamp-2 text-xl font-black text-white sm:text-2xl random-copy-title"></h2>
          <p id="random-series-meta" class="mt-2 text-xs text-white/60 random-copy-meta"></p>
          <p id="random-series-description" class="mt-3 line-clamp-3 text-sm leading-relaxed text-white/78 random-copy-description"></p>
        </div>
        <div class="actions">
          <button type="button" data-random-again class="random-secondary-button">Otra opción</button>
          <a id="random-series-link" class="random-primary-button" href="#">Ver serie</a>
        </div>
      </div>
    </article>
  </dialog>

  {perfilId && continueWatchingNormalized.length > 0 && (
    <section class="px-2 sm:px-4 pb-6 sm:pb-10 max-w-screen-2xl mx-auto overflow-x-hidden" data-continue-section>
      <div class="w-full bg-gradient-to-r from-purple-900/50 via-black to-black/90 border border-purple-500/20 rounded-[22px] sm:rounded-3xl p-4 sm:p-6 shadow-2xl shadow-purple-500/20">
        <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between mb-4">
          <div>
            <p class="text-[11px] sm:text-xs uppercase tracking-[0.32em] text-purple-200/70">Retoma tu aventura</p>
            <h2 class="text-white text-xl sm:text-2xl font-extrabold">Continuar viendo</h2>
          </div>
          <div class="text-xs sm:text-sm text-white/70 bg-white/10 border border-white/15 px-3 py-1.5 rounded-full backdrop-blur self-start sm:self-auto">
            Progreso guardado automáticamente
          </div>
        </div>

        <div class="grid sm:grid-cols-2 lg:grid-cols-3 gap-3 sm:gap-4" data-continue-grid>
          {continueWatchingNormalized.map((item) => (
            <article class="continue-card relative min-w-0 overflow-hidden rounded-2xl border border-white/10 bg-white/5 shadow-lg" data-continue-card>
              <a href={`/serie/${item.slug}/${item.episodio_id}`} class="group relative block min-h-52 overflow-hidden">
                <div class="absolute inset-0 bg-gradient-to-t from-black via-black/60 to-transparent z-10"></div>
                <img src={item.imagen_preview || '/avatar.jpeg'} alt={item.episodio_titulo} class="block h-52 w-full object-cover" loading="lazy" decoding="async" onerror="this.onerror=null;this.src='/avatar.jpeg'" />
                <div class="absolute top-3 left-3 z-20 inline-flex items-center gap-2 px-3 py-1 rounded-full bg-purple-500/30 text-purple-50 text-[11px] sm:text-xs border border-purple-300/40">
                  <span class="h-2 w-2 rounded-full bg-emerald-300"></span>
                  {item.idioma}
                </div>
                <div class="absolute bottom-0 left-0 right-0 z-20 p-3 sm:p-4 space-y-2">
                  <p class="text-[11px] sm:text-xs uppercase tracking-[0.25em] text-purple-100/80 line-clamp-1">{item.serie_titulo}</p>
                  <p class="text-white font-semibold leading-tight line-clamp-2 text-sm sm:text-base">{item.episodio_titulo}</p>
                  <div class="w-full h-2 bg-white/20 rounded-full overflow-hidden">
                    <div class="h-full bg-gradient-to-r from-purple-500 to-fuchsia-500" style={`width: ${item.percent}%`}></div>
                  </div>
                  <div class="flex items-center justify-between text-[11px] sm:text-xs text-white/80 gap-2">
                    <span>Progreso: {item.percent}%</span>
                    <span>{Math.floor(item.progreso / 60)}:{`${Math.floor(item.progreso % 60)}`.padStart(2, '0')}</span>
                  </div>
                </div>
              </a>
              <div class="continue-menu-wrap absolute right-3 top-3 z-30">
                <button type="button" class="continue-menu-button" aria-label={`Opciones para ${item.episodio_titulo}`} aria-haspopup="menu" aria-expanded="false" data-continue-menu-button>⋮</button>
                <div class="continue-menu hidden" data-continue-menu>
                  <button type="button" data-mark-watched data-episode-id={item.episodio_id}>Marcar como visto</button>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="px-2 sm:px-4 space-y-8 sm:space-y-10 pb-24 sm:pb-12 max-w-screen-2xl mx-auto overflow-x-hidden">
    <div class="w-full flex flex-col gap-4 sm:gap-6 items-start text-left" data-carousel="featured">
      <div class="flex flex-wrap items-start sm:items-center justify-between gap-4">
        <div>
          <p class="text-[11px] sm:text-sm uppercase tracking-[0.25em] text-purple-200/70">Selección</p>
          <h2 class="text-white text-2xl sm:text-3xl font-extrabold">Catálogo destacado</h2>
        </div>
        <div class="flex items-center gap-3 sm:gap-4 w-full sm:w-auto justify-between sm:justify-start">
          <a href="/explorar" class="text-sm text-purple-200 hover:text-white transition">Ver todo →</a>
          <div class="flex items-center gap-2 text-white/80">
            <button type="button" aria-label="Anterior" data-carousel-prev class="p-2 rounded-full bg-white/10 border border-white/15 hover:border-purple-300/60 hover:bg-white/15 transition disabled:opacity-40 disabled:cursor-not-allowed">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M15 5l-7 7 7 7" /></svg>
            </button>
            <button type="button" aria-label="Siguiente" data-carousel-next class="p-2 rounded-full bg-white/10 border border-white/15 hover:border-purple-300/60 hover:bg-white/15 transition disabled:opacity-40 disabled:cursor-not-allowed">
              <svg class="w-5 h-5" fill="none" stroke="currentColor" stroke-width="1.6" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" d="M9 5l7 7-7 7" /></svg>
            </button>
          </div>
        </div>
      </div>

      <div
        class="carousel-track flex w-full max-w-full flex-nowrap gap-4 overflow-x-auto px-4 pb-6 pt-3 snap-x snap-mandatory scroll-smooth scrollbar-hide sm:gap-8 sm:px-6"
        data-carousel-track
      >
        {monthlyHighlights.map(s => (
          <a
            href={`/serie/${s.slug}`}
            class="featured-carousel-card relative group overflow-hidden rounded-2xl bg-gradient-to-b from-white/5 to-slate-900/60 border border-white/10 shadow-xl snap-center sm:snap-start shrink-0 w-[min(78vw,18rem)] sm:w-[300px] lg:w-[320px] transition"
            data-carousel-card
          >
