---
import type { RowDataPacket } from 'mysql2';
import Layout from '../layouts/Layout.astro';
import db from '../lib/db';

export const prerender = false;

interface Serie extends RowDataPacket {
  id: number;
  slug: string;
  titulo: string;
  icon: string;
  descripcion: string;
  temporada_count: number;
  episodio_count: number;
}

const pageSize = 16;
const query = (Astro.url.searchParams.get('q') || '').trim().slice(0, 80);
const requestedPage = Math.max(1, Number.parseInt(Astro.url.searchParams.get('page') || '1', 10) || 1);
const whereClause = query ? 'WHERE s.titulo LIKE ? OR s.genero LIKE ?' : '';
const searchParams = query ? [`%${query}%`, `%${query}%`] : [];

let totalSeries = 0;
let filteredTotal = 0;
let series: Serie[] = [];

try {
  const [[totalRow]] = await db.query<(RowDataPacket & { total: number })[]>('SELECT COUNT(*) AS total FROM series');
  totalSeries = Number(totalRow?.total || 0);

  const [[filteredRow]] = await db.query<(RowDataPacket & { total: number })[]>(
    `SELECT COUNT(*) AS total FROM series s ${whereClause}`,
    searchParams,
  );
  filteredTotal = Number(filteredRow?.total || 0);

  const estimatedPages = Math.max(1, Math.ceil(filteredTotal / pageSize));
  const safePage = Math.min(requestedPage, estimatedPages);
  const offset = (safePage - 1) * pageSize;

  const [rows] = await db.query<Serie[]>(
    `SELECT
       s.id,
       s.slug,
       s.titulo,
       s.icon,
       s.descripcion,
       (SELECT COUNT(*) FROM temporadas t WHERE t.serie_id = s.id) AS temporada_count,
       (SELECT COUNT(*) FROM episodios e
          JOIN temporadas t ON e.temporada_id = t.id
         WHERE t.serie_id = s.id) AS episodio_count
     FROM series s
     ${whereClause}
     ORDER BY s.titulo
     LIMIT ${pageSize} OFFSET ${offset}`,
    searchParams,
  );

  series = Array.isArray(rows) ? rows : [];
} catch (error) {
  console.error('Error cargando el directorio:', error);
}

const totalPages = Math.max(1, Math.ceil(filteredTotal / pageSize));
const currentPage = Math.min(requestedPage, totalPages);

const pageHref = (page: number) => {
  const params = new URLSearchParams();
  if (query) params.set('q', query);
  if (page > 1) params.set('page', String(page));
  const suffix = params.toString();
  return suffix ? `/directorio?${suffix}` : '/directorio';
};
---

<Layout title="ClawnVid | Directorio" description="Directorio completo de series, temporadas y capítulos disponibles en ClawnVid.">
  <section class="mx-auto max-w-screen-2xl space-y-6 px-3 py-4 sm:px-6 sm:py-10">
    <div class="rounded-[1.6rem] border border-white/10 bg-gradient-to-br from-slate-950 via-purple-950/35 to-black p-4 shadow-xl shadow-purple-500/8 sm:p-6">
      <div class="flex flex-col gap-3 sm:flex-row sm:items-end sm:justify-between">
        <div class="max-w-3xl">
          <p class="text-[10px] font-semibold uppercase tracking-[0.28em] text-purple-200/65 sm:text-xs">Directorio</p>
          <h1 class="mt-2 text-2xl font-black leading-tight text-white sm:text-4xl">Todo el catálogo, sin sobrecargar tu pantalla.</h1>
          <p class="mt-2 text-sm text-white/58 sm:text-base">Portadas ligeras, información breve y acceso directo a cada serie.</p>
        </div>

        <div class="text-xs text-white/42 sm:text-right">
          <span>{totalSeries} series disponibles</span>
          {query && (
            <>
              <span class="mx-2 text-white/20">•</span>
              <a href="/directorio" class="font-semibold text-purple-200/75 hover:text-purple-100">Limpiar filtro</a>
            </>
          )}
        </div>
      </div>
    </div>

    <div class="grid grid-cols-2 gap-3 sm:gap-5 lg:grid-cols-3 xl:grid-cols-4">
      {series.map((serie, index) => (
        <a href={`/serie/${serie.slug}`} class="directory-card group relative block overflow-hidden rounded-2xl border border-white/8 bg-[#0d0c12]">
          <div class="relative aspect-[4/5] overflow-hidden">
            <img
              src={serie.icon || '/avatar.jpeg'}
              alt={serie.titulo}
              width="480"
              height="600"
              loading={index < 4 ? 'eager' : 'lazy'}
              fetchpriority={index < 4 ? 'high' : 'low'}
              decoding="async"
              class="h-full w-full object-cover"
              onerror="this.src='/avatar.jpeg'"
            />
            <div class="absolute inset-0 bg-gradient-to-t from-black via-black/40 to-transparent"></div>

            <div class="absolute inset-x-0 bottom-0 p-3 sm:p-4">
              <p class="text-[9px] font-semibold uppercase tracking-[0.2em] text-purple-200/72 sm:text-[10px]">Serie</p>
              <h2 class="directory-card-title mt-1 text-sm font-bold leading-tight text-white sm:text-lg">{serie.titulo}</h2>
              <p class="directory-card-description mt-1.5 text-[11px] leading-relaxed text-white/62 sm:text-sm">
                {serie.descripcion || 'Descripción no disponible.'}
              </p>
              <div class="mt-3 flex flex-wrap gap-1.5 text-[9px] font-semibold text-white/72 sm:text-[11px]">
                <span class="rounded-full border border-white/10 bg-black/50 px-2 py-1 sm:px-2.5">{serie.temporada_count} Temp</span>
                <span class="rounded-full border border-white/10 bg-black/50 px-2 py-1 sm:px-2.5">{serie.episodio_count} Caps</span>
              </div>
            </div>
          </div>
        </a>
      ))}
    </div>

    {series.length === 0 && (
      <div class="rounded-3xl border border-white/10 bg-white/[0.03] p-8 text-center">
        <h2 class="text-lg font-bold text-white">No encontramos series</h2>
        <p class="mt-2 text-sm text-white/50">Prueba con otro título o vuelve al directorio completo.</p>
      </div>
    )}

    {totalPages > 1 && (
      <nav class="flex items-center justify-between gap-3 rounded-2xl border border-white/8 bg-white/[0.025] p-3" aria-label="Paginación del directorio">
        <a
          href={pageHref(Math.max(1, currentPage - 1))}
          aria-disabled={currentPage === 1 ? 'true' : undefined}
          class={`rounded-xl px-3 py-2 text-sm font-semibold ${currentPage === 1 ? 'pointer-events-none text-white/22' : 'text-white/62 hover:bg-white/6 hover:text-white'}`}
        >
          ← Anterior
        </a>
        <span class="text-xs font-semibold text-white/40">Página {currentPage} de {totalPages}</span>
        <a
          href={pageHref(Math.min(totalPages, currentPage + 1))}
          aria-disabled={currentPage === totalPages ? 'true' : undefined}
          class={`rounded-xl px-3 py-2 text-sm font-semibold ${currentPage === totalPages ? 'pointer-events-none text-white/22' : 'text-white/62 hover:bg-white/6 hover:text-white'}`}
        >
          Siguiente →
        </a>
      </nav>
    )}
  </section>
</Layout>

<style>
  .directory-card {
    content-visibility: auto;
    contain: layout paint style;
    contain-intrinsic-size: 300px 375px;
    box-shadow: 0 10px 28px rgba(0, 0, 0, 0.28);
    transition: border-color 160ms ease, transform 160ms ease;
  }

  .directory-card-title,
  .directory-card-description {
    display: -webkit-box;
    overflow: hidden;
    -webkit-box-orient: vertical;
  }

  .directory-card-title {
    -webkit-line-clamp: 2;
  }

  .directory-card-description {
    max-height: 2.75rem;
    -webkit-line-clamp: 2;
  }

  @media (hover: hover) and (pointer: fine) {
    .directory-card:hover {
      transform: translateY(-2px);
      border-color: rgba(192, 132, 252, 0.32);
    }
  }

  @media (max-width: 639px) {
    .directory-card-description {
      max-height: 2.3rem;
    }
  }
</style>
